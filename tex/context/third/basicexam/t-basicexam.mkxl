%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%D \section{模式設置 / Mode Setting/ モードセット}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\definemode[teacher][keep]
\definemode[student][keep]
\definemode[check]  [keep]
\definemode[random]  [keep]
\startmode[teacher]
  \mode_showpointtrue   
  \mode_showanswertrue  
  \mode_showsolutiontrue
  \setupfillin[empty=none,n=8]
\stopmode
\startmode[student]
  \mode_showpointtrue  
  \mode_showanswerfalse 
  \mode_showsolutionfalse
  \setupfillin[n=8]
\stopmode

\startmode[check]
  \mode_showpointtrue
  \mode_showanswertrue
  \mode_showsolutiontrue
  \setupfillin[empty=none,n=8]
  \mode_showchecktrue
  \ctxlua{thirddata.basicexam.enable_check()}
\stopmode

\startmode[random]
  \setupchoice[random=yes]
\stopmode

\def\basicexam_enable_mode#1{\csname mode_show#1true\endcsname}
\def\basicexam_disable_mode#1{\csname mode_show#1false\endcsname}

\tolerant\def\enableexammode[#1]{%
  \processcommalist[#1]\basicexam_enable_mode
  \ifmode_showcheck\ctxlua{thirddata.basicexam.enable_check()}\fi
}

\tolerant\def\disableexammode[#1]{%
  \processcommalist[#1]\basicexam_disable_mode
}
\initcollectanswer
