%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%D \section{设置 close 环境}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%D close 環境近乎是單獨設計的。該環境主要使用兩個命令：
%D \tex{startclose} 和 \tex{stopclose} 用來創建該環境，
%D \tex{closechoice} 用來標記環境內的選項，該命令隨行文放置即可。
%D \tex{stopclose} 會自行放置選項。
%D 因為 \type{close} 環境的子項目 \tex{closechoice} 是通過 choice 環境設置的。
%D 因此，可以通過 \type{[*]} 來標記正確答案。

%D The environment also inherits the key values of the answer.
%D 此外設置了 reset 鍵來選擇是否每一篇重置選項的題號，
%D 其他的鍵值： barcolor barstyle 設置 下划線樣式
%D            before after style color 用於整體環境
%D            width frame stopper distance 用於選項前題號樣式

%D \startbuffer
%D \startclose
%D On Oct. 11, hundreds of runners competed in a cross-country race in Minnesota.
%D Melanie Bailey should have \closechoice{designed,followed,changed,finished} the
%D course earlier than she did. Her \closechoice{delay,chance,trouble,excuse} came
%D because she was carrying a \closechoice{judge,volunteer,classmate,competitor}
%D across the finish line.
%D
%D As reported by a local newspaper, Bailey was more than two-thirds of the way
%D through her \closechoice{race,school,town,training} when a runner in front of
%D her began crying in pain. She \closechoice{agreed,returned,stopped,promised}
%D to help her fellow runner, Danielle Lenoue. Bailey took her arm to see if she
%D could walk forward with \closechoice{courage,aid,patience,advice} . She couldn't.
%D Bailey then \closechoice{went away,stood up,stepped aside,bent down} to let Lenoue
%D climb onto her back and carried her all the way to the finish line, then another
%D 300 feet to where Lenoue could get \closechoice{medical,public,constant,equal} attention.
%D
%D Once there, Lenoue was \closechoice{interrupted,assessed,identified,appreciated}
%D and later taken to a hospital, where she learned that she had serious injuries in
%D one of her knees. She would have struggled with extreme \closechoice{hunger,pain,cold,tiredness}
%D to make it to that aid checkpoint without Bailey's help.
%D \stopclose
%D \stopbuffer
%D \typebuffer
%D \framed[width=\textwidth,align={flushleft,lohi}]{\getbuffer}

\installnamespace          {close}
\installcommandhandler \????close     {close}     \????close

\definechoice[closechoice]
\def\setupclosechoice{\setupchoice[closechoice]}

\setupclose[\c!continue=\v!no,
            %answerstyle=,
            %pointstyle=,
            n=8,
            listwidth=\widthofstring{00\,\closeparameter\c!stopper\,},
            listframe=off,
            listalign=flushleft,
            answerwidth=\widthofstring{0(0)(M)0},
            answerlabel=,
            stopper=.,
            distance=.5em,
            after=\blank[halfline]]

\tolerant\protected\def\startclose[#1]#*%
 {\begingroup
  \edef\currentexamenvironment{\s!close}%
  \iffirstargument\setupclose[#1]\fi
  \ctxlua{thirddata.basicexam.close_reset()}%
  \edef\p_continue{\closeparameter\c!continue}%
  \scratchcounterone\rawcountervalue[currentexamorder]%抓取之前的题号
  % \c_closetest_temp   内部的序号 
  \doiftrueelse\s!close\c!continue
    {\c_closetest_temp\rawcountervalue[currentexamorder]}%
    {\c_closetest_temp\zerocount}%
  \incrementcounter[currentexamorder]%无论是否continue 都需要增加题号
  \closeparameter\c!before
  \useclosestyleandcolor\c!style\c!color
  \begingroup}

\overloaded\tolerant\protected\def\closechoice[#S#1]#*[#S#2]#*#:#3{%
  \c_fillinnumber\c_closetest_temp
  \advance\c_closetest_temp by 1\relax
  \closebar{}%
  \ctxlua{thirddata.basicexam.close_add_choice([==[#1]==], [==[#2]==], [==[#3]==])}%
}

\def\close_order{%
  \unskip
  \inframed[width=\closeparameter\c!listwidth,
            frame=\closeparameter\c!listframe,
            align=\closeparameter\c!listalign,
  foregroundcolor=\closeparameter\c!listcolor,
  foregroundstyle=\closeparameter\c!liststyle]{%
    \global\advance\c_closetest_temp by 1\relax
    \convertnumber{n}{\number\c_closetest_temp}% 选择题目区域的标记序号
    \closeparameter\c!stopper}% 
  \hskip\closeparameter\c!distance\relax
  \unskip}

\def\placeclosechoice{%
  \doiftrue\s!close\c!showanswer\mode_showanswertrue
  \doiftrue\s!close\c!showpoint \mode_showpointtrue
  \ifmode_showanswer
    \scratchdimen=\closeparameter{answerwidth}\relax
  \else\ifmode_showpoint
    \scratchdimen=\closeparameter{answerwidth}\relax
  \else
    \scratchdimen\zeropoint
  \fi\fi
  \scratchcounter{\numexpr\scratchcounterone-\c_closetest_temp\relax}%最后 - 最开始 = 循环次数
  \doiftrueelse\s!close\c!continue{}
    {\c_closetest_temp\zerocount
     \UnlimitedPushLevel{\s!close}%
     \UnlimitedSaveCurrentID\SavedCurrentID
     \initcollectanswer%%% 这些代码直接来自\BasicExamPushLevel 只是我们不需要他的剩余部分
     \edef\currentexamenvironment{closechoice}%重定义
     }% 重新赋值，让 \c_closetest_temp 等于题号
  \dorecurse{\number\scratchcounter}{% (1)
    \hbox{\hsize\textwidth% (2)
      \edef\currentpoint{\closeparameter\c!point}%
      \BasicExamPushLevel\s!close\currentexamenvironment
      \hbox{\hsize\closeparameter\c!listwidth\noindent\strut\close_order}%
      \vtop{\hsize=\dimexpr\textwidth-\scratchdimen-\closeparameter\c!listwidth\relax
        \ctxlua{thirddata.basicexam.close_render_current()}%
      }% (3)
      \BasicExamPopLevel
    }\par% (2)
    \doiftrue\s!close\c!continue{\incrementcounter[currentexamorder]}%
  }% (1)
  \doiftrueelse\s!close\c!continue{\decrementcounter[currentexamorder]}{\UnlimitedPopLevel}%
}

\def\stopclose{%
  \global\scratchcounterone\c_closetest_temp% 记录一次最后递增到的数值
  \endgroup
  \closeparameter\c!after
  \placeclosechoice
  \endgroup}

% -------------------------------------------------------------------
% 全局配置的默认值
% 只在这里 \def 一次；\setupORDER 不再携带默认值，
% 因此不会被第二次 \setupORDER 或任何 \ORDER 重置。
% -------------------------------------------------------------------

\tolerant\def\setupORDER[#1]{%
  \getparameters[PXORDER][#1]}

\defineframed [pxordernumber] [frame=off,location=low]
\defineframed [pxordertext]   [frame=off,location=low]

\tolerant\def\ORDER[#1]#2{%
  \begingroup
  \initcollectanswer
  \getparameters[curorder][
    seed=123,
    symbol=yes,
    distance=0.3em,
    numberleft=(,
    numberright=),
    numbering=numbers,
    shownumber=true,
    separator={, },
    answermode=correct,
    #1]%
  \def\RENDERORDER##1##2{%
    \dontleavehmode
    \doifelse{\curordersymbol}{yes}
      {\pxordernumber{%
         \curordernumberleft
         \convertnumber{\curordernumbering}{##1}%
         \curordernumberright
       }}%
      {\hbox to 1.5em{}}%
    \hskip\curorderdistance
    \pxordertext{##2}%
    \hskip\curorderdistance plus 0.5em
    \allowbreak
  }%
  \ctxlua{thirddata.basicexam.order.render(
    "\curorderseed",
    "\luaescapestring{#2}",
    "\curordernumbering",
    "\curorderanswermode")}%
  \endgroup
}

