%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%D \section{partio / 成绩表}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% 开启一个新的 partio（自动重置为允许记录）仅仅是一个状态记录器，且不受 tex 组影响
% \partio[uid]      手动设定本次 partio 的 uid，
%                   之后可以用 \typegrade[partios=uid] 抓取
% \partio            不给参数，自动使用 partio_N
\tolerant\def\partio[#1]{%
  \bgroup
  \edef\p_partio_uid{#1}%
  \ctxlua{thirddata.basicexam.partio_begin([==[\p_partio_uid]==])}%
  \egroup}

% 临时开启/关闭收集
\def\startpartio{\ctxlua{thirddata.basicexam.partio_set_enabled("true")}}
\def\stoppartio{\ctxlua{thirddata.basicexam.partio_set_enabled("false")}}

\let\enablepartio\startpartio
\let\disablepartio\stoppartio

\installnamespace {grade}
\installcommandhandler \????grade {grade} \????grade

\appendtoks
  \protected\frozen\instance\edefcsname \currentgrade\endcsname{\directnamedgrade[\currentgrade]}%
\to \everydefinegrade

\setupgrade
  [% 
   partios=,% 指定要渲染的 Partio 序号。
             % 留空：自动读取当前最新（正在收集）的 partio。
             % 数字：如 1，只渲染第 1 个 partio。
             % 列表：如 1,2,3，渲染指定的多个 partio。
             % all ：渲染文档中所有的 partio。
   source=last,% 数据来源。last (默认，读取上一遍编译的缓存)，current (读取当前编译的数据，慎用，可能不全)。
   resetcum=,% 遇到新的 partio 时，是否将“累计”分数清零。true=分块独立累计，false=跨 partio 全局累加。
   layout=cols,% 排版模式。rows = 一题一行(垂直)；cols = 一题一列(水平)；list = 纯文本列表；custom = 自定义
   indent=quad,% 缩进控制命令（不带反斜杠）。当列表模式下子题缩进时，使用 \quad 还是 \hskip 2em 等。
   answerwidth=12em,% 在 rows 模式下，“答案”列允许的最大宽度。超出会自动换行。
   % customhandler=,传入自定义的排版模式
   showsub=false,% 是否展开并显示子题（小题）。
   showheader=true,% 是否显示表头（题号、分数、累计、答案）。
   showcum=false,% 是否显示“累计”分数行/列。
   showanswer=false,% 是否显示“答案”行/列。
   showscore=true, % 是否显示得分列/行
   showtotal=false,% 是否显示总分栏
   showreviewer=false,% 是否显示阅卷人签名
   showchecker=false,% 是否显示复核人签名
   showrecorder=false,% 是否显示登分人签名
   numberlabel=\examtexts{gradenumberlabel},% 题号那一列/行的表头文字。
   pointlabel=\examtexts{gradepointlabel},% 分数那一列/行的表头文字。
   cumlabel=\examtexts{gradecumlabel},% 累计那一列/行的表头文字。
   answerlabel=\examtexts{gradeanswerlabel},% 答案那一列/行的表头文字。
   scorelabel=\examtexts{gradescorelabel}, % 得分那一列/行的表头文字。
   totallabel=总分,
   reviewerlabel=阅卷人,
   checkerlabel=复核人,
   recorderlabel=登分人,
   alllabel=all,% 当展开子题时，汇总那一行/列的表头文字（如：all，或者“合计”、“总计”）。
   tablesetup=,% 直接填入 \setupTABLE 代码来控制表格样式。
   before=,% 表格排版前插入的代码，如 \blank[halfline]
   after=]% 表格排版后插入的代码，如 \blank[line]

\permanent\tolerant\protected\def\directnamedgrade[#1]#*[#2]#:{%
  \begingroup\nofarguments\lastarguments
  \edef\currentgrade{#1}%
  \ifparameter#2\or\setupcurrentgrade[#2]\fi
  \gradeparameter{before}%
  \ctxlua{thirddata.basicexam.typegrade_render()}% 干干净净，什么都不用传
  \gradeparameter{after}%
  \endgroup\par}

\definegrade[typegrade]

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%D \section{score}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%D 放置在 answer 環境內標記得分。

%D \starttyping
%D   score\score{3}\\
%D   score\score[type=dotfills]{30}\\
%D   \resetscore\\
%D   score\score[type=cdotfills]{30}\\
%D   \setupscore[score=calculation]
%D   score\score[type=space]{3}\\
%D   score\score[type=hfill]{3}\\
%D \stoptyping

\definefiller[cdotfill][dotfill]
\setupfiller [cdotfill][symbol=\cdot]
\definefiller[whitespace][symbol]
\setupfiller [whitespace][symbol=\hbox{ }]

\installnamespace                 {score}
\installcommandhandler \????score {score} \????score

\setupscore[
  % \c!left=,\c!right=,
  % \c!before=,\c!after=,
  \c!style=\ssa,
  \c!color=red,
  \c!inbetween=\filler[dotfill],%cdotfill sym symbol rule width space
]

\def\score_calc#1{% only show number
  \global\c_stepscore_temp=#1\relax%
  \ifnum\numexpr\c_stepscore=0\relax\global\c_stepscore=#1\relax\else%
  \global\c_stepscore=\numexpr\c_stepscore+\c_stepscore_temp\relax%
  \fi\number\c_stepscore%
}

\tolerant\protected\def\score[#1]#:#2{\begingroup% format style
  \iffirstargument\setupscore[#1]\fi%
  \scoreparameter\c!before%
  \usescorestyleandcolor\c!style\c!color%
  \scoreparameter\c!inbetween
  \scoreparameter\c!left%
  \doif{\scoreparameter{score}}{}           {#2}%
  \doif{\scoreparameter{score}}{default}    {#2}%
  \doif{\scoreparameter{score}}{calculation}{\score_calc{#2}}%
  \doif{\scoreparameter{score}}{complex}    {#2 : \score_calc{#2}}%
  \scoreparameter\c!right
  \scoreparameter\c!after%
  \endgroup}

\def\resetscore{\c_stepscore_temp=0\relax\c_stepscore=0\relax}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%D \section{作文格 / Writing Box}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%D \startbuffer
%D \writingbox
%D  [column=12,
%D   row=15,
%D   evencolor=blue,
%D   oddcolor=darkgray,
%D   evenheight=1cm,
%D   oddheight=.5cm,
%D   align=flushleft,
%D   height=\textheight,
%D   width=\textwidth,]{}
%D \writinggrid
%D  [cellwidth=1cm,
%D   column=12,
%D   row=15,
%D   cellcolor=darkgray,
%D   align=flushleft,
%D   height=\textheight,
%D   width=\textwidth,]{}
%D \stopbuffer
%D \typebuffer
%D \getbuffer

\startuseMPgraphic{grid:writingbox}{column,row,evenheight,oddheight,}
  pageWidth   := OverlayWidth;
  evenRows    := \MPvar{row};
  evenHeight  := \MPvar{evenheight};
  oddHeight   := \MPvar{oddheight};
  evenColumns := \MPvar{column};
  oddColumns  := evenColumns + 1;

  %% 绘制偶数行
  for i = 1 upto evenColumns: % 可以根据需要调整行数
    y1 := i * (oddHeight + evenHeight) + oddHeight;
    y2 := y1 + evenHeight;
    for j = 0 upto evenRows - 1:
        x1 := j  * (pageWidth / evenRows);
        x2 := x1 + (pageWidth / evenRows);
        draw (x1, y1) -- (x2, y1) -- (x2, y2) -- (x1, y2) -- cycle
            withcolor \MPvar{evencolor};
    endfor;
  endfor;

  %% 绘制奇数行
  for i = 1 upto oddColumns: % 可以根据需要调整行数
    y1 := i * (oddHeight + evenHeight);
    y2 := y1 + oddHeight;
    draw (0, y1) -- (pageWidth, y1) -- (pageWidth, y2) -- (0, y2) -- cycle
        withcolor \MPvar{oddcolor};
  endfor;
\stopuseMPgraphic

\defineoverlay
[writingbox]
[{\uniqueMPgraphic{grid:writingbox}{
  evencolor=\framedparameter{evencolor},
   oddcolor=\framedparameter{oddcolor},
     column=\framedparameter{column},
        row=\framedparameter{row},
 evenheight=\framedparameter{evenheight},
  oddheight=\framedparameter{oddheight},
 }}]

\defineframed[writingbox]
 [offset=overlay,
  background=writingbox,
  frameoffset=.5pt,
  column=12,
  row=15,
  evencolor=blue,
  oddcolor=darkgray,
  evenheight=1cm,
  oddheight=.5cm,
  align=flushleft,
  height=\textheight,
  width=\textwidth,
  rulethickness=1pt]

% \writingbox[column=12,row=15,]{EEE\par EEEE\par EEEE}

\startuseMPgraphic{grid:writinggrid}{row,column,cellwidth,cellcolor}
  pageWidth   := OverlayWidth;
  m := \MPvar{row};       % 行数
  u := \MPvar{cellwidth}; % 单位长度
  n := \MPvar{column};    % 列数
  % 画竖线
  for i = 0 upto n:
      draw (i*u, 0) -- (i*u, m*u) withcolor \MPvar{cellcolor};
  endfor;

  % 画横线
  for j = 0 upto m:
      draw (0, j*u) -- (n*u, j*u) withcolor \MPvar{cellcolor};
  endfor;
\stopuseMPgraphic

\defineoverlay
[writinggrid]
[{\uniqueMPgraphic{grid:writinggrid}{
    column=\framedparameter{column},
       row=\framedparameter{row},
 cellwidth=\framedparameter{cellwidth},
 cellcolor=\framedparameter{cellcolor},
 }}]

\defineframed[writinggrid]
  [offset=overlay,
    background=writinggrid,
    frameoffset=.5pt,
    cellwidth=1cm,
    column=12,
    row=15,
    cellcolor=darkgray,
    align=flushleft,
    height=\textheight,
    width=\textwidth,
    rulethickness=1pt]

%  \writinggrid[column=12,row=15,]{EEE\par EEEE\par EEEE}

