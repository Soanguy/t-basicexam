\installnamespace {examinfor}
\installnamespace {examinforalternative}
\installnamespace {examinforrenderings}

\installframedcommandhandler \????examinfor  {examinfor}  \????examinfor
\installcommandhandler       \????examinforalternative {examinforalternative} \????examinforalternative

\tolerant\protected\def\startexaminfor[#1]#*%
 {\bgroup\edef\currentexaminfor{#1}%
  \edef\currentexaminforalternative{\examinforparameter\c!alternative}%
  \ifcsname\currentexaminforalternativehash\s!parent\endcsname \else
    \let\currentexaminforalternative\s!default
  \fi
  \examinforparameter\c!before
  \usesetupsparameter\examinforparameter
  \edef\p_renderingsetup{\examinforalternativeparameter\c!renderingsetup}%
  \useexaminforstyleandcolor\c!style\c!color
  \directsetup\p_renderingsetup
  \bgroup\examinforparameter\c!left}

\protected\def\stopexaminfor%
 {\examinforparameter\c!right\egroup
  \examinforparameter\c!after\egroup}

\defineexaminforalternative
  [\s!default]
  [\c!renderingsetup=\????examinforrenderings:\s!default]

\defineexaminforalternative
  [\c!frame]
  [\c!renderingsetup=\????examinforrenderings:\c!frame]

\startsetups[\????examinforrenderings:\s!default]
  \dontleavehmode
\stopsetups

\startsetups[\????examinforrenderings:\c!frame]
  \dontleavehmode\inheritedexaminforframed
\stopsetups

\setupexaminfor[frame=off,location=low,left=\__CapLparen,right=\__CapRparen,offset=0pt,align=flushleft]

\defineexaminfor[dummy]
\defineexaminfor[infor]
\defineexaminfor[close]    [width=2em]
\defineexaminfor[solution]
\defineexaminfor[question]
\defineexaminfor[examitem]

\def\initshowexaminfor[#1]{%集中运行一次
  \cdef\p_environment{#1}%
  \overloaded\expandafter\let\expandafter\p_currentparameter\csname #1parameter\endcsname
  \edef\p_totalpoint{\p_currentparameter\c!totalpoint}%
  \ifempty{\p_currentparameter\c!point}%
    \ifdefined\currentpoint
      \edef\currentpoint{\currentpoint}%
    \else
      \def\currentpoint{0}%
    \fi
  \else
    \edef\currentpoint{\p_currentparameter\c!point}%
  \fi
  \edef\p_totalanswer{\p_currentparameter\c!totalanswer}%
  \edef\currentanswer{\p_currentparameter\c!answer}%
  \ifempty{\p_currentparameter\c!showpoint}\else
    \doiftrueelse\p_environment\c!showpoint\mode_showpointtrue\mode_showpointfalse
  \fi
  \ifempty{\p_currentparameter\c!showanswer}\else
    \doiftrueelse\p_environment\c!showanswer\mode_showanswertrue\mode_showanswerfalse
  \fi
  \ifempty{\p_currentparameter\c!showscript}\else
    \doiftrueelse\p_environment\c!showscript\mode_showscripttrue\mode_showscriptfalse
  \fi
  \ifmode_showanswer\mode_showscriptfalse\fi
  \ifmode_showscript\mode_showanswerfalse\fi
  \ifempty{\p_currentparameter\c!showinfor}\else
    \doiftrueelse\p_environment\c!showinfor\mode_showinfortrue\mode_showinforfalse
  \fi
}

\tolerant\protected\def\showexaminfor[#1]#*[#2]%
 {\edef\currentshowmode{#2}% check point or answer
  \begingroup
    \fetchlabel{#2label}%
    \csname ifmode_show#2\endcsname
      \dousestyleparameter{\p_currentparameter{#2style}}%
      \dousecolorparameter{\p_currentparameter{#2color}}%
      \startexaminfor[#1]%
        \left_assignedlabel
        \ifx\currentshowmode\c!point% if #2 = point
          \ifempty\p_totalpoint
            \UnlimitedSavedCurrentPoint
          \else
            \p_totalpoint
          \fi
        \fi
        \ifx\currentshowmode\c!answer
          \ifempty\p_totalanswer
            \UnlimitedSavedCurrentAnswer
          \else
            \p_totalanswer
          \fi
        \fi
        \ifx\p_environment\s!solution\else
          \p_currentparameter\c!infor
        \fi
        \right_assignedlabel
      \stopexaminfor
    \fi
  \endgroup
  \removeunwantedspaces\allowbreak
}

\def\fetchlabel#1% #1 = pointlabel / answerlabel
{\edef\p_temp_label{\p_currentparameter{#1}}%
  \ifx\p_temp_label\empty
    \let\left_assignedlabel \empty
    \let\right_assignedlabel\empty
  \else
    \expandafter\fetchlabel_check\p_temp_label\relax{#1}%
  \fi
}

\def\fetchlabel_check#1#2\relax#3%
{\ifx#1\examtexts
    \def\left_assignedlabel{\leftexamtext{#2}}%
    \def\right_assignedlabel{\rightexamtext{#2}}%
  \else
    \ifx#1\labeltext
      \def\left_assignedlabel {\leftlabeltext{#2}}%
      \def\right_assignedlabel{\rightlabeltext{#2}}%
    \else
      \splitatcomma\p_temp_label\left_assignedlabel\right_assignedlabel
    \fi
  \fi
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%D \section{繪製卷頭 / print title / タイトルの作成}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\installnamespace {papertitle}
\installnamespace {papertitlealternative}
\installnamespace {papertitlerenderings}

\installcommandhandler \????papertitle            {papertitle}            \????papertitle
\installcommandhandler \????papertitlealternative {papertitlealternative} \????papertitlealternative

\appendtoks
  \definemarking[\currentpapertitle][expansion=yes]%
\to \everydefinepapertitle

\definemarking[\s!papertitle][expansion=yes]

\def\definepapertitlevariable#1{\begingroup% #1=element name
    \parindent0pt\relax
    \edef\p_align{\papertitleparameter{#1align}}%
    \edef\p_variable{\papertitleparameter{#1}}%
    \dousealignparameter\p_align
    \papertitleparameter{before#1}%
    \usepapertitlestyleandcolor{#1style}{#1color}%
    \ifempty\p_variable\showmessage\m!basicexam{3}{#1}\else\p_variable\fi
    \papertitleparameter{after#1}%
    \iftok{\papertitleparameter{independent}}{false}\else\par\fi
    \endgroup}

\protected\tolerant\def\makepapertitle[#1]#*[#2]%
 {\begingroup
  \cdef\currentpapertitle{#1}%
  \ifhastok={#1}%
    \setuppapertitle[\currentpapertitle][#1]%
  \else
    \setuppapertitle[#1][#2]%
  \fi
  \edef\currentlist{\papertitleparameter\c!list}%
  \edef\currenttitle{\papertitleparameter\c!title}%
  \edef\currentpapertitlealternative{\papertitleparameter\c!alternative}%
  \ifcsname\currentpapertitlealternativehash\s!parent\endcsname \else
    \let\currentpapertitlealternative\s!default
  \fi
  \usesetupsparameter\papertitleparameter
  \edef\p_renderingsetup{\papertitlealternativeparameter\c!renderingsetup}%
  \usealignparameter\papertitleparameter
  \usepapertitlestyleandcolor\c!style\c!color
  \directsetup\p_renderingsetup
  \edef\currentpapertitlemarking{\ifempty\currentpapertitle\s!papertitle\else\currentpapertitle\fi}%
  \marking[\currentpapertitlemarking]{\papertitleparameter\c!marking}%
  \endgroup}

\definepapertitlealternative
  [\s!default]
  [\c!renderingsetup=\????papertitlerenderings:\s!default]

\startsetups[\????papertitlerenderings:\s!default]
  \doiftrue\s!papertitle{enabletitle}{\expanded{\noexpand\tu{\currenttitle}}}%
  \processcommacommand[\currentlist]\definepapertitlevariable
\stopsetups

\setuppapertitle
  [\c!alternative=\s!default,
  \c!align=center,
  \c!list={secret,title,subject,information,signinformation,notice},
  \c!marking={\papertitleparameter\c!title\hbox{\quad}\papertitleparameter{subject}},
  enabletitle=yes,
  % \c!style=,
  % \c!color=,
  subjectsuffix=学科试卷,]

\setuppapertitle [
    secretstyle=\ss,
    titlestyle=\ssa,
    subjectstyle=\ssb,
    informationstyle=\tx,
    secretalign=flushleft,
    titlealign=center,
    subjectalign=center,
    informationalign=center,
    noticealign=flushleft,
    secret={绝密 ★ 启用前},
    title={\currentdate[year] 年普通高等学校招生全国统一考试},
    subject={英语},
    signinformation={{姓名:     }{\blackrule[width=4em,height=.2pt]}
                     {准考证号: }{\blackrule[width=4em,height=.2pt]}},
    information={全卷共12页，满分150分，考试时间120分钟。},
    notice={考生注意：
            \startitemize[n,packed,joinedup]
            \item 答题前，请务必将自己的姓名、准考证号用黑色字迹的签字笔
                  或钢笔分别填写在试题卷和答题纸规定的位置上。 %
            \item 答题时，请按照答题纸上“注意事项”的要求，在答题纸相应的
                  位置上规范作答，在本试题卷上的作答一律无效。 %
            \stopitemize},
]

\definepapertitle[newpaper]
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%D \section{设置 question 环境}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\defcsname\??itemgroupfirst notcontinue\endcsname
  {\c_strc_itemgroups_continue\conditionalfalse}

\installnamespace{question}
\installcommandhandler \????question {question} \????question
% 注意，这里我们窃取了 itemgroup 的定义，并替换成了我们的命令名称。
% 为了避免污染原始命令，我们在内部重定义了一部分命令。
% 这里原本也是使用了 installcorenamespace 但是这是系统保留的定义方式，
% 我们还原到开发者的命令定义方式。如果有不兼容，可以试着回退到原始的定义方式。
% 我们测试 1000 次运行 question 和原始的 itemize，结果大概是额外消耗了 1 倍上下的
% 原始的 itemize 运行时间。主要的消耗发生在 侵入替换 itemgroup 参数以及
% \BasicExamPushLevel 命令的 答案等内容的控制显示和 tex与lua 之间相互通讯的消耗
% 1000次不显示任何额外信息：0.430 / 0.278
% 1000次显示所有额外信息：  0.571 / 这里我们不进行对比。

% capture the native itemgroup entry points before any group redirects them
\let\strc_questions_orig_itemgroupparameter       \itemgroupparameter
\let\strc_questions_orig_setupcurrentitemgroup    \setupcurrentitemgroup
\let\strc_questions_orig_setitemgroupparameter    \setitemgroupparameter
\let\strc_questions_orig_letitemgroupparameter    \letitemgroupparameter
\let\strc_questions_orig_chaintocurrentitemgroup  \chaintocurrentitemgroup
\let\strc_questions_orig_directitemgroupparameter \directitemgroupparameter
\let\strc_questions_orig_resetitemgroupparameter  \resetitemgroupparameter

% per-call dispatch: inside one of our instances (marked at define
% time via \currentquestion) route to the question namespace, else
% fall back to the native itemgroup namespace, so native itemgroups
% nested inside a question keep working; expandable on purpose
% (used in \edef/\expanded by the engine)
\def\strc_questions_ifours#1#2{\ifcsname strcquestionsmark:\currentparentitemgroup\endcsname#1\else#2\fi}
\def\strc_questions_itemgroupparameter#1%
  {\strc_questions_ifours{\questionparameter{#1}}{\strc_questions_orig_itemgroupparameter{#1}}}
\def\strc_questions_setupcurrentitemgroup[#1]%
  {\strc_questions_ifours{\setupcurrentquestion[#1]}{\strc_questions_orig_setupcurrentitemgroup[#1]}}
\def\strc_questions_setitemgroupparameter#1#2%
  {\strc_questions_ifours{\setquestionparameter{#1}{#2}}{\strc_questions_orig_setitemgroupparameter{#1}{#2}}}
\def\strc_questions_letitemgroupparameter#1#2%
  {\strc_questions_ifours{\letquestionparameter#1#2}{\strc_questions_orig_letitemgroupparameter#1#2}}
\def\strc_questions_chaintocurrentitemgroup#1%
  {\strc_questions_ifours{\chaintocurrentquestion{#1}}{\strc_questions_orig_chaintocurrentitemgroup{#1}}}
\def\strc_questions_directitemgroupparameter#1%
  {\strc_questions_ifours{\directquestionparameter{#1}}{\strc_questions_orig_directitemgroupparameter{#1}}}
\def\strc_questions_resetitemgroupparameter#1%
  {\strc_questions_ifours{\resetquestionparameter{#1}}{\strc_questions_orig_resetitemgroupparameter{#1}}}

\appendtoks
    \protected\frozen\instance\edefcsname\e!start\strc_questions_bare\endcsname{\startnamedquestion[\currentquestion]}%
    \protected\frozen\instance\edefcsname\e!stop \strc_questions_bare\endcsname{\stopnamedquestion}%
    \protected\frozen\instance\edefcsname        \strc_questions_bare\endcsname{\directnamedquestion[\currentquestion]}%
    \let\currentparentitemgroup\currentquestion
    \expandafter\let\csname strcquestionsmark:\currentquestion\endcsname\relax
    \definecounter[\v_strc_itemgroups_counter]%
\to \everydefinequestion

\let\strc_questions_normal_define\definequestion

\def\strc_questions_bare{\s!question}

% user-facing name stays bare, the registered instance becomes env!<name>
\permanent\overloaded\tolerant\protected\def\definequestion[#S#1]#*[#S#2]#*[#S#3]%
  {\def\strc_questions_bare{#1}%
   \ifhastok={#2}%
     \strc_questions_normal_define[env!#1][#2]%
   \else\ifempty{#2}%
     \strc_questions_normal_define[env!#1]%
   \else
     \strc_questions_normal_define[env!#1][env!#2]%
   \fi\fi}

\let\strc_questions_normal_setup\setupquestion

\def\strc_questions_setup_each#category#whatever%
  {\ifhastok={#whatever}%
     \strc_questions_normal_setup[env!#category][#whatever]%
   \else
     \strc_questions_normal_setup[env!#category][\c!option={#whatever}]%
   \fi}

\def\strc_questions_setup_list_level_a#category#whatever#level%
  {\strc_questions_normal_setup[env!#category:#level][#whatever]}

\def\strc_questions_setup_list_level_b#category#whatever#level%
  {\strc_questions_normal_setup[env!#category:#level][\c!option={#whatever}]}

\def\strc_questions_setup_list#subcategories#category#whatever%
  {\ifhastok={#whatever}%
     \processcommalist[#subcategories]{\strc_questions_setup_list_level_a{#category}{#whatever}}%
   \else
     \processcommalist[#subcategories]{\strc_questions_setup_list_level_b{#category}{#whatever}}%
   \fi}

\permanent\overloaded\tolerant\protected\def\setupquestion[#S#category]#spacer[#S#levels]#spacer[#S#options]#spacer[#S#settings]%
  {\ifarguments
   \or
     \edef\strc_itemgroups_setup_what{#levels}%
     \strc_questions_normal_setup[#category]%
   \or
     \edef\strc_itemgroups_setup_what{#levels}%
     \strc_questions_setup_each{#category}{#levels}%
   \or
     \edef\strc_itemgroups_setup_what{#levels}%
     \ifx\strc_itemgroups_setup_what\v!each
       \strc_questions_setup_each{#category}{#options}%
     \else
       \strc_questions_setup_list{#levels}{#category}{#options}%
     \fi
   \or
     \edef\strc_itemgroups_setup_what{#levels}%
     \ifx\strc_itemgroups_setup_what\v!each
       \strc_questions_setup_each{#category}{#options}%
       \strc_questions_setup_each{#category}{#settings}%
     \else
       \strc_questions_setup_list{#levels}{#category}{#options}%
       \strc_questions_setup_list{#levels}{#category}{#settings}%
     \fi
   \fi
}

\def\Q_strc_itemgroups_tag_start_group
  {\dostarttaggedchained\currentexamenvironment\currentparentitemgroup\currentitemgroup\??question
   \dotagsetitemgroup}

\permanent\tolerant\protected\def\startnamedquestion[#S#category]#spacer[#S#options]#spacer[#S#settings]%
 {\begingroup
  \cdef\currentquestion{#category}%
  \enforced\let\itemgroupparameter       \strc_questions_itemgroupparameter
  \enforced\let\setupcurrentitemgroup    \strc_questions_setupcurrentitemgroup
  \enforced\let\setitemgroupparameter    \strc_questions_setitemgroupparameter
  \enforced\let\letitemgroupparameter    \strc_questions_letitemgroupparameter
  \enforced\let\chaintocurrentitemgroup  \strc_questions_chaintocurrentitemgroup
  \enforced\let\directitemgroupparameter \strc_questions_directitemgroupparameter
  \enforced\let\resetitemgroupparameter  \strc_questions_resetitemgroupparameter
  \def\currentquestion{\currentitemgroup}%
  \ifnum\currentitemlevel=\zerocount\iftrialtypesetting\else\incrementcounter[currentexamorder]\fi\fi
  \let\strc_itemgroups_tag_start_group_origin\strc_itemgroups_tag_start_group
  \let\strc_itemgroups_tag_start_group\Q_strc_itemgroups_tag_start_group
  \ifhastok={#options}%
    \startitemgroup[#category][#options,#settings]%
  \else
    \startitemgroup[#category][#options][#settings]%
  \fi
  \edef\p_class{\questionparameter\c!class}%
  \edef\p_itemclass{\questionparameter{itemclass}}%
  \edef\currentitemreference{\questionparameter\c!reference}%
  \edef\currentexamenvironment%
    {\ifx\p_class\s!problem  \s!problem \fi
     \ifx\p_class\s!truefalse\s!problem \fi
     \ifx\p_class\s!writing  \s!writing \fi
     \ifx\p_class\s!question \s!question\fi
     \ifempty\p_class        \s!question\fi}%
  \ifx\currentexamenvironment\s!problem
  % 因为 dotagged 的时机在 item， 因此恢复需要在 pitem 中进行
    \doifinset{TF}{#options}{\let\p_class\s!truefalse}%设置为 TF 环境
    \doiftrueelse\s!question\c!showanswer\mode_showanswertrue\mode_showanswerfalse
    \doiftrueelse\s!question\c!showpoint\mode_showpointtrue\mode_showpointfalse
    \doiftrueelse\s!question\c!showscript\mode_showscripttrue\mode_showscriptfalse
    \doiftrueelse\s!question\c!showinfor\mode_showinfortrue\mode_showinforfalse
    \usealignparameter\questionparameter%实际只能 optclose 使用
  \else
    \startspecialitemgroupitem[\p_itemclass]{\questionparameter{item}}%
    \iftrialtypesetting \orelse \ifempty\currentitemreference \else
      \expanded{\textreference[\currentitemreference]{\questionparameter{item}}}%
    \fi
    \BasicExamPushLevel\s!question\currentexamenvironment
    \let\strc_itemgroups_tag_start_group\strc_itemgroups_tag_start_group_origin
  \fi
  \usequestionstyleandcolor\c!textstyle\c!textcolor
  }

\protected\def\stopnamedquestion{%
  \ifx\currentexamenvironment\s!problem\else
    \BasicExamPopLevel
    \stopspecialitemgroupitem
  \fi
  \stopitemgroup
  \endgroup}

\tolerant\protected\def\directnamedquestion[#S#category]#spacer[#S#options]#spacer[#S#settings]%
 {\groupedcommand{\startnamedquestion[#category][#options][#settings]}{\stopnamedquestion}}

\def\startquickinstallexam[#S#category]#spacer[#S#settings]{%
  \begingroup
  \edef\currentexamenvironment{#category}%
  \getdummyparameters[#settings]%
  \BasicExamPushLevel\c!dummy\currentexamenvironment
  \usedummystyleandcolor\c!style\c!color}

\def\stopquickinstallexam{\BasicExamPopLevel\endgroup}

\setupquestion
  [\c!margin=\zeropoint,
   \c!leftmargin=\zeropoint,
   \c!rightmargin=\zeropoint,
   \c!leftmargindistance=\zeropoint,
   \c!rightmargindistance=\zeropoint,
   \c!indentnext=\v!yes,
   \c!width=1.5\emwidth,
   \c!factor=0,
   \c!step=.5\emwidth,
   \c!distance=\zeropoint,
   \c!marstyle=\v!type,
   \c!n=2,
   \c!items=4,
   \c!levels=10,
   \c!lefttext=\__CapLparen,
   \c!righttext=\__CapRparen,
   \c!start=1,
   \c!packcriterium=\zerocount,
   \c!criterium=\v!all,
   \c!textdistance=\v!space,
   \c!lasttextseparator=\itemgroupparameter\c!textseparator,
   \c!indenting=\v!next,
   \c!symbol=\currentitemlevel,
   \c!prefix=\v!no,
   \c!prefixconnector=.,
   \c!numberseparatorset=,
   \c!numberconversionset=,
   \c!numberstopper=.,
   \c!numbersegments=1,
   \c!command=\strc_itemgroups_default_command,
   \c!before=\blank,
   \c!inbetween=\blank,
   \c!after=\blank,
   \c!afterhead=\blank,
   \c!placestopper=\v!yes,
   \c!stopper=.,
   \c!symcolor=\itemgroupparameter\c!color,
   \c!symstyle=\itemgroupparameter\c!style,]

\definequestion[question]
\definequestion[subquestion][question]

\setupquestion
  [\c!class=question,
  \c!before=,
   \c!after=,
  %\c!reset=,
  %\c!showpoint=,
  %\c!showanswer=,
  %\c!point=,
  %\c!answer=,
  %\c!pointstyle=,
  %\c!answerstyle=,
  %\c!pointcolor=,
  %\c!answercolor=,
  \c!pointlabel=\examtexts{point},
  \c!answerlabel=\examtexts{answer},
  \c!inforlabel=,
  \c!indenting=no,]

\setupquestion[question]
  [\c!way=bychapter,
  \c!numberconversion=tabularnumbers,
  \c!option={n,packed,joinedup,continue},]

\setupquestion[question][1]% 重要变更，我们直接修改了计数。使之默认情况下就自动递增
  [\c!start=\rawcountervalue[currentexamorder],
   \c!option={n,packed,joinedup},]

\setupquestion[question][2,3]
  [\c!left=\__CapLparen,\c!lefttext=\__CapLparen,
   \c!right=\__CapRparen,\c!righttext=\__CapRparen,
   \c!stopper=,
   \c!distance=.5em,
   \c!option={n,packed,joinedup,continue},
  ]

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%D \section{设置 problem 环境 / Problem Environment}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\definequestion [problem]  [question]
\definequestion [optclose] [problem]
\definequestion [truefalse][problem]

\def\setupproblem{\setupquestion[problem]}
\def\setupoptclose{\setupquestion[optclose]}
\def\setuptruefalse{\setupquestion[truefalse]}

\setupproblem
  [\c!class=\s!problem,
    \c!left=\__CapLparen, 
 \c!lefttext=\__CapLparen,
    \c!right=\__CapRparen,
\c!righttext=\__CapRparen,
   \c!before=,
    \c!after=,
  \c!stopper=,
 \c!distance=.5em,
   \c!option={n,packed,joinedup},
   \c!symbol=\symbol[marksquare],
  truesymbol=\symbol[marksquarecheck],
 falsesymbol=\symbol[marksquarecross],]

\setupoptclose[
    \c!class=\s!problem,
 \c!continue=no,
   \c!option={text,n,continue,nostopper},]

\setuptruefalse[\c!class=truefalse,\c!distance=\zeropoint]

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%D \section{设置 writing 环境}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\definequestion[writing]
\definequestion[subwriting][writing]
\def\setupwriting{\setupquestion[writing]}
\def\setupsubwriting{\setupquestion[subwriting]}
\let\definewriting\definequestion

\setupquestion[writing][each]
  [    class=\s!writing,
   \c!answer=\examtexts{writing},
   \c!option={n,packed,joinedup,continue},
   \c!totalanswer=\examtexts{writing},% totalanswer 会覆盖 answer
  ]

\setupquestion[writing][1][start=\rawcountervalue[currentexamorder]]

\setupquestion[writing][2,3]
  [\c!left=\__CapLparen,\c!lefttext=\__CapLparen,
   \c!right=\__CapRparen,\c!righttext=\__CapRparen,
   \c!stopper=,
   \c!distance=.5em,
   \c!option={n,packed,joinedup,continue},
  ]

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%D \section{设置 choice 环境}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\installnamespace{choice}
\installcommandhandler \????choice {choice} \????choice

% capture the native itemgroup entry points before any group redirects them
\let\strc_choices_orig_itemgroupparameter       \itemgroupparameter
\let\strc_choices_orig_setupcurrentitemgroup    \setupcurrentitemgroup
\let\strc_choices_orig_setitemgroupparameter    \setitemgroupparameter
\let\strc_choices_orig_letitemgroupparameter    \letitemgroupparameter
\let\strc_choices_orig_chaintocurrentitemgroup  \chaintocurrentitemgroup
\let\strc_choices_orig_directitemgroupparameter \directitemgroupparameter
\let\strc_choices_orig_resetitemgroupparameter  \resetitemgroupparameter

\def\strc_choices_ifours#1#2{\ifcsname strcchoicesmark:\currentparentitemgroup\endcsname#1\else#2\fi}
\def\strc_choices_itemgroupparameter#1%
  {\strc_choices_ifours{\choiceparameter{#1}}{\strc_choices_orig_itemgroupparameter{#1}}}
\def\strc_choices_setupcurrentitemgroup[#1]%
  {\strc_choices_ifours{\setupcurrentchoice[#1]}{\strc_choices_orig_setupcurrentitemgroup[#1]}}
\def\strc_choices_setitemgroupparameter#1#2%
  {\strc_choices_ifours{\setchoiceparameter{#1}{#2}}{\strc_choices_orig_setitemgroupparameter{#1}{#2}}}
\def\strc_choices_letitemgroupparameter#1#2%
  {\strc_choices_ifours{\letchoiceparameter#1#2}{\strc_choices_orig_letitemgroupparameter#1#2}}
\def\strc_choices_chaintocurrentitemgroup#1%
  {\strc_choices_ifours{\chaintocurrentchoice{#1}}{\strc_choices_orig_chaintocurrentitemgroup{#1}}}
\def\strc_choices_directitemgroupparameter#1%
  {\strc_choices_ifours{\directchoiceparameter{#1}}{\strc_choices_orig_directitemgroupparameter{#1}}}
\def\strc_choices_resetitemgroupparameter#1%
  {\strc_choices_ifours{\resetchoiceparameter{#1}}{\strc_choices_orig_resetitemgroupparameter{#1}}}

\appendtoks
    \protected\frozen\instance\edefcsname\e!start\strc_choices_bare\endcsname{\startnamedchoice[\currentchoice]}%
    \protected\frozen\instance\edefcsname\e!stop \strc_choices_bare\endcsname{\stopnamedchoice}%
    \protected\frozen\instance\edefcsname        \strc_choices_bare\endcsname{\directnamedchoice[\currentchoice]}%
    \let\currentparentitemgroup\currentchoice
    \expandafter\let\csname strcchoicesmark:\currentchoice\endcsname\relax
    \definecounter[\v_strc_itemgroups_counter]%
\to \everydefinechoice

\setvalue{\??itemgroupkeyword\v!vertical}{\setfalse\c_strc_itemgroups_horizontal
                                          \setfalse\c_strc_itemgroups_collecting
                                          \setfalse\c_strc_itemgroups_text
                                          \setfalse\c_strc_itemgroups_inline
                                          \setfalse\c_strc_itemgroups_joined
                                          \strc_itemgroups_process_set_option_unpack}

\let\strc_choices_normal_define\definechoice

\def\strc_choices_bare{\s!choice}

% user-facing name stays bare, the registered instance becomes env!<name>
\permanent\overloaded\tolerant\protected\def\definechoice[#S#1]#*[#S#2]#*[#S#3]
  {\def\strc_choices_bare{#1}%
   \ifhastok={#2}%
     \strc_choices_normal_define[env!#1][#2]%
   \else\ifempty{#2}%
     \strc_choices_normal_define[env!#1]%
   \else
     \strc_choices_normal_define[env!#1][env!#2]%
   \fi\fi}

\let\strc_choices_normal_setup\setupchoice

\def\strc_choices_setup_each#category#whatever%
  {\ifhastok={#whatever}%
     \strc_choices_normal_setup[env!#category][#whatever]%
   \else
     \strc_choices_normal_setup[env!#category][\c!option={#whatever}]%
   \fi}

\def\strc_choices_setup_list_level_a#category#whatever#level%
  {\strc_choices_normal_setup[env!#category:#level][#whatever]}

\def\strc_choices_setup_list_level_b#category#whatever#level%
  {\strc_choices_normal_setup[env!#category:#level][\c!option={#whatever}]}

\def\strc_choices_setup_list#subcategories#category#whatever%
  {\ifhastok={#whatever}%
     \processcommalist[#subcategories]{\strc_choices_setup_list_level_a{#category}{#whatever}}%
   \else
     \processcommalist[#subcategories]{\strc_choices_setup_list_level_b{#category}{#whatever}}%
   \fi}

\permanent\overloaded\tolerant\protected\def\setupchoice[#S#category]#spacer[#S#levels]#spacer[#S#options]#spacer[#S#settings]%
  {\ifarguments
   \or
     \edef\strc_itemgroups_setup_what{#levels}%
     \strc_choices_normal_setup[#category]%
   \or
     \edef\strc_itemgroups_setup_what{#levels}%
     \strc_choices_setup_each{#category}{#levels}%
   \or
     \edef\strc_itemgroups_setup_what{#levels}%
     \ifx\strc_itemgroups_setup_what\v!each
       \strc_choices_setup_each{#category}{#options}%
     \else
       \strc_choices_setup_list{#levels}{#category}{#options}%
     \fi
   \or
     \edef\strc_itemgroups_setup_what{#levels}%
     \ifx\strc_itemgroups_setup_what\v!each
       \strc_choices_setup_each{#category}{#options}%
       \strc_choices_setup_each{#category}{#settings}%
     \else
       \strc_choices_setup_list{#levels}{#category}{#options}%
       \strc_choices_setup_list{#levels}{#category}{#settings}%
     \fi
   \fi
}

\def\C_strc_itemgroups_tag_start_group
  {\dostarttaggedchained\currentexamenvironment\currentparentitemgroup\currentitemgroup\??choice
   \dotagsetitemgroup}

\permanent\tolerant\protected\def\startnamedchoice[#S#category]#spacer[#S#options]#spacer[#S#settings]%
 {\begingroup\nofarguments\lastarguments
  \def\currentchoice{#category}%
  \edef\bem_choice_category{#category}%
  \def\currentexamenvironment{\s!choice}%
  \enforced\let\itemgroupparameter       \strc_choices_itemgroupparameter
  \enforced\let\setupcurrentitemgroup    \strc_choices_setupcurrentitemgroup
  \enforced\let\setitemgroupparameter    \strc_choices_setitemgroupparameter
  \enforced\let\letitemgroupparameter    \strc_choices_letitemgroupparameter
  \enforced\let\chaintocurrentitemgroup  \strc_choices_chaintocurrentitemgroup
  \enforced\let\directitemgroupparameter \strc_choices_directitemgroupparameter
  \enforced\let\resetitemgroupparameter  \strc_choices_resetitemgroupparameter
  \let\strc_itemgroups_tag_start_group_origin\strc_itemgroups_tag_start_group
  \let\strc_itemgroups_tag_start_group   \C_strc_itemgroups_tag_start_group
  \d_width_cit_max\zeropoint
  \initcollectanswer
  \ifcase\nofarguments
    \def\bem_choice_options{}\def\bem_choice_settings{}%
  \or
    \def\bem_choice_options{}\def\bem_choice_settings{}%
  \or
    \ifhastok={#options}%
      \def\bem_choice_options{}\edef\bem_choice_settings{#options}%
      \setupchoice[#options]%
    \else
      \edef\bem_choice_options{#options}\def\bem_choice_settings{}%
    \fi
  \or
    \edef\bem_choice_options{#options}\edef\bem_choice_settings{#settings}%
    \setupchoice[#settings]%
  \fi
  \edef\p_inlinechoice {\choiceparameter\c!inlinechoice}%
  \edef\p_answerstyle  {\choiceparameter\c!answerstyle}% 
  \edef\p_answercolor  {\choiceparameter\c!answercolor}%
  \edef\p_correctsymbol{\choiceparameter{correctsymbol}}%
}

\protected\def\stopnamedchoice{%
  \d_bem_extralabelwidth = \dimexpr \d_width_cit_max        + \choiceparameter{extralabelwidth}
                                  + \choiceparameter{width} + \choiceparameter{distance} + \leftskip\relax
  \d_bem_maxiwidth = \dimexpr\choiceparameter{maxiwidth}\relax
  % \doiftrueelse\s!choice\c!inlinechoice{}{\hsize=\d_bem_maxiwidth\relax}%
  \ctxlua{thirddata.basicexam.choice_prepare()}%
  \ifempty\bem_choice_settings
    \edef\bem_choice_settings{n=\the\c_availablecolumns}%
  \else
    \edef\bem_choice_settings{n=\the\c_availablecolumns,\bem_choice_settings}%
  \fi% 我们必须要完全展开 itemgroup 的三个参数
  \par ==？[\bem_choice_category][\bem_choice_options][\bem_choice_settings]
  \expanded{\noexpand\startitemgroup[\bem_choice_category][\bem_choice_options][\bem_choice_settings]}
    \ifmode_showanswer\else\doiftrueelse\s!choice\c!showanswer\mode_showanswertrue\mode_showanswerfalse\fi
    \usechoicestyleandcolor\c!textstyle\c!textcolor
    \choiceparameter\c!inlineleft
    \ctxlua{thirddata.basicexam.choice_finish("\ifmode_showanswer 1\else 0\fi")}%
    \choiceparameter\c!inlineright
  \stopitemgroup
  \edef\currentcollectedanswer{\collectedanswer}%
  \edef\currentanswer{%
    \ifempty\currentcollectedanswer\currentanswer
    \else\currentcollectedanswer\fi}%
  \UnlimitedAddScoredAnswer{\currentanswer}{\currentpoint}%
  \endgroup
}

\tolerant\protected\def\directnamedchoice[#1]#*[#2]#*[#3]#:#4%
{\startnamedchoice[#1][#2][#3]%
  \ctxlua{thirddata.basicexam.process_choice([==[#4]==])}%
  \stopnamedchoice
}

\setupchoice
  [\c!margin=\zeropoint,
   \c!leftmargin=\zeropoint,
   \c!rightmargin=\zeropoint,
   \c!leftmargindistance=\zeropoint,
   \c!rightmargindistance=\zeropoint,
   \c!indentnext=\v!yes,
   \c!width=1.5\emwidth,
   \c!factor=0,
   \c!step=.5\emwidth,
   \c!distance=\zeropoint,
   \c!marstyle=\v!type,
   \c!n=0,
   \c!items=4,
   \c!levels=10,
   \c!lefttext=\__CapLparen,
   \c!righttext=\__CapRparen,
   \c!start=1,
   \c!packcriterium=\zerocount,
   \c!criterium=\v!all,
   \c!textdistance=\v!space,
   \c!lasttextseparator=\itemgroupparameter\c!textseparator,
   \c!indenting=\v!next,
   \c!symbol=\currentitemlevel,
   \c!prefix=\v!no,
   \c!prefixconnector=.,
   \c!numberseparatorset=,
   \c!numberconversionset=,
   \c!numberstopper=.,
   \c!numbersegments=1,
   \c!command=\strc_itemgroups_default_command,
   \c!before=\blank,
   \c!inbetween=\blank,
   \c!after=\blank,
   \c!afterhead=\blank,
   \c!placestopper=\v!yes,
   \c!stopper=.,
   \c!symcolor=\itemgroupparameter\c!color,
   \c!symstyle=\itemgroupparameter\c!style,]

\setupchoice [\c!answerstyle=\ss,
              \c!answercolor=red,
             \c!inlinechoice=false, 
         \c!numberconversion=A,
                   \c!option={A,packed,joinedup,},
                   \c!before=,
                    \c!after=,
                    \c!point=\questionparameter\c!point,
             extralabelwidth=0pt,
                   maxiwidth=\hsize,]

\definechoice[choice]
\definechoice[inlinechoice]
\tolerant\def\setupinlinechoice{\setupchoice[inlinechoice]}

\setupinlinechoice[\c!option={text,marksquare,packed,joinedup,},
             \c!inlinechoice=\s!true,
               correctsymbol={\symbol{marksquarecheck}},
               \c!inlineleft={(\nobreak},
              \c!inlineright={\nobreak)},
                   \c!before=,
                    \c!after=,
                %\c!lefttext={},
               %\c!righttext={},
             %\c!answerstyle=,
                 %\c!stopper=,
              %\c!showanswer=,% shoule be empty before used
                \c!separator={\removeunwantedspaces,\space},
                   ]

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%D \section{设置 solution 环境}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\installnamespace {solution}
\installnamespace {solutionalternative}
\installnamespace {solutionrenderings}

\installcommandhandler \????solution            {solution}            \????solution
\installcommandhandler \????solutionalternative {solutionalternative} \????solutionalternative

\appendtoks
    \protected\frozen\instance\edefcsname        \currentsolution\endcsname{\solution_direct_instance[\currentsolution]}%
    \protected\frozen\instance\edefcsname\e!start\currentsolution\endcsname{\solution_start_instance [\currentsolution]}%
    \protected\frozen\instance\letcsname \e!stop \currentsolution\endcsname \solution_stop_instance
\to \everydefinesolution

\tolerant\protected\def\solution_direct_instance[#S#1][#S#2]#:#3%
  {\begingroup
    \cdef\currentsolution{#1}%
    \edef\getsolutionbuffer{#3}%
    \ifdefined\SavedCurrentID\else\edef\SavedCurrentID{}\fi
    \UnlimitedSaveSolutionID\SavedCurrentID
    \setupcurrentsolution[#2]%
    \doiftrue\s!solution\c!showanswer  \mode_showanswertrue
    \doiftrue\s!solution\c!showpoint   \mode_showpointtrue
    \doiftrue\s!solution\c!showscript  \mode_showscripttrue
    \doiftrue\s!solution\c!showsolution\mode_showsolutiontrue
    \ifmode_showscript  \donetrue\fi
    \ifmode_showanswer  \donetrue\fi
    \ifmode_showpoint   \donetrue\fi
    \ifmode_showsolution\donetrue\fi
    \ifdone
      \solutionparameter\c!before
      \begingroup
      \language[\solutionparameter\c!language]%
      \usesolutionstyleandcolor\c!style\c!color
      \usealignparameter\solutionparameter
      \edef\currentsolutionalternative{\solutionparameter\c!alternative}%
      \ifcsname\currentsolutionalternativehash\s!parent\endcsname \else
        \let\currentsolutionalternative\s!default
      \fi
      \usesetupsparameter\solutionparameter
      \edef\p_renderingsetup{\solutionalternativeparameter\c!renderingsetup}%
      \dostarttagged\s!solution\currentsolution
      \directsetup\p_renderingsetup
      \dostoptagged
      \endgroup
      \solutionparameter\c!after
    \fi
  \endgroup
}

\protected\tolerant\def\solution_start_instance[#S#1]#*[#S#2]#*%
  {\begingroup
  \cdef\currentsolution{#1}%
  \setupcurrentsolution[#2]%
  \ifdefined\SavedCurrentID\else\edef\SavedCurrentID{}\fi
  \UnlimitedSaveSolutionID\SavedCurrentID
  \grabbufferdatadirect% {\s!solution:\currentsolution}%
    {\s!solution}% unnested, as before
    {\e!start\currentsolution}%
    {\e!stop \currentsolution}}

\permanent\protected\def\solution_stop_instance{%
  \doiftrue\s!solution\c!showanswer  \mode_showanswertrue
  \doiftrue\s!solution\c!showpoint   \mode_showpointtrue
  \doiftrue\s!solution\c!showscript  \mode_showscripttrue
  \doiftrue\s!solution\c!showsolution\mode_showsolutiontrue
  \ifmode_showscript  \donetrue\fi
  \ifmode_showanswer  \donetrue\fi
  \ifmode_showpoint   \donetrue\fi
  \ifmode_showsolution\donetrue\fi
  \ifdone
    \leftskip0pt\relax\rightskip\leftskip\relax
    \solutionparameter\c!before
    \begingroup
    \language[\solutionparameter\c!language]%
    \usesolutionstyleandcolor\c!style\c!color
    \usealignparameter\solutionparameter
    \edef\currentsolutionalternative{\solutionparameter\c!alternative}%
    \ifcsname\currentsolutionalternativehash\s!parent\endcsname \else
      \let\currentsolutionalternative\s!default
    \fi
    \usesetupsparameter\solutionparameter
    \edef\p_renderingsetup{\solutionalternativeparameter\c!renderingsetup}%
    \dostarttagged\s!solution\currentsolution
    \directsetup\p_renderingsetup
    \dostoptagged
    \endgroup
    \solutionparameter\c!after
  \fi
  \endgroup}

\tolerant\protected\def\getsolutionbuffer      [#1]{\getbufferdata[\s!solution]}
\tolerant\protected\def\getinlinesolutionbuffer[#1]{\inlinebuffer [\s!solution]}

\definesolutionalternative
  [\s!default]
  [\c!renderingsetup=\????solutionrenderings:\s!default]

\startsetups[\????solutionrenderings:\s!default]
  \starttextbackground[env!solution]
    \ifmode_showscript
      \noindent
      \solutionparameter{scriptcontent}%
    \else
      \noindent
      \initshowexaminfor[solution]%
      \showexaminfor[solution][answer]%
      \showexaminfor[solution][point]%
      \showexaminfor[solution][infor]%
      \ifmode_showsolution
        \ifmode_showanswer\solutionparameter\c!inbetween\fi
        \getsolutionbuffer
      \fi
    \fi
  \stoptextbackground
\stopsetups

\tolerant\protected\def\startoldsolution[#1]#:#2\stopoldsolution%
{\begingroup
  \lettonothing\getsolutionbuffer
  \lettonothing\getinlinesolutionbuffer
  \cdef\currentsolution{#1}%
  \setupcurrentsolution[#2]%
  \edef\getsolutionbuffer{#2}%
  \usesetupsparameter\solutionparameter
  \edef\p_renderingsetup{\solutionalternativeparameter\c!renderingsetup}%
  \directsetup\p_renderingsetup
  \tolerant\protected\xdef\getsolutioncontent[##1]% only for writing env
    {#2}%%
  \endgroup}

\setupsolution
  [\c!answerlabel=\examtexts{answer},
  \c!pointlabel=\examtexts{point},
  \c!pointstyle=\solutionparameter\c!style,
  \c!pointcolor=\solutionparameter\c!color,
  \c!answerstyle=\solutionparameter\c!style,
  \c!answercolor=\solutionparameter\c!color,
  \c!style=,
  \c!before=\blank[quarterline]\leftskip1em\rightskip\leftskip\relax,
  \c!after=\blank[quarterline]\leftskip\zeropoint\rightskip\leftskip\relax,
  % \c!align=,
  \c!inbetween={\par},
  %\c!showscript=true,
  \c!showsolution=\ifmode_showanswer true\fi,
  scriptcontent={\noindent\ssx\gray Write solution Here},
  \c!alternative=\s!default,
  \c!language=\currentlanguage,
  ]

\definesolution[solution]
\definesolution[answer]
\def\setupanswer{\setupsolution[answer]}

\setuptextbackground[env!solution]%
  [\c!state=start,\c!before=,\c!after=,
  \c!location=paragraph,\c!width=local,
  \c!leftoffset=1ex,\c!rightoffset=1ex,
  \c!topoffset=.5ex,\c!bottomoffset=.5ex,
  \c!rulethickness=.5pt,
  \c!corner=round,\c!radius=2pt,
  \c!frame=on,\c!framecolor=lightthemecolor,
  \c!background=color,\c!backgroundcolor=palethemecolor,]

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%D \section{设置 pitem,citem 命令}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\installnamespace          {examitem}
\installcommandhandler \????examitem     {examitem}     \????examitem

\appendtoks
  \protected\frozen\instance\edefcsname        \currentexamitem\endcsname{\directnamedexamitem[\currentexamitem]}%
  \protected\frozen\instance\edefcsname\e!start\currentexamitem\endcsname{\startnamedexamitem[\currentexamitem]}%
  \protected\frozen\instance\edefcsname\e!stop \currentexamitem\endcsname{\stopnamedexamitem}
\to \everydefineexamitem

\def\doifTFitem{%
  \ifx\p_answer\wildcardsymbol
    \ifmode_showanswer
      \def\strc_itemgroups_extra_symbol{\questionparameter{truesymbol}}%
    \else
      \def\strc_itemgroups_extra_symbol{\questionparameter{symbol}}%
    \fi
    \c_strc_itemgroups_symbol\conditionaltrue
    \setupexamitem[\currentexamitem][answer=\symbol[markcheck]]%
  \else
    \ifmode_showanswer
      \def\strc_itemgroups_extra_symbol{\questionparameter{falsesymbol}}%
    \else
      \def\strc_itemgroups_extra_symbol{\questionparameter{symbol}}%
    \fi
    \c_strc_itemgroups_symbol\conditionaltrue
    \setupexamitem[\currentexamitem][answer=\symbol[markcross]]%
  \fi
}

\def\doifSymbol{%
  \edef\p_sym{\examitemparameter\c!symbol}%
  \ifempty\p_sym\else
    \def\strc_itemgroups_extra_symbol{\p_sym}%
    \c_strc_itemgroups_symbol\conditionaltrue
  \fi
}

\tolerant\protected\def\startnamedexamitem[#S#category]#*[#S#options]#*[#S#settings]%
{\begingroup\nofarguments\lastarguments
  \edef\currentexamitem{#category}%
  \ifcase\nofarguments
     \edef\p_answer{}%0 
  \or\edef\p_answer{}%1
  \or\edef\p_answer{#options}%2
     \setupexamitem[#category][#options]%
  \or\edef\p_answer{#options}%3
     \setupexamitem[#category][#settings]%
  \fi
  \examitemparameter\c!left
  \edef\p_ref{\examitemparameter\c!reference}%
  \edef\currentpoint{\questionparameter\c!point}
  \ifx\p_class\s!truefalse\doifTFitem\fi
  \doifSymbol
  \startitemgroupitem[\p_ref]%
    \let\strc_itemgroups_tag_start_group\strc_itemgroups_tag_start_group_origin
    \BasicExamPushLevel\s!examitem\currentexamenvironment
    \useexamitemstyleandcolor\c!textstyle\c!textcolor
}

\tolerant\protected\def\stopnamedexamitem{\BasicExamPopLevel\stopitemgroupitem\examitemparameter\c!right\endgroup}

\tolerant\protected\def\directnamedexamitem[#S#1]#*[#S#2][#S#3]#*{\groupedcommand{\startnamedexamitem[#1][#2][#3]}{\stopnamedexamitem}}

\defineexamitem[citem]% only for choice
\defineexamitem[pitem]% only for problem
\defineexamitem[oitem]% only for optclose
\defineexamitem[titem]% only for truefalse

\def\setupcitem{\setupexamitem[citem]}
\def\setuppitem{\setupexamitem[pitem]}
\def\setupoitem{\setupexamitem[oitem]}
\def\setuptitem{\setupexamitem[titem]}

\setuppitem[%showpoint=,
            %point=,
            %pointstyle=,
            %pointcolor=,
            pointlabel=\examtexts{point},
            answerlabel=\examtexts{answer},
            %showanswer=,
            %answer=,
            %answerstyle=,
            %answerstyle=,
            %reference=,
            %textstyle=,
            %textcolor=,
            ]

\definetextbackground[oitembar]
  [location=text,alternative=1,background=,frame=off,voffset=-2pt,rulethickness=0.5pt]

\setupoitem[
  \c!left=\starttextbackground[oitembar],
  \c!right=\stoptextbackground,]

%D [*](用于标记正确答案)
\def\applychoicestyleandcolor{%
  \ifempty\p_answerstyle
    \dousestyleparameter{\questionparameter\c!answerstyle}\else
    \dousestyleparameter{\p_answerstyle}\fi
  \ifempty\p_answercolor
    \dousecolorparameter{\questionparameter\c!answercolor}\else 
    \dousecolorparameter{\p_answercolor}\fi
}

\def\BEMmarksymbolon{%
  \ifx\p_correctsymbol\c!default\else% 保留 default，inlinechoice 不必强制设置 symbol
    \def\strc_itemgroups_extra_symbol{\ifempty\p_correctsymbol\symbol{marksquarecheck}\else\p_correctsymbol\fi}%
    \c_strc_itemgroups_symbol\conditionaltrue
  \fi}

\def\BEMmarksymboloff{\c_strc_itemgroups_symbol\conditionalfalse}

% 宽度在 TeX 端随 \startcitem 逐个累计，Lua 只负责收集、排序和输出。
\protected\def\get_citem_text#1{%
  \setbox\scratchbox=\hbox{%
    \usechoicestyleandcolor\c!textstyle\c!textcolor
    \applychoicestyleandcolor #1}%
  \d_width_cit=\wd\scratchbox\relax
  \ifdim\d_width_cit_max<\d_width_cit
    \d_width_cit_max=\d_width_cit\relax
  \fi}

\overloaded\tolerant\protected\def\startcitem[#1]#*#:#2\stopcitem{%
  \get_citem_text{#2}%
  \edef\bem_choice_correctmark{#1}%
  \edef\bemitemstring{\detokenize{#2}}%
  \ctxlua{thirddata.basicexam.choice_add_item(
    token.scan_toks(),
    "\bem_choice_correctmark",
    token.get_macro("bemitemstring"))}{#2}%
}

\overloaded\def\citem{\dosingleempty\citem_indeed}
\def\citem_indeed[#1]#2{\startcitem[#1]{#2}\stopcitem}
%D 谨慎使用下面的 fragilecitem，他并不安全。很有可能导致错误
\bgroup
\obeylines
\gdef\xcitem{\bgroup\obeylines\dosingleempty\doxcitem}%
\gdef\doxcitem[#1]#2
  {\egroup%
  \doifsomethingelse{#1}%
  {\startcitem[*]#2\stopcitem}%
  {\startcitem #2\stopcitem}%
  }%
\egroup

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%D \section{設置 fillin 命令}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%D The command is recommended to be used within the pitem environment.
%D Of course, since pitem itself also has an answer key, it can be set through this key.
%D
%D The fillin command mainly relies on the bar command.
%D Basically, modifying the bar command can modify the fillin command.
%D The fillin command has two parameters that refer to textnote: empty and n.
%D empty=yes hides the answer; empty=number shows the number and hides the answer; empty=none shows the answer.
%D n=* hides the answer, with a length equal to the answer length; n=NUMBER controls the length of the bar.

%D There are four main styles of bar, which can be set by mp parameters:
%D rules:under:dots    %rules:under:random
%D rules:under:dash    %rules:under:wave

%D 新增一个 align=autoright 来让 fillin 对齐右方。

\installnamespace {fillin}
\installnamespace {fillinalternative}
\installnamespace {fillinrenderings}

\installframedcommandhandler\????fillin            {fillin}            \????fillin
\installcommandhandler      \????fillinalternative {fillinalternative} \????fillinalternative

\appendtoks
  \protected\frozen\instance\edefcsname \currentfillin\endcsname{\directnamedfillin[\currentfillin]}%
\to \everydefinefillin

\setupfillin[%foregroundcolor=,
             %before=,after=,
             %left=,right=,
             %repeat=,mp=
              alternative=default,
              rule=FillinText,% 引用 bar 命令
              empty=\ifmode_showanswer none\else yes\fi,
              continue=yes,
              unit=em,
              order=foreground,
              method=0,
              %color=gray,
              width=4em,
              n=8,
              dy=-0.35,
              max=3,
              offset=-.1,
              rulethickness=.5pt,
              style=\ss,]

% \setupfillin[width=fit,offset=0pt,location=low] %if alternative=framed

\tolerant\protected\def\directnamedfillin[#1]#*[#2]#:#3{%
  \begingroup
    \edef\currentfillin{#1}%
    \edef\temp_fillinanswer{#3}%
    \ifparameters\or\or\setupcurrentfillin[#2]\or\setupfillin[#2]\fi
    \global\advance\c_fillinnumber by \plusone
    \ifx\currentexamenvironment\s!close
      \let\SavedCurrentID\relax
      % close 环境比较特殊，他并未提前定义环境，而是在最后才定义
      % 所以此刻 \UnlimitedSavedCurrentPoint \UnlimitedSavedCurrentAnswer
      % 都尚未被定义，下面也没有采用这两个命令。避免未定义错误
    \fi
    \scratchcounter\UnlimitedGetExtraNumber{\SavedCurrentID}{availablecolumns}{0}%
    \c_availablecolumns=\number\scratchcounter
    \def\currentfillinanswer%
      {\ifempty\temp_fillinanswer
        \ifdefined\currentanswer
          \ifnum\c_availablecolumns>\zerocount
            \UnlimitedGetExtraData{\SavedCurrentID}{answer}% question 未定义答案时我们直接读取choice环境的答案
          \else
            \currentanswer
          \fi
        \else
          \UnlimitedGetExtraData{\SavedCurrentID}{answer}%
        \fi
      \else 
        \temp_fillinanswer
      \fi}% 如果 #3 为空，就使用前一個答案
    \edef\p_number{\number\c_fillinnumber}%
    \edef\p_align{\fillinparameter\c!align}%
    \edef\currentfillinalternative{\fillinparameter\c!alternative}%
    \ifcsname\currentfillinalternativehash\s!parent\endcsname\else
      \let\currentfillinalternative\s!default
    \fi
    \usesetupsparameter\fillinparameter
    \edef\p_renderingsetup{\fillinalternativeparameter\c!renderingsetup}%
    \doifinset{\c!autoright}{\p_align}%
      {\nobreak\hfill\penalty50\null\nobreak\hfill}%
      {\allowbreak}%
    \usefillinstyleandcolor\c!style\c!color
    \fillinparameter\c!before
    \fillinparameter\c!left
    \dostarttagged\s!fillin\currentfillin
    \directsetup\p_renderingsetup
    \dostoptagged
    \fillinparameter\c!right
    \fillinparameter\c!after
    \doifinset{\c!autoright}{\p_align}%
      {\parfillskip=0pt \finalhyphendemerits=0 \par}%
      {\allowbreak}%
    \collectanswer{\currentfillinanswer}%多次收集答案
    \edef\currentanswer{\collectedanswer}%汇总最后的答案
    \ifdefined\currentpoint\relax\else\let\currentpoint\empty\fi
    \UnlimitedAddScoredAnswer{\currentanswer}{\currentpoint}%
  \endgroup
}

\definefillinalternative
  [\s!default]
  [\c!renderingsetup=\????fillinrenderings:\s!default]

\definefillinalternative
  [\c!frame]
  [\c!renderingsetup=\????fillinrenderings:\c!frame]

\definefillinalternative
  [simple]
  [\c!renderingsetup=\????fillinrenderings:simple]

\startsetups[\????fillinrenderings:\s!default]
  \edef\currentbar{\fillinparameter\c!rule}%
  \ifmode_showanswer\setfillinparameter{empty}{none}\fi
  \ifx\currentexamenvironment\s!close\setfillinparameter{empty}{number}\fi
  \edef\p_empty{\fillinparameter\c!empty}%
  \edef\p_n{\fillinparameter\c!n}%
  \def\currentfillincontent%
    {\ifchknum\p_n\or
      \scratchcounterone\numexpr\p_n/2\norelax
      \interwordspacesbefore\scratchcounterone
      \ifx\p_empty\v!yes   \fi
      \ifx\p_empty\v!number\zwnj\runninghbox{\resetbar\p_number}\zwnj\fi
      \ifx\p_empty\v!none  \currentfillinanswer\fi
      \interwordspacesafter\scratchcounterone
    \fi}
  \start
    \dontleavehmode
    \overloaded\let\barparameter\fillinparameter
    \node_rules_set\currentbar{\currentfillincontent}%
  \stop
\stopsetups

\startsetups[\????fillinrenderings:\c!frame]
  \ifmode_showanswer\setfillinparameter{empty}{none}\fi
  \ifx\currentexamenvironment\c!close\setfillinparameter{empty}{number}\fi
  \edef\p_empty{\fillinparameter\c!empty}%
  \def\currentfillincontent{%
    \ifx\p_empty\v!yes   \fi
    \ifx\p_empty\v!number\p_number\fi
    \ifx\p_empty\v!none  \currentfillinanswer\fi}%
  \inheritedfillinframed\bgroup
      \currentfillincontent
  \egroup
\stopsetups

\startsetups[\????fillinrenderings:simple]
  \ifmode_showanswer
    \currentfillinanswer
  \else
    \leavevmode\leaders\hrule height 1pt\hfill\kern0pt
  \fi
\stopsetups

\definefillin[fillin]
\definefillin[closebar][fillin] % 只用于 close 环境
\setupfillin [closebar][empty=number]
\definefillin[fillinframe]  [alternative=frame,offset=0pt,location=low,left=\thinspace,right=\thinspace,align={lohi,center}]
\definefillin[fillinbracket][fillinframe][left=\__CapLparen,right=\__CapRparen,align={center,autoright},framecolor=transparentcolor,style=,]

\startuseMPgraphic{rules:under:wave}
  numeric wave_amplitude;
  wave_amplitude := 2 * (RuleThickness / 1pt);   % 振幅
  vardef lsin primary x =
      wave_amplitude * sin(x/1pt)
  enddef ;
  draw function(1, "x", "lsin(1.2*x)", 0, RuleWidth, .1pt)
        shifted (0,RuleFactor*RuleOffset+RuleDepth)
        withpen pencircle scaled RuleThickness
        withcolor RuleColor ;
  setbounds currentpicture to unitsquare xysized(RuleWidth,RuleHeight) ;
\stopuseMPgraphic
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%D \section{設置 material 環境}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%D 顧名思義，\tex{material} 環境用來放置大段文本材料。
%D 該環境比較特殊，它設置了多個子實例來進行更完善的設置。
%D 除了 \tex{setupmaterial[number]} 這個實例繼承了 \tex{setupcounter} 的全部鍵值之外，
%D 其他實例都是新定義的鍵值。

%D 這些實例分別是：
%D \startitemize[nowhite,joinedup,packed]
%D \item \tex{setupmaterial[number]}    設置 該環境標題的 {\bf 序號};
%D \item \tex{setupmaterial[title]}     設置 該環境的 {\bf 標題} 相關的樣式;
%D \item \tex{setupmaterial[author]}    設置 該環境文章的 {\bf 作者} 相關的樣式;
%D \item \tex{setupmaterial[source]}    設置 該環境文章的 {\bf 具體來源} 的相關樣式。
%D \item \tex{setupmaterial[indicator]} 設置 該環境文章的 {\bf 畫線序號文字} 的相關樣式。
%D \stopitemize

%D 此外，\type{title},\type{author},\type{source} 的名稱是通過 \tex{setupmaterial}
%D 來直接設置。此外， 該環境具有一個特殊的子命令 \tex{indicator} 來標記文章中的提問的部分並
%D 進行添加數字標識 --- （一）畫線文字。因此，\tex{setupmaterial} 還具有一個鍵值 indicator
%D 通過 \type{indicator=reset} 對 indicator 進行重置，每當開啓一個新的 material 環境。
%D 通過 \type{indicator=continue} 對 indicator 取消重置，它將持續計數。
%D 當然，也可以直接通過 \tex{setupmaterial[indicator][reset=true]} 來啓用重新計數

%D 以上所有實例都具有以下鍵值：
%D before after align style color
%D 此外，\tex{setupmaterial} 可以通过 spacebefore 和spaceafter 来控制环境前后的垂直距离

%D notice , if you want change [start = number] after a chapter ,
%D you should use \tex{resetcount[COUNTER_NAME]} to reset current counter
%D to the number of start you've setted.
%D otherwise, you need put [start = number] before the chapter you want
%D to reset the counter.

\installnamespace          {material}
\installcommandhandler \????material  {material}  \????material
\installcounterassociation {material}

\appendtoks
  \registermaterialcounter{material:\currentmaterial}
  \definecounter[material:\currentmaterial]%
\to \everydefinematerial

\appendtoks
  \synchronizematerialcounters
\to \everysetupmaterial

\definematerial [material]
\definematerial [number]
\definematerial [indicator]
\definematerial [indicator_helper][indicator]

\setupmaterial [\c!headalign=center,
                %\c!color=,
                %\c!style=,
                \c!spacebefore=line,
                \c!spaceafter=line,
                \s!number=yes,
                %\c!title=,
                %\c!author=,
                %\c!source=,
                \c!indicator=continue,
                \c!indenting=,]
\setupmaterial [\c!number] [\c!before={(},\c!after={)},
                            \c!prefix=no,\c!start=0,
                            \c!align=center,
                            \c!style=\namedmaterialparameter\c!title\c!style,
                            \c!color=\namedmaterialparameter\c!title\c!color,
                            \c!numberconversion=\examtexts{conversion},\c!way=\v!by\v!chapter]
\setupmaterial [\c!title]  [\c!style=\ss\tfa,\c!color=,\c!align=center,
                            \c!before=\space,\c!after=\par]
\setupmaterial [\c!author] [\c!style=\tf,\c!color=,\c!align=flushright,\c!after=\par]
\setupmaterial [\c!source] [\c!before=\par,\c!align=flushright]
\setupmaterial [indicator,indicator_helper]
               [\c!style=\ssbf,
                \c!color=,
                \c!before={\;(\nobreak\,\nobreak},
                \c!after={\nobreak\,\nobreak)\;},
                \c!prefix=no,
                \c!numberconversion=\examtexts{conversion},
                \c!type=line,
                \c!reset=false,
                \c!method=0,% below is for bar setting
                \c!continue=\v!yes,
                \c!empty=,
                \c!offset=-0.3,
                \c!dy=-0.35,
                \c!max=3,
                \c!rulethickness=.1,
                \c!order=\v!foreground,
                \c!unit=ex,]

\def\material_parameter#1#2%creat new element in material
  {{\begingroup
    \edef\currentmaterial{#1}%
    \setupalign[\namedmaterialparameter\currentmaterial\c!align]%
    \usematerialstyleandcolor\c!style\c!color
    \namedmaterialparameter\currentmaterial\c!before
    \dostarttagged{\s!material meta}\currentmaterial
    \scratchcounter#2\relax
    \ifnum\scratchcounter=\zerocount
      \expandafter\doifemptyelse\expandafter{\rootmaterialparameter\currentmaterial}%
      {\rootmaterialparameter\currentmaterial}%
      {\namedmaterialparameter\s!material\currentmaterial}%
    \else
      \incrementcounter[material:#1]\convertedcounter[material:#1]%
    \fi
    \dostoptagged
    \namedmaterialparameter\currentmaterial\c!after
    \endgroup}}

\tolerant\protected\def\startmaterial[#1]#*{\begingroup%
  \lettonothing\currentmaterial%%
  \edef\currentmaterial{material}\env_materialtrue
  \iffirstargument\setupcurrentmaterial[#1]\fi
  \edef\p_indicator{\materialparameter\c!indicator}%
  \edef\p_reset{\namedmaterialparameter{indicator}\c!reset}%
  \processaction[\p_indicator][
    reset=>\let\indicator_reset_helper\resetindicators,
  continue=>\continue_countertrue\let\indicator_reset_helper\relax,]%
  \processaction[\p_reset][
    true=>\let\indicator_reset_helper\resetindicators,
    false=>\continue_countertrue\let\indicator_reset_helper\relax,]%
  \dostarttagged\s!material\currentmaterial
  \indicator_reset_helper
  \usematerialstyleandcolor\c!style\c!color%
  \materialparameter\c!before
  \blank[\materialparameter\c!spacebefore]%
  \startalignment[\materialparameter\c!headalign]%
    \doiftrue{material}\c!number{\material_parameter\c!number\plusone}%
    \material_parameter\c!title\zerocount
    \material_parameter\c!author\zerocount
  \stopalignment
  \materialparameter\c!inbetween
  \usealignparameter\materialparameter
  \setupindenting[\materialparameter\c!indenting]%
  \penalty 10000\relax
  \dostarttagged{\s!material content}{\s!material content}}

\def\stopmaterial{%
    \material_parameter\c!source\zerocount
    \materialparameter\c!after
    \blank[\materialparameter\c!spaceafter]%
    \indicator_reset_helper
    \dostoptagged
    \endgroup}

\tolerant\protected\def\indicator[#1]#*[#2]#:#3%
  {\begingroup
  \def\currentmaterial{indicator}%
  \edef\p_class{#1}%
  \ifparameter#2\or
    \setupmaterial[\currentmaterial][#2]%
  \else 
    \ifhastok={#1}
      \setupmaterial[\currentmaterial][#1]%
    \fi
  \fi
  \edef\indicator_type{\namedmaterialparameter\currentmaterial\c!type}%
  \edef\indicator_reset{\namedmaterialparameter\currentmaterial\c!reset}%
  \overloaded\def\barparameter{\namedmaterialparameter\currentmaterial}%
  \iftok{\indicator_type}{line}\let\indicator_type\underbar
    \else\let\indicator_type\relax\fi
  \usematerialstyleandcolor\c!style\c!color%
  \indicator_type\bgroup
  \namedmaterialparameter\currentmaterial\c!before%
  \ifenv_material
    \ifx\p_class\wildcardsymbol\else
    \incrementcounter[material:\currentmaterial]\fi
    \convertedcounter[material:\currentmaterial]%
  \else
    \ifx\p_class\wildcardsymbol\else
    \incrementcounter[material:indicator_helper]\fi
    \convertedcounter[material:indicator_helper]%
  \fi
  \namedmaterialparameter\currentmaterial\c!after
  \penalty0\norelax
    #3\egroup
  \endgroup}

\def\indicators{%%% TODO 增強該命令的用法
  \ifenv_material
    \incrementcounter[material:indicator]%
    \convertedcounter[material:indicator]%
  \else
    \incrementcounter[material:indicator_helper]%
    \convertedcounter[material:indicator_helper]%
  \fi}
\def\resetindicators{\setcounter[material:indicator][0]%
                     \setcounter[material:indicator_helper] [0]}

