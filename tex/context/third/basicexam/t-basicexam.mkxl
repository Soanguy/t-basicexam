%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%D \section{设定一些可能用得到的符号 / Symbol Defination / シンボルの定義}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcount\BEM_markstyle\BEM_markstyle=0
\def\BEM_markcolor{black}

\startMPdefinitions
  % 手绘随机化宏
  numeric sketch_amount;  
  numeric sketch_segments;
  numeric sketch_passes; 

  primarydef p sketchrandomized s =
    ( if path p :
        for t = 0 step 1/sketch_segments until 1-1/sketch_segments :
          ((point (t*arclength(p)) on p) randomshifted s) ..
          controls ((postcontrol (t*arclength(p)) on p) randomshifted s)
               and ((precontrol ((t+1/sketch_segments)*arclength(p)) on p) randomshifted s) ..
        endfor
        if cycle p : cycle
        else : ((point arclength(p) on p) randomshifted s) fi
      else : p fi )
  enddef ;

  % 线宽设置
  numeric mark_thin, mark_heavy;
  mark_thin  := 0.055;
  mark_heavy := 0.085;

  % 路径定义（全部严格以 (0,0) 为中心，确保组合时不偏移）
  path mark_path_square, mark_path_circle, mark_path_check,
       mark_path_crossa, mark_path_crossb, mark_path_slash;
  path mark_path_notcheck_slash;

  mark_path_square  := (-0.4, -0.4) -- (0.4, -0.4) -- (0.4, 0.4) -- (-0.4, 0.4) -- cycle;
  mark_path_circle  := fullcircle scaled 0.85;
  mark_path_check   := (-0.25, -0.05) -- (-0.08, -0.22) -- (0.3, 0.25);
  mark_path_crossa  := (-0.3, -0.3) -- (0.3, 0.3);
  mark_path_crossb  := (-0.3, 0.3) -- (0.3, -0.3);
  mark_path_slash   := (-0.35, -0.35) -- (0.35, 0.35);
  mark_path_notcheck_slash := (-0.15, 0.25) -- (0.4, -0.3);

  % 核心绘制宏：ns 用于控制内部符号的缩放
  def markdrawpath(expr p, w, hd, c, bfs, ms, ns) =
    path q;
    q := p scaled (bfs * ms * ns);
    if hd > 0 :
      for i = 1 upto max(1, sketch_passes) :
        draw q sketchrandomized sketch_amount withpen pencircle scaled (w * bfs * ms) withcolor c ;
      endfor ;
    else :
      draw q withpen pencircle scaled (w * bfs * ms) withcolor c ;
    fi ;
  enddef ;

  def draw_thin (expr p, hd, c, bfs, ms, ns) = markdrawpath(p, mark_thin,  hd, c, bfs, ms, ns) ; enddef ;
  def draw_heavy(expr p, hd, c, bfs, ms, ns) = markdrawpath(p, mark_heavy, hd, c, bfs, ms, ns) ; enddef ;

  % 单一符号
  def draw_mark_square(expr hd, c, bfs, ms) = draw_thin(mark_path_square, hd, c, bfs, ms, 1.0) ; enddef ;
  def draw_mark_circle(expr hd, c, bfs, ms) = draw_thin(mark_path_circle, hd, c, bfs, ms, 1.0) ; enddef ;
  def draw_mark_check(expr hd, c, bfs, ms)  = draw_thin(mark_path_check, hd, c, bfs, ms, 1.2) ; enddef ;
  def draw_mark_check_heavy(expr hd, c, bfs, ms) = draw_heavy(mark_path_check, hd, c, bfs, ms, 1.2) ; enddef ;

  def draw_mark_cross(expr hd, c, bfs, ms) =
    draw_thin(mark_path_crossa, hd, c, bfs, ms, 1.0) ;
    draw_thin(mark_path_crossb, hd, c, bfs, ms, 1.0) ;
  enddef ;
  def draw_mark_cross_heavy(expr hd, c, bfs, ms) =
    draw_heavy(mark_path_crossa, hd, c, bfs, ms, 1.0) ;
    draw_heavy(mark_path_crossb, hd, c, bfs, ms, 1.0) ;
  enddef ;

  def draw_mark_notcheck(expr hd, c, bfs, ms) =
    draw_thin(mark_path_check, hd, c, bfs, ms, 1.2) ;
    draw_thin(mark_path_notcheck_slash, hd, c, bfs, ms, 1.0) ;  
  enddef ;

  % 组合符号 (外框 1.0 倍，内芯 0.65 倍)
  def draw_mark_squarecheck(expr hd, c, bfs, ms) =
    draw_thin(mark_path_square, hd, c, bfs, ms, 1.0) ;
    draw_thin(mark_path_check,  hd, c, bfs, ms, 0.65) ;
  enddef ;
  def draw_mark_squareheavycheck(expr hd, c, bfs, ms) =
    draw_thin(mark_path_square,  hd, c, bfs, ms, 1.0) ;
    draw_heavy(mark_path_check,  hd, c, bfs, ms, 0.65) ;
  enddef ;

  def draw_mark_squarecross(expr hd, c, bfs, ms) =
    draw_thin(mark_path_square, hd, c, bfs, ms, 1.0) ;
    draw_thin(mark_path_crossa, hd, c, bfs, ms, 0.65) ;
    draw_thin(mark_path_crossb, hd, c, bfs, ms, 0.65) ;
  enddef ;
  def draw_mark_squareheavycross(expr hd, c, bfs, ms) =
    draw_thin(mark_path_square,  hd, c, bfs, ms, 1.0) ;
    draw_heavy(mark_path_crossa, hd, c, bfs, ms, 0.65) ;
    draw_heavy(mark_path_crossb, hd, c, bfs, ms, 0.65) ;
  enddef ;

  def draw_mark_circlecheck(expr hd, c, bfs, ms) =
    draw_thin(mark_path_circle, hd, c, bfs, ms, 1.0) ;
    draw_thin(mark_path_check,  hd, c, bfs, ms, 0.65) ;
  enddef ;
  def draw_mark_circleheavycheck(expr hd, c, bfs, ms) =
    draw_thin(mark_path_circle,  hd, c, bfs, ms, 1.0) ;
    draw_heavy(mark_path_check,  hd, c, bfs, ms, 0.65) ;
  enddef ;

  def draw_mark_circlecross(expr hd, c, bfs, ms) =
    draw_thin(mark_path_circle, hd, c, bfs, ms, 1.0) ;
    draw_thin(mark_path_crossa, hd, c, bfs, ms, 0.65) ;
    draw_thin(mark_path_crossb, hd, c, bfs, ms, 0.65) ;
  enddef ;
  def draw_mark_circleheavycross(expr hd, c, bfs, ms) =
    draw_thin(mark_path_circle,  hd, c, bfs, ms, 1.0) ;
    draw_heavy(mark_path_crossa, hd, c, bfs, ms, 0.65) ;
    draw_heavy(mark_path_crossb, hd, c, bfs, ms, 0.65) ;
  enddef ;

  % ==========================================
  % 3. 最核心的基线包围盒对齐
  % ==========================================
  def markbounds(expr bfs, ms) =
    numeric s, h, d, pad;
    s := bfs * ms;                      % 标记的基准宽度（1em）
    h := 0.7 * bfs;                     % 匹配标准文本高度
    d := 0.3 * bfs;                     % 匹配标准文本深度
    pad := mark_heavy * bfs * ms;       % 加上线宽作为缓冲，防止撑破边界
    
    % 强制所有符号的宽度和高度绝对一致，解决间距忽大忽小的问题
    setbounds currentpicture to
      (unitsquare xscaled (s + pad) yscaled (h + d + pad))
        shifted (-(s+pad)/2, -d - pad/2) ;       
  enddef ;
\stopMPdefinitions

% ----------------- 3. 绘制入口 -----------------
%参数     作用            默认  效果
%sketch   抖动幅度（bp）  0.4   越大越"乱"
%segments 路径切分段数    20    越大越细腻
%passes   叠加描边次数    1     越大越"重"
\def\setupmark[#1]{%
  \getparameters[BEMmark][%
    style=normal, color=black, scale=0.8,
    sketch=0.4, passes=2, segments=250,
    #1]%
  \doifelse{\BEMmarkstyle}{handdrawn}
    {\def\BEMmarkhd{1}}
    {\def\BEMmarkhd{0}}%
}

% 初始化：让所有 \BEMmark* 变量立即存在
\setupmark[style=normal]

\def\drawmark#1{{%
  \edef\currentmarkid{mark-#1-\BEMmarkcolor-\BEMmarkscale-\BEMmarkhd-\BEMmarksketch-\BEMmarkpasses-\BEMmarksegments}%
  \startreusableMPgraphic{\currentmarkid}
    numeric bfs, ms, hd;
    bfs := \the\bodyfontsize / 1pt ;
    ms  := \BEMmarkscale ;
    hd  := \BEMmarkhd ;
    sketch_amount   := \BEMmarksketch * 1bp ;
    sketch_segments := \BEMmarksegments ;
    sketch_passes   := \BEMmarkpasses ;
    draw_mark_#1(hd, \MPcolor{\BEMmarkcolor}, bfs, ms) ;
    markbounds(bfs, ms) ;
  \stopreusableMPgraphic
  \reuseMPgraphic{\currentmarkid}%
}}
% ----------------- 4. 符号 -----------------

\definesymbol[marksquare]           [\drawmark{square}]
\definesymbol[markcircle]           [\drawmark{circle}]
\definesymbol[markcheck]            [\drawmark{check}]
\definesymbol[markheavycheck]       [\drawmark{check_heavy}]
\definesymbol[markcross]            [\drawmark{cross}]
\definesymbol[markheavycross]       [\drawmark{cross_heavy}]
\definesymbol[marknotcheck]         [\drawmark{notcheck}]
\definesymbol[marksquarecheck]      [\drawmark{squarecheck}]
\definesymbol[marksquareheavycheck] [\drawmark{squareheavycheck}]
\definesymbol[marksquarecross]      [\drawmark{squarecross}]
\definesymbol[marksquareheavycross] [\drawmark{squareheavycross}]
\definesymbol[markcirclecheck]      [\drawmark{circlecheck}]
\definesymbol[markcircleheavycheck] [\drawmark{circleheavycheck}]
\definesymbol[markcirclecross]      [\drawmark{circlecross}]
\definesymbol[markcircleheavycross] [\drawmark{circleheavycross}]

%D These symbols are drawn using MetaFun (no font dependency).
%D Use \type{\setupmarkstyle[handdrawn]} for hand-drawn style,
%D or  \type{\setupmarkstyle[formal]} for formal style (default).
%D
%D \starttabulate[|l|r|l|r|]
%D \NC \type{\symbol{marksquare}}           \NC \symbol{marksquare}
%D \VL \type{\symbol{markcircle}}           \NC \symbol{markcircle}          \NC\NR\HL
%D \NC \type{\symbol{markcheck}}            \NC \symbol{markcheck}
%D \VL \type{\symbol{markcross}}            \NC \symbol{markcross}           \NC\NR
%D \NC \type{\symbol{markheavycheck}}       \NC \symbol{markheavycheck}
%D \VL \type{\symbol{markheavycross}}       \NC \symbol{markheavycross}      \NC\NR
%D \NC \type{\symbol{marksquarecheck}}      \NC \symbol{marksquarecheck}
%D \VL \type{\symbol{marksquarecross}}      \NC \symbol{marksquarecross}     \NC\NR
%D \NC \type{\symbol{marksquareheavycheck}} \NC \symbol{marksquareheavycheck}
%D \VL \type{\symbol{marksquareheavycross}} \NC \symbol{marksquareheavycross}\NC\NR
%D \NC \type{\symbol{markcirclecheck}}      \NC \symbol{markcirclecheck}
%D \VL \type{\symbol{markcirclecross}}      \NC \symbol{markcirclecross}     \NC\NR
%D \NC \type{\symbol{markcircleheavycheck}} \NC \symbol{markcircleheavycheck}
%D \VL \type{\symbol{markcircleheavycross}} \NC \symbol{markcircleheavycross}\NC\NR
%D \NC \type{\symbol{marknotcheck}}         \NC \symbol{marknotcheck}
%D \VL                                      \NC                              \NC\NR
%D \stoptabulate

% 绘制圆圈
\startuseMPgraphic{mp:circle}
  numeric w;
  w := OverlayWidth ;  % 获取框架宽度
  draw fullcircle
    scaled .8w
    withpen pencircle scaled OverlayLineWidth
    withcolor OverlayLineColor ;
\stopuseMPgraphic

% 绘制叉号
\startuseMPgraphic{mp:cross}
  numeric w, h;
  w := OverlayWidth;
  h := OverlayHeight;
  path p;
  p := (-0.35w, -0.35h) -- (0.35w, 0.35h);
  draw p
    withpen pencircle scaled OverlayLineWidth
    withcolor OverlayLineColor;
  p := (-0.35w, 0.35h) -- (0.35w, -0.35h);
  draw p
    withpen pencircle scaled OverlayLineWidth
    withcolor OverlayLineColor;
\stopuseMPgraphic

% 绘制叉号
\startuseMPgraphic{mp:halfcross}
  numeric w, h;
  w := OverlayWidth;
  h := OverlayHeight;
  path p;
  p := (-0.35w, -0.35h) -- (0.35w, 0.35h);
  draw p
    withpen pencircle scaled OverlayLineWidth
    withcolor OverlayLineColor;
\stopuseMPgraphic

\defineoverlay[circle][\useMPgraphic{mp:circle}]
\defineoverlay[cross] [\useMPgraphic{mp:cross}]
\defineoverlay[halfcross] [\useMPgraphic{mp:halfcross}]

\defineframed[symcircle]
  [background=circle,
   frame=off,
   align=lohi,
   location=low,
   offset=0pt,
   width=fit,
   framecolor=red,
   rulethickness=1pt]

\defineframed[symcross][symcircle][background=cross]
\defineframed[symhalfcross][symcircle][background=halfcross]
%D \symcircle{circle}
%D \symcross{cross}
%D \symhalfcross{half cross}

\startMPdefinitions
  vardef norm_dash(expr width, penw)(suffix omode, oon, ooff) =
    if width = 0:
      omode := 0; oon := 0; ooff := 0;
    elseif width < 0:
      omode := 1; oon := penw * 0.3; ooff := penw * 2.5;
    else:
      omode := 2; oon := width; ooff := width;
    fi;
  enddef;
  vardef stroke_styled(expr p, mode, don, doff, penw, ps, c) =
    save po; pen po;
    if ps = 2: po := pensquare scaled penw; else: po := pencircle scaled penw; fi;
    if mode = 0:
      draw p withcolor c withpen po;
    else:
      draw p withcolor c dashed dashpattern(on don off doff) withpen po;
    fi;
  enddef;
  
  vardef addto_styled(suffix pic)(expr p, mode, don, doff, penw, ps, c) =
    save po; pen po;
    if ps = 2: po := pensquare scaled penw; else: po := pencircle scaled penw; fi;
    if mode = 0:
      addto pic doublepath p withcolor c withpen po;
    else:
      addto pic doublepath p withcolor c dashed dashpattern(on don off doff) withpen po;
    fi;
  enddef;
  vardef draw_decor(expr ox, oy, bW, bH, wL, outer_path,
                    helper_v, cross_v, has_seam, frame_enabled, pen_style,
                    hmode, hon, hoff, hpen, hcol,
                    cmode, con, coff, cpen, ccol,
                    fmode, fon, foff, fpen, fcol, spen) =
    save rec_p, rec_mode, rec_on, rec_off, rec_pen, rec_col, rec_clip, rec_z;
    save nrec, has_clip, pic_clip, i;
    path rec_p[];
    numeric rec_mode[], rec_on[], rec_off[], rec_pen[], rec_z[];
    color rec_col[];
    boolean rec_clip[];
    numeric nrec, i;
    boolean has_clip;
    picture pic_clip;
    nrec := 0;
    
    if helper_v:
      rec_p[nrec]    := (ox + bW/2, oy) -- (ox + bW/2, oy + bH);
      rec_mode[nrec] := hmode; rec_on[nrec] := hon; rec_off[nrec] := hoff;
      rec_pen[nrec]  := hpen;  rec_col[nrec] := hcol;
      rec_clip[nrec] := true;  rec_z[nrec] := 10;
      nrec := nrec + 1;
      rec_p[nrec]    := (ox, oy + bH/2) -- (ox + bW, oy + bH/2);
      rec_mode[nrec] := hmode; rec_on[nrec] := hon; rec_off[nrec] := hoff;
      rec_pen[nrec]  := hpen;  rec_col[nrec] := hcol;
      rec_clip[nrec] := true;  rec_z[nrec] := 10;
      nrec := nrec + 1;
    fi;
    
    if cross_v:
      rec_p[nrec]    := (ox, oy) -- (ox + bW, oy + bH);
      rec_mode[nrec] := cmode; rec_on[nrec] := con; rec_off[nrec] := coff;
      rec_pen[nrec]  := cpen;  rec_col[nrec] := ccol;
      rec_clip[nrec] := true;  rec_z[nrec] := 10;
      nrec := nrec + 1;
      rec_p[nrec]    := (ox, oy + bH) -- (ox + bW, oy);
      rec_mode[nrec] := cmode; rec_on[nrec] := con; rec_off[nrec] := coff;
      rec_pen[nrec]  := cpen;  rec_col[nrec] := ccol;
      rec_clip[nrec] := true;  rec_z[nrec] := 10;
      nrec := nrec + 1;
    fi;
    
    if has_seam:
      rec_p[nrec]    := (ox + wL, oy) -- (ox + wL, oy + bH);
      rec_mode[nrec] := fmode; rec_on[nrec] := fon; rec_off[nrec] := foff;
      rec_pen[nrec]  := spen;  rec_col[nrec] := fcol;
      rec_clip[nrec] := false; rec_z[nrec] := 20;
      nrec := nrec + 1;
    fi;
    
    if frame_enabled:
      rec_p[nrec]    := outer_path;
      rec_mode[nrec] := fmode; rec_on[nrec] := fon; rec_off[nrec] := foff;
      rec_pen[nrec]  := fpen;  rec_col[nrec] := fcol;
      rec_clip[nrec] := false; rec_z[nrec] := 30;
      nrec := nrec + 1;
    fi;
    
    has_clip := false;
    for i = 0 upto nrec - 1:
      if rec_clip[i]: has_clip := true; fi;
    endfor;
  
    for i = 0 upto nrec - 1:
      if not rec_clip[i]:
        stroke_styled(rec_p[i], rec_mode[i], rec_on[i], rec_off[i], rec_pen[i], pen_style, rec_col[i]);
      fi;
    endfor;
  
    if has_clip:
      pic_clip := nullpicture;
      for i = 0 upto nrec - 1:
        if rec_clip[i]: % 内部线（helper 和 cross）：强制使用 1 (circle)
          addto_styled(pic_clip, rec_p[i], rec_mode[i], rec_on[i], rec_off[i], rec_pen[i], 1, rec_col[i]);
        fi;
      endfor;
      clip pic_clip to outer_path;
      draw pic_clip;
    fi;
  enddef;
\stopMPdefinitions

\startuseMPgraphic{badgebg}
  save bW, bH, wL, rr, s_thick;
  save has_seam, frame_enabled, helper_v, cross_v, filltext_v, fillnum_v, seam_v;
  save c_textbg, c_numbg, c_frame, c_dash;
  save p_outer, pL, pR;
  save hmode, hon, hoff, cmode, con, coff, fmode, fon, foff;
  save hpen, hdash, cpen, cdash, fpen, fdash;
  save pen_style;
  
  numeric pen_style;
  numeric bW, bH, wL, rr, s_thick;
  numeric hmode, hon, hoff, cmode, con, coff, fmode, fon, foff;
  numeric hpen, hdash, cpen, cdash, fpen, fdash;
  boolean has_seam, frame_enabled, helper_v, cross_v, filltext_v, fillnum_v, seam_v;
  color c_textbg, c_numbg, c_frame, c_dash;
  path p_outer, pL, pR;
  
  bW := OverlayWidth;
  bH := OverlayHeight;
  pen_style := \namedframedparameter{badgeframed}{penstyle};
  wL := \namedframedparameter{badgeframed}{textwidth};
  s_thick := \namedframedparameter{badgeframed}{seam};
  rr := \namedframedparameter{badgeframed}{radius};
  thick := \namedframedparameter{badgeframed}{rulethickness};
  hpen := \namedframedparameter{badgeframed}{helperwidth};
  hdash := \namedframedparameter{badgeframed}{helperdashwidth};
  cpen := \namedframedparameter{badgeframed}{crosswidth};
  cdash := \namedframedparameter{badgeframed}{crossdashwidth};
  fpen := \namedframedparameter{badgeframed}{rulethickness};
  fdash := \namedframedparameter{badgeframed}{dashwidth};
  helper_v := (\namedframedparameter{badgeframed}{helper} > 0);
  cross_v := (\namedframedparameter{badgeframed}{cross} > 0);
  frame_enabled := (\namedframedparameter{badgeframed}{drawframe} > 0);
  filltext_v := (\namedframedparameter{badgeframed}{filltext} > 0);
  fillnum_v := (\namedframedparameter{badgeframed}{fillnum} > 0);
  c_textbg := \MPcolor{\namedframedparameter{badgeframed}{textbackground}};
  c_numbg := \MPcolor{\namedframedparameter{badgeframed}{numberbackground}};
  c_frame := \MPcolor{\namedframedparameter{badgeframed}{framecolor}};
  c_dash := \MPcolor{\namedframedparameter{badgeframed}{dashcolor}};
  if rr < 0.1pt:
    p_outer := (0,0) -- (bW,0) -- (bW,bH) -- (0,bH) -- cycle;
    if wL > 0.1pt:
      pL := (0,0) -- (wL,0) -- (wL,bH) -- (0,bH) -- cycle;
      pR := ((0,0) -- (bW-wL,0) -- (bW-wL,bH) -- (0,bH) -- cycle) shifted (wL,0);
    else:
      pR := p_outer;
    fi;
  else:
    p_outer := (0,rr) {down} .. {right} (rr,0) -- (bW-rr,0) {right}
               .. {up} (bW,rr) -- (bW,bH-rr) {up} .. {left} (bW-rr,bH)
               -- (rr,bH) {left} .. {down} (0,bH-rr) -- cycle;
    if wL > 0.1pt:
      pL := (0,rr) {down} .. {right} (rr,0) -- (wL,0) -- (wL,bH)
            -- (rr,bH) {left} .. {down} (0,bH-rr) -- cycle;
      pR := ((0,0) -- (bW-wL-rr,0) {right} .. {up} (bW-wL,rr)
             -- (bW-wL,bH-rr) {up} .. {left} (bW-wL-rr,bH)
             -- (0,bH) -- cycle) shifted (wL,0);
    else:
      pR := p_outer;
    fi;
  fi;
  seam_v := (wL > 0.1pt) and (s_thick > 0) and frame_enabled;
  has_seam := (wL > 0.1pt);
  if has_seam and filltext_v:
    fill pL withcolor c_textbg;
  fi;
  if fillnum_v:
    fill pR withcolor c_numbg;
  fi;
  norm_dash(hdash, hpen, hmode, hon, hoff);
  norm_dash(cdash, cpen, cmode, con, coff);
  norm_dash(fdash, fpen, fmode, fon, foff);
  draw_decor(0, 0, bW, bH, wL, p_outer,
             helper_v, cross_v, seam_v, frame_enabled, pen_style,
             hmode, hon, hoff, hpen, c_dash,
             cmode, con, coff, cpen, c_dash,
             fmode, fon, foff, fpen, c_frame, s_thick);
\stopuseMPgraphic

\defineoverlay[badgebg][\useMPgraphic{badgebg}]

\defineframed[badgeframed][
  penstyle=1,
  frame=off,
  offset=0pt,
  leftoffset=.5ex,
  rightoffset=.5ex,
  topoffset=0pt,
  bottomoffset=0pt,
  frameoffset=0pt,
  align={center,lohi},
  background=badgebg,
  strut=yes,
  text=,
  shape=rect,
  radius=2pt,
  framecolor=themecolor,
  dashcolor=themecolor,
  textwidth=0pt,
  textcolor=white,
  numbercolor=themecolor,
  textstyle=,
  numberstyle=,
  textbackground=themecolor,
  numberbackground=white,
  scale=0.6,
  helperwidth=0.4pt,
  helperdashwidth=0pt,
  crosswidth=0.4pt,
  crossdashwidth=0pt,
  rulethickness=1pt,
  dashwidth=0pt,
  xshift=0pt,
  yshift=\dimexpr\namedframedparameter{badgeframed}{scale}\strutdp\relax,
  cross=false,
  helper=false,
  seam=1pt,
  drawframe=0,
  filltext=0,
  fillnum=0,
]

\def\setupbadge{\setupframed[badgeframed]}

\newbox\badge_Lbox
\newbox\badge_Rbox
\newdimen\badge_wl
\newdimen\badge_bw
\newdimen\badge_bh
\newdimen\badge_rr

\tolerant\def\DrawBadge[#S#1]#:#2{%
  \begingroup
  \setupframed[badgeframed][#1]%
  \edef\badge_circle{circle}%
  \edef\badge_square{square}%
  \edef\badge_capsule{capsule}%
  \edef\badge_seam{\namedframedparameter{badgeframed}{seam}}%
  \edef\badge_shape{\namedframedparameter{badgeframed}{shape}}%
  \edef\badge_texttmp{\namedframedparameter{badgeframed}{text}}%
  \edef\badge_radius{\namedframedparameter{badgeframed}{radius}}%
  \edef\badge_loffset{\namedframedparameter{badgeframed}{leftoffset}}%
  \edef\badge_roffset{\namedframedparameter{badgeframed}{rightoffset}}%
  \edef\badge_toffset{\namedframedparameter{badgeframed}{topoffset}}%
  \edef\badge_boffset{\namedframedparameter{badgeframed}{bottomoffset}}%
  \edef\badge_foffset{\namedframedparameter{badgeframed}{frameoffset}}%
  \edef\badge_poffset{\namedframedparameter{badgeframed}{backgroundoffset}}%
  \edef\badge_rule{\namedframedparameter{badgeframed}{rulethickness}}%
  \scratchdimen\badge_rule 
  \scratchdimenone\badge_loffset   \scratchdimentwo\badge_roffset
  \scratchdimenthree\badge_poffset \scratchdimenfour\badge_foffset
  \scratchdimenone\dimexpr2\scratchdimen + 2\scratchdimenone + 2\scratchdimenthree\relax
  \scratchdimentwo\dimexpr2\scratchdimen + 2\scratchdimentwo + 2\scratchdimenthree\relax
  \setbox\badge_Lbox\hbox{\strut\vphantom{Mg国}\kern\scratchdimenone\useframedstyleandcolor{}{textstyle}\badge_texttmp}%
  \setbox\badge_Rbox\hbox{\strut\vphantom{Mg国}\kern\scratchdimentwo\useframedstyleandcolor{}{numberstyle}#2}%
  % bh = max(htL+dpL, htR+dpR)
  \scratchdimenone\badge_toffset   \scratchdimentwo\badge_boffset
  \scratchdimen\dimexpr2\scratchdimen +\scratchdimenone + \scratchdimentwo + \scratchdimenthree + \scratchdimenfour\relax
  \scratchdimenone\dimexpr\ht\badge_Lbox+\dp\badge_Lbox + \scratchdimen\relax
  \scratchdimentwo\dimexpr\ht\badge_Rbox+\dp\badge_Rbox + \scratchdimen\relax
  \ifdim\scratchdimentwo>\scratchdimenone\badge_bh\scratchdimentwo\else\badge_bh\scratchdimenone\fi
  \ifx\badge_texttmp\empty
    \def\badge_hasleft{0}\badge_wl=\zeropoint
    \badge_bw=\dimexpr\wd\badge_Rbox\relax
  \else
    \def\badge_hasleft{1}\badge_wl=\dimexpr\wd\badge_Lbox\relax
    \badge_bw=\dimexpr\badge_wl+\wd\badge_Rbox\relax
  \fi
  \def\badge_isosym{0}%
  \ifx\badge_shape\badge_circle \def\badge_isosym{1}\fi
  \ifx\badge_shape\badge_square \def\badge_isosym{1}\fi
  \ifnum\badge_isosym=1
    \ifdim\badge_bw<\badge_bh \badge_bw=\badge_bh \fi
    \badge_bh=\badge_bw
    \ifnum\badge_hasleft=1 \badge_wl=\dimexpr\badge_bw/2\relax \else \badge_wl=\zeropoint \fi
  \fi
  \ifx\badge_shape\badge_circle
    \badge_rr=\dimexpr\badge_bw/2\relax
  \else\ifx\badge_shape\badge_square
    \badge_rr=\dimexpr\badge_radius\relax
  \else\ifx\badge_shape\badge_capsule
    \ifdim\badge_bw<\badge_bh \badge_rr=\dimexpr\badge_bw/2\relax \else \badge_rr=\dimexpr\badge_bh/2\relax \fi
  \else
    \badge_rr=\dimexpr\badge_radius\relax
  \fi\fi\fi
  \ifdim\badge_rr>\dimexpr\badge_bh/2\relax \badge_rr=\dimexpr\badge_bh/2\relax \fi
  \ifdim\badge_rr>\dimexpr\badge_bw/2\relax \badge_rr=\dimexpr\badge_bw/2\relax \fi
  \ifdim\badge_rr<\zeropoint \badge_rr=\zeropoint \fi
  \doifelse{\namedframedparameter{badgeframed}{framecolor}}{transparent}%
    {\def\badge_drawframe{0}}{\def\badge_drawframe{1}}%
  \ifdim\dimexpr\namedframedparameter{badgeframed}{rulethickness}\relax<\zeropoint
    \def\badge_drawframe{0}%
  \fi
  \doifelse{\namedframedparameter{badgeframed}{penstyle}}{square}
    {\def\badge_pstyle{2}}{\def\badge_pstyle{1}}%
  \doifelse{\namedframedparameter{badgeframed}{textbackground}}{transparent}%
    {\def\badge_filltext{0}}{\def\badge_filltext{1}}%
  \doifelse{\namedframedparameter{badgeframed}{numberbackground}}{transparent}%
    {\def\badge_fillnum{0}}{\def\badge_fillnum{1}}%
  \doifelse{\namedframedparameter{badgeframed}{helper}}{true}%
    {\def\badge_helper{1}}{\def\badge_helper{0}}%
  \doifelse{\namedframedparameter{badgeframed}{cross}}{true}%
    {\def\badge_cross{1}}{\def\badge_cross{0}}%
  \setupframed[badgeframed][
    \c!width    =\the\dimexpr\badge_bw+\badge_seam\relax,
    \c!height   =\the\dimexpr.7\badge_bh\relax,
    \c!depth    =\the\dimexpr.3\badge_bh\relax,
    \c!textwidth=\the\badge_wl,
    \c!radius   =\the\badge_rr,
    drawframe=\badge_drawframe,
    filltext=\badge_filltext,
    fillnum=\badge_fillnum,
    helper=\badge_helper,
    cross=\badge_cross,
    penstyle=\badge_pstyle,
  ]%
  \dontleavehmode
  \scale[s=\namedframedparameter{badgeframed}{scale},]{%
    \kern\dimexpr\namedframedparameter{badgeframed}{xshift}\relax
    \raise\dimexpr\namedframedparameter{badgeframed}{yshift}\relax
    \vbox{\vfill
        \scratchdimen\dimexpr\badge_bw-\badge_wl\relax
        \badgeframed{\ifnum\badge_hasleft=1\strut
          \kern-\dimexpr\badge_rule/2\relax\hbox to \badge_wl{\hss\useframedstyleandcolor\c!textstyle\c!textcolor\badge_texttmp\hss}\fi
          \hbox to \scratchdimen{\hss\useframedstyleandcolor{numberstyle}{numbercolor}{\vphantom{Mg国}#2}\hss}%
          }
        \vfill}%
  }%
  \endgroup
}

% --- 转换接口 ---
\tolerant\def\circledconversion[#1]#:#2{\DrawBadge[shape=circle, radius=0pt, numberbackground=themecolor, numbercolor=white, framecolor=themecolor,#1]{#2}}
\tolerant\def\negativecircledconversion[#1]#:#2{\DrawBadge[shape=circle, radius=0pt, numberbackground=transparent, numbercolor=themecolor, framecolor=themecolor,#1]{#2}}
\tolerant\def\roundsquaredconversion[#1]#:#2{\DrawBadge[shape=square, radius=3pt, numberbackground=themecolor, numbercolor=white, framecolor=themecolor,#1]{#2}}
\tolerant\def\negativeroundsquaredconversion[#1]#:#2{\DrawBadge[shape=square, radius=3pt, numberbackground=transparent, numbercolor=themecolor, framecolor=themecolor,#1]{#2}}
\tolerant\def\squaredconversion[#1]#:#2{\DrawBadge[shape=square, radius=0pt, numberbackground=themecolor, numbercolor=white, framecolor=themecolor,#1]{#2}}
\tolerant\def\negativesquaredconversion[#1]#:#2{\DrawBadge[shape=square, radius=0pt, numberbackground=transparent, numbercolor=themecolor, framecolor=themecolor,#1]{#2}}

\let\circledtext\circledconversion
\let\autocircled\circledconversion

% --- Alph (大写字母) ---
\defcsname circlednum:Co:Alph\endcsname#1{\circledconversion             {\convertnumber{A}{#1}}}
\defcsname circlednum:CO:Alph\endcsname#1{\negativecircledconversion     {\convertnumber{A}{#1}}}
\defcsname circlednum:Cr:Alph\endcsname#1{\roundsquaredconversion        {\convertnumber{A}{#1}}}
\defcsname circlednum:CR:Alph\endcsname#1{\negativeroundsquaredconversion{\convertnumber{A}{#1}}}
\defcsname circlednum:Cs:Alph\endcsname#1{\squaredconversion             {\convertnumber{A}{#1}}}
\defcsname circlednum:CS:Alph\endcsname#1{\negativesquaredconversion     {\convertnumber{A}{#1}}}

% --- alph (小写字母) ---
\defcsname circlednum:Co:alph\endcsname#1{\circledconversion             {\convertnumber{a}{#1}}}
\defcsname circlednum:CO:alph\endcsname#1{\negativecircledconversion     {\convertnumber{a}{#1}}}
\defcsname circlednum:Cr:alph\endcsname#1{\roundsquaredconversion        {\convertnumber{a}{#1}}}
\defcsname circlednum:CR:alph\endcsname#1{\negativeroundsquaredconversion{\convertnumber{a}{#1}}}
\defcsname circlednum:Cs:alph\endcsname#1{\squaredconversion             {\convertnumber{a}{#1}}}
\defcsname circlednum:CS:alph\endcsname#1{\negativesquaredconversion     {\convertnumber{a}{#1}}}

% --- cn (中文数字) ---
\defcsname circlednum:Co:cn\endcsname#1{\circledconversion             {\chinesenumerals{#1}}}
\defcsname circlednum:CO:cn\endcsname#1{\negativecircledconversion     {\chinesenumerals{#1}}}
\defcsname circlednum:Cr:cn\endcsname#1{\roundsquaredconversion        {\chinesenumerals{#1}}}
\defcsname circlednum:CR:cn\endcsname#1{\negativeroundsquaredconversion{\chinesenumerals{#1}}}
\defcsname circlednum:Cs:cn\endcsname#1{\squaredconversion             {\chinesenumerals{#1}}}
\defcsname circlednum:CS:cn\endcsname#1{\negativesquaredconversion     {\chinesenumerals{#1}}}

% --- hira (平假名) ---
\defcsname circlednum:Co:hira\endcsname#1{\circledconversion             {\convertnumber{hiragana}{#1}}}
\defcsname circlednum:CO:hira\endcsname#1{\negativecircledconversion     {\convertnumber{hiragana}{#1}}}
\defcsname circlednum:Cr:hira\endcsname#1{\roundsquaredconversion        {\convertnumber{hiragana}{#1}}}
\defcsname circlednum:CR:hira\endcsname#1{\negativeroundsquaredconversion{\convertnumber{hiragana}{#1}}}
\defcsname circlednum:Cs:hira\endcsname#1{\squaredconversion             {\convertnumber{hiragana}{#1}}}
\defcsname circlednum:CS:hira\endcsname#1{\negativesquaredconversion     {\convertnumber{hiragana}{#1}}}

% --- kata (片假名) ---
\defcsname circlednum:Co:kata\endcsname#1{\circledconversion             {\convertnumber{katakana}{#1}}}
\defcsname circlednum:CO:kata\endcsname#1{\negativecircledconversion     {\convertnumber{katakana}{#1}}}
\defcsname circlednum:Cr:kata\endcsname#1{\roundsquaredconversion        {\convertnumber{katakana}{#1}}}
\defcsname circlednum:CR:kata\endcsname#1{\negativeroundsquaredconversion{\convertnumber{katakana}{#1}}}
\defcsname circlednum:Cs:kata\endcsname#1{\squaredconversion             {\convertnumber{katakana}{#1}}}
\defcsname circlednum:CS:kata\endcsname#1{\negativesquaredconversion     {\convertnumber{katakana}{#1}}}

\defineconversion[circlednum][\negativecircledconversion]

\defineconversion[Co:num][\circledconversion]
\defineconversion[CO:num][\negativecircledconversion]
\defineconversion[Cr:num][\roundsquaredconversion]
\defineconversion[CR:num][\negativeroundsquaredconversion]
\defineconversion[Cs:num][\squaredconversion]
\defineconversion[CS:num][\negativesquaredconversion]

\defineconversion[Co:Alph][\csname circlednum:Co:Alph\endcsname]
\defineconversion[CO:Alph][\csname circlednum:CO:Alph\endcsname]
\defineconversion[Cr:Alph][\csname circlednum:Cr:Alph\endcsname]
\defineconversion[CR:Alph][\csname circlednum:CR:Alph\endcsname]
\defineconversion[Cs:Alph][\csname circlednum:Cs:Alph\endcsname]
\defineconversion[CS:Alph][\csname circlednum:CS:Alph\endcsname]

\defineconversion[Co:alph][\csname circlednum:Co:alph\endcsname]
\defineconversion[CO:alph][\csname circlednum:CO:alph\endcsname]
\defineconversion[Cr:alph][\csname circlednum:Cr:alph\endcsname]
\defineconversion[CR:alph][\csname circlednum:CR:alph\endcsname]
\defineconversion[Cs:alph][\csname circlednum:Cs:alph\endcsname]
\defineconversion[CS:alph][\csname circlednum:CS:alph\endcsname]

\defineconversion[Co:cn][\csname circlednum:Co:cn\endcsname]
\defineconversion[CO:cn][\csname circlednum:CO:cn\endcsname]
\defineconversion[Cr:cn][\csname circlednum:Cr:cn\endcsname]
\defineconversion[CR:cn][\csname circlednum:CR:cn\endcsname]
\defineconversion[Cs:cn][\csname circlednum:Cs:cn\endcsname]
\defineconversion[CS:cn][\csname circlednum:CS:cn\endcsname]

\defineconversion[Co:hira][\csname circlednum:Co:hira\endcsname]
\defineconversion[CO:hira][\csname circlednum:CO:hira\endcsname]
\defineconversion[Cr:hira][\csname circlednum:Cr:hira\endcsname]
\defineconversion[CR:hira][\csname circlednum:CR:hira\endcsname]
\defineconversion[Cs:hira][\csname circlednum:Cs:hira\endcsname]
\defineconversion[CS:hira][\csname circlednum:CS:hira\endcsname]

\defineconversion[Co:kata][\csname circlednum:Co:kata\endcsname]
\defineconversion[CO:kata][\csname circlednum:CO:kata\endcsname]
\defineconversion[Cr:kata][\csname circlednum:Cr:kata\endcsname]
\defineconversion[CR:kata][\csname circlednum:CR:kata\endcsname]
\defineconversion[Cs:kata][\csname circlednum:Cs:kata\endcsname]
\defineconversion[CS:kata][\csname circlednum:CS:kata\endcsname]

\defcsname EgNum:I\endcsname#1{%
  \DrawBadge[text=Z, radius=1pt,
             textbackground=themecolor, textcolor=white, 
             numberbackground=white, numbercolor=themecolor, 
             framecolor=themecolor, rulethickness=0.5pt]{#1}%
}

\defcsname EgNum:II\endcsname#1{%
  \DrawBadge[text=Y, radius=1pt,
             textbackground=themecolor, textcolor=white, 
             numberbackground=white, numbercolor=themecolor, 
             framecolor=themecolor, rulethickness=0.5pt]{#1}%
}

\defcsname EgNum:III\endcsname#1{%
  \DrawBadge[text=X, radius=1pt, 
             textbackground=themecolor, textcolor=white, 
             numberbackground=white, numbercolor=themecolor, 
             framecolor=themecolor, rulethickness=0.5pt]{#1}%
}

\defineconversion [EgNumI]   [\csname EgNum:I  \endcsname]
\defineconversion [EgNumII]  [\csname EgNum:II \endcsname]
\defineconversion [EgNumIII] [\csname EgNum:III\endcsname]
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%D \section{Extra Command}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\defineregister [entryindex]
\defineregister [grammarindex]
\defineregister [functionindex]

\def\definelexicalinfocommand#1#2{%
  \defcsname #1\endcsname##1%
    {\dontleavehmode
     \thinspace\hbox{\DrawBadge[numberstyle=tfx,leftoffset=0pt,rightoffset=0pt]{#2} 
     \uselexicalentrystyleandcolor\c!inforstyle\c!inforcolor
     ##1}\thinspace\allowbreak}}

\installnamespace          {lexicalentry}
\installcommandhandler \????lexicalentry     {lexicalentry}     \????lexicalentry
\installcounterassociation {lexicalentry}

\newtoks\everylexicalentry

\appendtoks
   \synchronizelexicalentrycounters
\to \everysetuplexicalentry

\appendtoks
  \protected\frozen\instance\edefcsname\e!start\currentlexicalentry\endcsname{\startnamedlexicalentry[\currentlexicalentry]}%
  \protected\frozen\instance\letcsname \e!stop \currentlexicalentry\endcsname \stopnamedlexicalentry
  \registerlexicalentrycounter{\currentlexicalentry}%
  \definecounter[\currentlexicalentry]%
\to \everydefinelexicalentry

\appendtoks
  \definelexicalinfocommand{antonym} {\lexicalentryparameter{antonymlabel}}%
  \definelexicalinfocommand{synonym} {\lexicalentryparameter{synonymlabel}}%
  \definelexicalinfocommand{example} {\lexicalentryparameter{examplelabel}}%
  \definelexicalinfocommand{refer}   {\lexicalentryparameter{referlabel}}%
  \definelexicalinfocommand{junction}{\lexicalentryparameter{junctionlabel}}%
  \resetcounter[lexicalgrammar]%
  \resetcounter[lexicaljunction]%
  \resetcounter[lexicalmeaning]%
  \resetcounter[lexicalsummary]%
  \resetcounter[lexicalexample]%
  \resetcounter[lexicalcomparing]%
  \def\hantext#1{{\language[hans]\hwx\kern -.5em ｜ #1}}%
  \def\lexicalemph#1{{\ss\underbar{#1}}}%
\to \everylexicalentry

\setuplexicalentry[
  \c!style=\definedfont[Serif],
  \c!after=\blank[halfline],
  \c!prefix=no,
  \c!start=0,
  \c!numberconversion=cn,
  \c!way=\v!by\v!chapter,
  \c!numberstopper=、,
  \c!textstyle=ssa,
  \c!textcolor=blue,
  \c!inforstyle=ssx,
  antonymlabel=対,
  examplelabel=例,
  referlabel=参考,
  junctionlabel=接続,
  alias=〜,
  entrycommand=,]

\tolerant\protected\def\startnamedlexicalentry[#1]#*[#2]#*#:#3%
 {\begingroup
    \cdef\currentlexicalentry{#1}%
    \ifhastok={#2}\setuplexicalentry[#2]\fi
    \the\everylexicalentry
    \def\alias      {\lexicalentryparameter{alias}}%
    \edef\p_accent  {\lexicalentryparameter{accent}}%
    \edef\p_class   {\lexicalentryparameter{class}}%
    \edef\p_number  {\lexicalentryparameter{number}}%
    \ifempty\p_accent\else
      \edef\p_accent  {\lexicalentryparameter{accent}}\fi
    \ifempty\p_class\else
      \edef\p_class   {\lexicalentryparameter{class}}\fi
    \ifempty\p_number\else
      \edef\p_number  {\lexicalentryparameter{number}}\fi
    \edef\p_indexcmd{\lexicalentryparameter{indexcommand}}%
    \edef\p_indexcls{\lexicalentryparameter{indexclass}}%
    \edef\p_indexCLS{grammar}%
    \setupindenting[\lexicalentryparameter\c!indenting]%
    \lexicalentryparameter\c!before
    \uselexicalentrystyleandcolor\c!style\c!color
    \bgroup
      \uselexicalentrystyleandcolor\c!textstyle\c!textcolor
      \ifchknumber\lexicalentryparameter\c!number\or
        \setupcounter[\currentlexicalentry][number=\lexicalentryparameter\c!number]%
        \convertedcounter[\currentlexicalentry]%
        \incrementcounter[\currentlexicalentry]%
      \else
        \doiftrue{lexicalentry}{number}{%
          \incrementcounter[\currentlexicalentry]%
          \convertedcounter[\currentlexicalentry]}%
      \fi
      \lexicalentryparameter{entrycommand}{#3}%
    \egroup\penalty0
    \ifx\p_indexcmd\empty
      \ifx\p_indexcls\p_indexCLS
        \grammarindex{#3}%
        \functionindex{\lexicalentryparameter{function}+#3}%
      \else\entryindex{#3}\fi
    \else\lexicalentryparameter{indexcommand}{#3}\fi
    \textreference[#3]{#3}\dontleavehmode
    \ifhastok={#2}\bgroup
      \processcommacommand[\p_class]{\penalty0\thinspace\DrawBadge[radius=2pt]}%
      \processcommacommand[\p_accent]{\penalty0\thinspace\DrawBadge[radius=2pt]}\egroup
    \else\bgroup
      \def\temp_frame##1{\DrawBadge[radius=2pt]{##1}}%
      \processcommacommand[#2]{\penalty0\thinspace\temp_frame}\egroup
    \fi
    \lexicalentryparameter\c!inbetween}

\def\stopnamedlexicalentry{%
  \lexicalentryparameter\c!after
  \endgroup}

\definelexicalentry[lexicalentry]  [state=stop,indenting=none]
\definelexicalentry[lexicalsyntax] [indexclass=grammar,indenting=none]

\defineitemgroup  [lexicallists]  [levels=4]
\setupitemgroup   [lexicallists]  [each] [before=,after=,left=,right=,width=1.5em,
                                          lefttext=,righttext=,
                                          indenting=no,stopper=,symalign=center,]
\setupitemgroup   [lexicallists]  [1]    [Cr:kata,,packed,joinedup]
\setupitemgroup   [lexicallists]  [2]    [CR:num, ,packed,joinedup]
\setupitemgroup   [lexicallists]  [3]    [Co:num, ,packed,joinedup]
\setupitemgroup   [lexicallists]  [4]    [R,      ,packed,joinedup][stopper=.]

\defineenumeration[lexicalenumeration]
\setupenumeration [lexicalenumeration][
  distance=.5em,
  numbercommand=\DrawBadge[radius=2pt],
  width=fit,hang=broad,
  alternative=hanging,
  indenting=none,
  before=\par,inbetween=,after=\par,]

\defineenumeration[lexicalgrammar]   [lexicalenumeration] [text={文法},  counter=grammarlists]
\defineenumeration[lexicalmeaning]   [lexicalenumeration] [text={意味},  counter=lexicalmeaning]
\defineenumeration[lexicaljunction]  [lexicalenumeration] [text={接続},  counter=lexicaljunction]
\defineenumeration[lexicalexample]   [lexicalenumeration] [text={例文},  counter=lexicalexample]
\defineenumeration[lexicalcomparing] [lexicalenumeration] [text={対比},  counter=lexicalcomparing]
\defineenumeration[lexicalsummary]   [lexicalenumeration] [text={まとめ},counter=lexicalsummary]

