\startmodule[basicexam]
\unprotect

\setupmodule[mode=student,layout=default,footer=none]

\tolerant\def\setupbasicexam[#1]%
 {\scratchtoks\expandafter{#1}%
  \expanded{\getparameters[\??module basicexam:][\the\scratchtoks]}%
  \processallactionsinset[\moduleparameter{basicexam}{showanswer}][
           yes=>\mode_showanswertrue,
          true=>\mode_showanswertrue,
            no=>\mode_showanswerfalse,
         false=>\mode_showanswerfalse,
    \v!default=>\mode_showanswerfalse,
    \v!unknown=>\showmessage\m!basicexam{1}{showanswer},
  ]
  \processallactionsinset[\moduleparameter{basicexam}{showpoint}][
           yes=>\mode_showpointtrue,
          true=>\mode_showpointtrue,
            no=>\mode_showpointfalse,
         false=>\mode_showpointfalse,
    \v!default=>\mode_showpointtrue,
    \v!unknown=>\showmessage\m!basicexam{1}{showpoint},
  ]
  \processallactionsinset[\moduleparameter{basicexam}{showscript}][
           yes=>\mode_showscripttrue,
          true=>\mode_showscripttrue,
            no=>\mode_showscriptfalse,
         false=>\mode_showscriptfalse,
    \v!default=>\mode_showscriptfalse,
    \v!unknown=>\showmessage\m!basicexam{1}{showscript},
  ]
  \processallactionsinset[\moduleparameter{basicexam}{mode}][
       teacher=>{\enablemode[teacher]},
       student=>{\enablemode[student]},
         check=>{\enablemode[check]},
    \v!default=>{\enablemode[student]},
    \v!unknown=>\showmessage\m!basicexam{1}{mode},
  ]
  \processallactionsinset[\moduleparameter{basicexam}{layout}][
         twoup=>\lay_twouptrue,
          none=>\relax,
    \v!default=>\relax,
    \v!unknown=>\showmessage\m!basicexam{1}{layout},
  ]
  \processallactionsinset[\moduleparameter{basicexam}{footer}][
          none=>\relax,
    \v!default=>\hdr_defaulttrue,
    \v!unknown=>\showmessage\m!basicexam{1}{footer},
  ]
 }

