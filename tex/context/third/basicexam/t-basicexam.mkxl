\protected\def\doiftrue#1#2{%
  \edef\p_doiftrue_tmp{\csname #1parameter\endcsname{#2}}%
  \ifx\p_doiftrue_tmp\s!true
    \let\next\firstofoneargument
  \else
    \ifx\p_doiftrue_tmp\v!yes
      \let\next\firstofoneargument
    \else
      \let\next\gobbleoneargument
    \fi
  \fi\next}

\protected\def\doiftrueelse#1#2{%
  \edef\p_doiftrueelse_tmp{\csname #1parameter\endcsname{#2}}%
  \ifx\p_doiftrueelse_tmp\s!true
    \let\next\firstoftwoarguments
  \else
    \ifx\p_doiftrueelse_tmp\v!yes
      \let\next\firstoftwoarguments
    \else
      \let\next\secondoftwoarguments
    \fi
  \fi\next}

