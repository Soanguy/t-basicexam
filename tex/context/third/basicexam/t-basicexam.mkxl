%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%D \section{Unlimited Level Support}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\registerctxluafile{t-exam}{}

\def\initcollectanswer{\ctxlua{thirddata.basicexam.MultiAnswerCollector = {}}}
\def\collectanswer#1{\ctxlua{table.insert(thirddata.basicexam.MultiAnswerCollector,[[#1]])}}
\def\collectedanswer{\ctxlua{thirddata.basicexam.collect_answer_joined()}}

\def\UnlimitedSetExamMeta#1#2{%
  \edef\p_ns{#1}%
  \ctxlua{thirddata.basicexam.set_extra_data_list([==[\p_ns]==], [==[#2]==])}}

\def\UnlimitedSavedCurrentPoint{\UnlimitedGetExtraData{\SavedCurrentID}{point}}%
\def\UnlimitedSavedCurrentAnswer{\UnlimitedGetExtraData{\SavedCurrentID}{answer}}%

\def\BasicExamPushLevel#parent#current{%
  \edef\currentparentenvironment{#parent}%
  \edef\currentchildenvironment{#current}%
  \UnlimitedPushLevel{#current}%
  \UnlimitedSaveCurrentID\SavedCurrentID
  \initcollectanswer
  \initshowexaminfor[#parent]%
  % choice 不再走 push/pop，这里始终是 question/examitem/close 之一
  \ifx\currentparentenvironment\s!close
    \hbox{\hsize\scratchdimen\noindent\strut
    \showexaminfor[#parent][point]%
    \showexaminfor[#parent][answer]
    \showexaminfor[#parent][infor]%
    }%
  \else
    \showexaminfor[#parent][point]%
    \showexaminfor[#parent][answer]%
    \showexaminfor[#parent][infor]%
  \fi
  \UnlimitedAddScoredAnswer{\currentanswer}{\currentpoint}%
  \UnlimitedSetExamMeta{#parent}{tag,year,difficulty,uid}%
  \doiftrue{#parent}{resetfillin}{\c_fillinnumber\zerocount}%
}

\def\BasicExamPopLevel{\UnlimitedPopLevelChecked\currentchildenvironment}

\appendtoks
  \ctxlua{thirddata.basicexam.finalize_check()}
\to \everystoptext
