%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%D \module
%D   [     file=t-memos,
%D      version=2024-1-1,
%D        title=Memos,
%D     subtitle=Memoir Ever,
%D       author=商无辛(Shueng Mosan),
%D         date=2024-1-1,
%D    copyright=商无辛(Shueng Mosan),
%D      license=,
%D          url=]
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\startmodule[memos]
\unprotect
\def\userlanguageparameter#1#2{\ifcsname mm@lang_\currentmainlanguage setup_#1\endcsname\lastnamedcs\else#2\fi}

\def\s!memos{memos:}

\setupmodule [
        % 这些参数无须预先设置， 他们都被设置在 对应的语言中。
        % 目前只设置了 中 日 两种。英语无须设置， 默认即可
        %    fallbackfont=,        bodyfont=,
        %    fallbackfont=,          script=,
        %  interlinespace=,      whitespace=,
        %           align=,       indenting=,
              papersize=A4,             layout=moderate,    doublesided=no,
           mainlanguage=hans,         language=,
        % 这些参数无须设置，他们都已经预设好了默认值
                   mode=,           themecolor=,
               hdrstyle=,             tocstyle=,           chapterstyle=,
        % 这些参数只在 hermes 布局中才会生效
                  ratio=1.414,       textcount=40,          heightcount=40,                
            margincount=0, margindistancecount=1,
        % 这些参数只在回退字体中生效， 用于设置回退字体的缩放比例
            serifrscale=1,         handwrscale=1,
             sansrscale=1,          monorscale=1,  
        % 这些参数是用于设置标点         
                pattern=kaiming,     spacequad=0.5, 
               hangjian=no,              debug=no]

% \setupmetadata [
%   \c!title=,   \c!subtitle=,
%  \c!author=,    \c!keyword=,
%    \c!date=,]

\def\mm@serifrscale{\moduleparameter{memos}{serifrscale}}
\def\mm@handwrscale{\moduleparameter{memos}{handwrscale}}
\def\mm@sansrscale {\moduleparameter{memos}{sansrscale}}
\def\mm@monorscale {\moduleparameter{memos}{monorscale}}
\def\mm@errorparameter#1{%
    \writestatus{module error}{!! Something Wrong happened at #1}
    \writestatus{module error}{!! #1 is \moduleparameter{memos}{#1}}
    \writestatus{module error}{!! if the value is valid,please ignore the message.}}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\definemode [mm@mode:kindle]    [keep]
\definemode [mm@mode:draft]     [keep]
\definemode [mm@mode:print]     [keep]
\definemode [mm@extra:zhnumber] [keep]
\definemode [mm@extra:pinyin]   [keep]
\definemode [mm@extra:index]    [keep]
\definemode [mm@extra:bihua]    [keep]
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% h / f + ltext / ctext / rtext / oemargin
\newif\ifmm@header_book         \mm@header_bookfalse
\newif\ifmm@header_novel        \mm@header_novelfalse
\newif\ifmm@header_colorful     \mm@header_colorfulfalse
\newif\ifmm@header_madsen       \mm@header_madsenfalse
\newif\ifmm@header_rocket       \mm@header_rocketfalse
\newif\ifmm@header_hctext       \mm@header_hctextfalse
\newif\ifmm@header_fctext       \mm@header_fctextfalse
\newif\ifmm@header_foemargin    \mm@header_foemarginfalse
\newif\ifmm@header_foemarginalt \mm@header_foemarginaltfalse
\newif\ifmm@header_hoemargin    \mm@header_hoemarginfalse
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\processaction[\currentmoduleparameter{hdrstyle}]%
   [       book=>\mm@header_booktrue,
          novel=>\mm@header_noveltrue,
           line=>\mm@header_booktrue,
       colorful=>\mm@header_colorfultrue,
         madsen=>\mm@header_madsentrue,
        kaolike=>\mm@header_hoemargintrue,
         rocket=>\mm@header_rockettrue,
         hctext=>\mm@header_hctexttrue,
         fctext=>\mm@header_fctexttrue,
      foemargin=>\mm@header_foemargintrue,
   foemarginalt=>\mm@header_foemarginalttrue,
      hoemargin=>\mm@header_hoemargintrue,
           none=>\relax,
     \v!default=>\mm@header_fctexttrue,
     \v!unknown=>\mm@errorparameter{hdrstyle},]
     
\processaction[\currentmoduleparameter{doublesided}]%
   [        yes=>{\setuppagenumbering[alternative=doublesided,]},% \ifdoublesided
             no=>\relax,
     \v!default=>\relax,
     \v!unknown=>\mm@errorparameter{doublesided},]

\processallactionsinset[\currentmoduleparameter{mode}][
         print=>{\enablemode[mm@mode:print]},
        kindle=>{\enablemode[mm@mode:kindle]},
         draft=>{\enablemode[mm@mode:draft]},
    \v!default=>\relax,
    \v!unknown=>\mm@errorparameter{mode},
]

\processallactionsinset[\currentmoduleparameter{extra}][
        pinyin=>{\enablemode[mm@extra:pinyin]},
      zhnumber=>{\enablemode[mm@extra:zhnumber]},
         index=>{\enablemode[mm@extra:index]},
         bihua=>{\enablemode[mm@extra:bihua]},
           all=>{\enablemode[mm@extra:pinyin,mm@extra:zhnumber,mm@extra:index,mm@extra:bihua]},
          none=>\relax,
    \v!default=>\relax,
    \v!unknown=>\errorparameter{extra},
]
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%D 特別的，draft 模式下會開啟字符缺失檢查。但可能會導致未知錯誤，包括目錄、引用等無法生成
%D \type{\enabledirectives[logs.errors=missing characters]}
%D 命令檢查字符是否缺失，如果有則停止繼續打印。
%D 需要注意的是，開啟 draft 模式會拖慢生成文件的速度。
\startmode[mm@mode:draft]
  \overfullrule=10pt%
  \version[temporary]
  \enabletrackers[builders.hpack.quality]
  \enabletrackers[builders.hpack.overflow]
  \enabletrackers[fonts.missing]
  \replacemissingcharacters
  \showjustification
\stopmode

\startmode[mm@mode:kindle]
  \setupmodule   [fontsize=14pt,papersize=kindle,layout=kindle]
\stopmode

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\disabledirectives[system.reportfiles]
\input m-1-localization.mklx%加载字体和本地化设置，会额外增加 0.2s
\input m-2-design.mklx      %加载布局和颜色等设置 |加载此设置及以下设置，大概额外增加 0.06~0.09s
\input m-3-structure.mklx   %加载标题和目录等设置 |测试最简单的情况，大概需要 0.62~0.70s 左右
\input m-4-framed.mklx      %加载自定义块环境设置 |但不加载中文字体，大概需要 0.42-0.48s 左右
\input m-4-dualbody.mklx
\input m-5-textblock.mklx   %加载文本和浮动等设置 |最多的负担在中文字体以及处理中英文间距
\input m-6-macros.mklx      %加载奇奇怪怪宏等定义 |大量的定义并不额外产生消耗
\input m-7-extra.mklx       %加载注音数字笔画索引 |注意，除 xruby 和 zhnumber 命令外开启本身会产生一定量的消耗
% 注意，消耗有一些是固定支出（固定字体加载），有一些是随文本数量增加而逐渐增加的支出（大部分lua代码）
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% \processaction 执行顺序，需要先定义这些参数
\processaction[\currentmoduleparameter{themecolor}]%
   [       red=>{\setuppalet[passion]},
          blue=>{\setuppalet[serene]},
        yellow=>{\setuppalet[optimism]},
         green=>{\setuppalet[harmony]},
         black=>{\setuppalet[formality]},
         white=>{\setuppalet[innocence]},
          cyan=>{\setuppalet[creativity]},
        orange=>{\setuppalet[adventure]},
        purple=>{\setuppalet[magic]},
          pink=>{\setuppalet[romance]},
          gray=>{\setuppalet[reliable]},
          none=>\relax,
    \v!default=>{\setuppalet[creativity]},
    \v!unknown=>\mm@errorparameter{themecolor},]

\processaction[\currentmoduleparameter{chapterstyle}]%
   [      line=>\setups{mm@chap:line},
      colorful=>\setups{mm@chap:colorful},
        madsen=>\setups{mm@chap:madsen},
        rocket=>\setups{mm@chap:rocket},
          hexa=>\setups{mm@chap:hexa},
        simple=>\setups{mm@chap:simple},
      classics=>\setups{mm@chap:classics},
  classicnovel=>\setups{mm@chap:classicnovel},
       kaolike=>\setups{mm@chap:kaolike},
       article=>\setups{mm@chap:article},
       publish=>\setups{mm@chap:publish},
         ugent=>\setups{mm@chap:ugent},
          grid=>\setups{mm@chap:grid},
    brotherton=>\setups{mm@chap:brotherton},
          dash=>\setups{mm@chap:dash},
     crosshead=>\setups{mm@chap:crosshead},
      verville=>\setups{mm@chap:verville},
      thatcher=>\setups{mm@chap:thatcher},
       bianchi=>\setups{mm@chap:bianchi},
      pedersen=>\setups{mm@chap:pedersen},
          VZ43=>\setups{mm@chap:VZ43},
          none=>\relax,
    \v!default=>\setups{mm@chap:default},
    \v!unknown=>\mm@errorparameter{chapterstyle},]

\processaction[\currentmoduleparameter{tocstyle}][
          line=>\setups{mm@toc:line},
      colorful=>\setups{mm@toc:colorful},
        madsen=>\setups{mm@toc:madsen},
        rocket=>\setups{mm@toc:rocket},
          hexa=>\setups{mm@toc:hexa},
        simple=>\setups{mm@toc:simple},
      classics=>\setups{mm@toc:classics},
  classicnovel=>\setups{mm@toc:classicnovel},
       kaolike=>\setups{mm@toc:kaolike},
          none=>\relax,
    \v!default=>\setups{mm@toc:default},
    \v!unknown=>\mm@errorparameter{tocstyle},]

\protect
\stopmodule
\enabledirectives[system.reportfiles]
\endinput