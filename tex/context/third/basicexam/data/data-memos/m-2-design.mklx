                  width=30*\bodyfontsize, 
                  height=fit,
               backspace=\dimexpr (1\paperwidth-45\bodyfontsize)/2\relax,            
               rightedge=\dimexpr (1\paperwidth-45\bodyfontsize)/2\relax,   
             rightmargin=15*\bodyfontsize, 
              rightedgedistance=0mm,
                topspace=0mm,  rightmargindistance=5mm,
                  header=22mm,      headerdistance=5mm,
                  footer=22mm,      footerdistance=5mm,
                  bottom=0mm,       bottomdistance=0mm]
