%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\installnamespace          {cover}
\installcommandhandler \????cover  {cover}  \????cover

\tolerant\def\tophrule[#1][#2]{\bgroup
    \scratchdimen\dimexpr#1\relax
    \ifparameter#2\or\scratchdimenone\dimexpr#2\relax\else\scratchdimenone\dimexpr2pt\relax\fi
    \offinterlineskip
    \vskip 1pt
    \centerline{\hbox{\vrule height  2pt depth .2pt width \scratchdimen}}%
    \vskip 2pt
    \centerline{\hbox{\vrule height .2pt depth .2pt width \scratchdimen}}%
    \vskip \scratchdimenone\egroup}
\tolerant\def\bottomhrule[#1][#2]{\bgroup
    \scratchdimen\dimexpr#1\relax
    \ifparameter#2\or\scratchdimenone\dimexpr#2\relax\else\scratchdimenone\dimexpr2pt\relax\fi
    \offinterlineskip
    \vskip \scratchdimenone
    \centerline{\hbox{\vrule height .2pt depth .2pt width \scratchdimen}}%
    \vskip 2pt
    \centerline{\hbox{\vrule height  2pt depth .2pt width \scratchdimen}}%
    \vskip \scratchdimenone\egroup}

\startuseMPgraphic{mm@DoubleFrameGraphic}
    numeric inner_offset;
    inner_offset := 8pt;

    path outer_frame;
    outer_frame := (0, 0) -- (OverlayWidth, 0) -- (OverlayWidth, OverlayHeight) -- (0, OverlayHeight) -- cycle;
    draw outer_frame withpen pencircle scaled 1pt withcolor black;

    path inner_frame;
    inner_frame := (inner_offset, inner_offset) -- (OverlayWidth - inner_offset, inner_offset) -- (OverlayWidth - inner_offset, OverlayHeight - inner_offset) -- (inner_offset, OverlayHeight - inner_offset) -- cycle;
    draw inner_frame withpen pencircle scaled 0.6pt withcolor black;
\stopuseMPgraphic

\defineoverlay[mm@DoubleFrameBackground][\useMPgraphic{mm@DoubleFrameGraphic}]

\defineframedtext[DoubleFramedText][
    frame=off,
    background=mm@DoubleFrameBackground,
    offset=overlay,
    width=broad,
    height=1th]

\startuniqueMPgraphic{mm@flyleaf}
  numeric width, height, WhiteWidth, memosCoverWidth, memosCoverHeight;
  WhiteWidth  := LeftEdgeWidth + LeftEdgeDistance + LeftMarginWidth + LeftMarginDistance;
  memosCoverWidth  := WhiteWidth + TextWidth;
  memosCoverHeight := TextHeight + HeaderDistance + FooterDistance;
  width  = PaperWidth + WhiteWidth;
  height = \overlayheight;

  fill fullsquare xscaled width yscaled height
    withcolor \MPcolor{softthemecolor};

  fill fullsquare xscaled memosCoverWidth yscaled memosCoverHeight
    shifted (-.25WhiteWidth, 0) cornered .5cm
    withcolor white;
\stopuniqueMPgraphic

\startuniqueMPgraphic{mm@default:1}
  numeric topwidth, topheight, botwidth, botheight;
  topwidth  = PaperWidth;
  topheight = .35 * \overlayheight;
  botwidth  = PaperWidth;
  botheight = .65 * \overlayheight;

  fill fullsquare xscaled topwidth yscaled topheight
    shifted(0, .35 * \overlayheight)
    withcolor \MPcolor{softthemecolor};

  fill fullsquare xscaled botwidth yscaled botheight
    shifted(0, -.15 * \overlayheight)
    withcolor \MPcolor{lightthemecolor};
\stopuniqueMPgraphic

\startuniqueMPgraphic{mm@cover:2}
  numeric w, h, r, cx, cy, split_y;
  w=\overlaywidth;  h=\overlayheight;
  split_y=0.4*h; r=0.125*h;
  cx=0.75*w;     cy=split_y;

  path top_area,green_shape;
  top_area   :=(-10pt,split_y)--(w+10pt,split_y)--(w+10pt,h+10pt)--(-10pt,h+10pt)--cycle;
  green_shape:=(-10pt,-0.15*h)--(-10pt,split_y)--(cx-r,split_y)..(cx,cy-r)..(cx+r,split_y)--(w+10pt,split_y)--(w+10pt,-0.15*h)--cycle;
  fill top_area withcolor white withtransparency(1,0.05);

  for i=1 upto 12:
    fill green_shape shifted(i*1pt, -i*1pt) withcolor \MPcolor{themecolor} withtransparency(1,0.05);
  endfor;

  fill green_shape withcolor \MPcolor{themecolor} withtransparency(1,0.05);
\stopuniqueMPgraphic

\startuniqueMPgraphic{mm@golden_circle}
  numeric phi, max_r, steps, golden_angle;
  phi          := (1 + sqrt(5)) / 2;    % 黄金比例 ≈ 1.618
  steps        := 20;                   % 增加层数，让光斑更细腻
  golden_angle := 360 / (phi * phi);    % 黄金角 ≈ 137.508°
  max_r := 0.9 * \overlayheight;
  pair p_center;
  p_center := (1.05 * \overlaywidth, -0.05 * \overlayheight);

  for i = 1 upto steps:
    numeric r_i, angle_i, dist_i;
    pair pos;
    r_i := max_r * (0.88 ** i);
    angle_i := i * golden_angle;
    dist_i := max_r * 0.7 * (i / steps);
    pos := p_center shifted (dist_i * dir(angle_i));

    fill fullcircle scaled (2 * r_i) shifted pos
      withshademethod "circular"
      withshadecenter (.6, .6) % 光源偏右上，迎合纸张的整体光照
      withcolor white shadedinto \MPcolor{darkthemecolor}
      withtransparency (1, 0.8); % 极轻的透明度，绝不抢文字的风头
  endfor;
\stopuniqueMPgraphic

\startuniqueMPgraphic{mm@ORLY}
  fill fullsquare xscaled \overlaywidth yscaled \overlayheight
    withcolor \MPcolor{palethemecolor};
\stopuniqueMPgraphic

