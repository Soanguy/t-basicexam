\definelayout[graaf][
         backspace=\dimexpr 1\paperwidth/9\relax,
        leftmargin=\dimexpr 3\paperwidth/36\relax,
leftmargindistance=\dimexpr 1\paperwidth/36\relax,,
          cutspace=\dimexpr 2\paperwidth/9\relax,
             width=\dimexpr 1\paperwidth -\layoutparameter\c!backspace -\layoutparameter\c!cutspace\relax,
          topspace=0mm,bottomspace=0mm,headerdistance=0mm,footerdistance=0mm,
            header=\dimexpr 1\paperheight/9 -\layoutparameter\c!topspace    -\layoutparameter\c!headerdistance\relax,   % 页眉顶部定位在 H/9
            height=\dimexpr 1\paperheight   -\layoutparameter\c!topspace    -\layoutparameter\c!bottomspace\relax,
            footer=\dimexpr 2\paperheight/9 -\layoutparameter\c!bottomspace -\layoutparameter\c!footerdistance\relax,   % 页脚底部定位在 7H/9
]

\definelayout[optvdh][
         vdhnumber=6,
         rightedge=0mm,rightedgedistance=5mm,rightmargindistance=5mm,leftmargindistance=5mm,
          topspace=5mm,bottomspace=5mm,headerdistance=5mm,footerdistance=5mm,
         backspace=\dimexpr 1\paperwidth/(\layoutparameter{vdhnumber} + 3)\relax,
        leftmargin=\dimexpr 1\paperwidth/(\layoutparameter{vdhnumber} + 3)-5mm\relax,
       rightmargin=\dimexpr 2\paperwidth/(\layoutparameter{vdhnumber} + 3)-10mm\relax,
          cutspace=\dimexpr 2\paperwidth/(\layoutparameter{vdhnumber} + 3)\relax,
         v   width=\dimexpr 1\paperwidth -\layoutparameter\c!backspace -\layoutparameter\c!cutspace\relax,
            header=\dimexpr 3\paperwidth/(\layoutparameter{vdhnumber} + 3)/2 -\layoutparameter\c!topspace    -\layoutparameter\c!headerdistance\relax,
            height=\dimexpr 1\paperheight                   -\layoutparameter\c!topspace    -\layoutparameter\c!bottomspace\relax,
            footer=\dimexpr 3\paperwidth/(\layoutparameter{vdhnumber} + 3)   -\layoutparameter\c!bottomspace -\layoutparameter\c!footerdistance\relax,
]

\definelayout[vdh][
  vdhnumber=6,
       rightedge=0mm,rightedgedistance=5mm,rightmargindistance=5mm,leftmargindistance=5mm,
        topspace=5mm,bottomspace=5mm,headerdistance=5mm,footerdistance=5mm,
       backspace=\dimexpr 1\paperwidth/(\layoutparameter{vdhnumber} + 3)\relax,
        cutspace=\dimexpr 2\paperwidth/(\layoutparameter{vdhnumber} + 3)\relax,
      leftmargin=\dimexpr 1\paperwidth/(\layoutparameter{vdhnumber} + 3)-5mm\relax,
     rightmargin=\dimexpr 2\paperwidth/(\layoutparameter{vdhnumber} + 3)-10mm\relax,
           width=\dimexpr 1\paperwidth -\layoutparameter\c!backspace -\layoutparameter\c!cutspace\relax,
          header=\dimexpr 1\paperheight/(\layoutparameter{vdhnumber} + 3) -\layoutparameter\c!topspace    -\layoutparameter\c!headerdistance\relax,
          height=\dimexpr 1\paperheight                  -\layoutparameter\c!topspace    -\layoutparameter\c!bottomspace\relax,
          footer=\dimexpr 2\paperheight/(\layoutparameter{vdhnumber} + 3) -\layoutparameter\c!bottomspace -\layoutparameter\c!footerdistance\relax,
]

\setuppapersize  [\moduleparameter{memos}{papersize}]
%% 因为 hermes 需要页面大小， 所以必须先设置页面尺寸。
%% must load font first,then can get real text fontsize(1em)

% 只關心每行寬度每列高度和邊注寬度。其他的依照 1:√2 的比例切割（只是粗略）
\newcount\c_textcount     \c_textcount   =\moduleparameter{memos}{textcount}\relax
\newcount\c_heightcount   \c_heightcount =\moduleparameter{memos}{heightcount}\relax
\newcount\c_margincount   \c_margincount =\moduleparameter{memos}{margincount}\relax
\newcount\c_mediumcount   \c_mediumcount =\moduleparameter{memos}{margindistancecount}\relax
\newdimen\d_marginwidth   \d_marginwidth =\dimexpr\bodyfontsize*\c_margincount\relax
\newdimen\d_lineheight    \d_lineheight  =\dimexpr\lineheight*\c_heightcount-\strutheight+\topskip\relax

\startluacode
  local todimen
  local thr
  local pw = tex.getdimen("paperwidth")
  local ph = tex.getdimen("paperheight")
  local pr = pw / ph
  local tc = tex.getcount("c_textcount")
  local hc = tex.getcount("c_heightcount")
  local mc = tex.getcount("c_margincount")
  local dc = tex.getcount("c_mediumcount")
  local bs = tex.getdimen("bodyfontsize")
  local hh = tex.getdimen("d_lineheight")
  local mw = tex.getdimen("d_marginwidth")
  local twr = tc * bs -- 每行字數是必要設置

  local expanded_value = token.getexpansion("\\moduleparameter{memos}{ratio}")
  local ratio = tonumber(expanded_value) or 1.414

  local Lm, Lmm, Lml, Lmr, Rmr, Rml, Rm, Rmm

  local ratio_sq = ratio * ratio
  local left_total_factor = 1 + ratio + ratio_sq
  local vert_total_factor = 2 + ratio + 1 / ratio
  local Rml = bs * dc -- 固定中等距离（两分支共用）

  -- 如果沒有設置頁面高度數
  local thr = (hc == 0) and (twr / pr) or hh

  -- 1. 水平方向分配
  if mc == 0 then
      Lm  = (pw - twr) / (1 + ratio)             -- 左侧总距
      Rm  = pw - Lm - twr                        -- 右侧总余白
      Rmr = Lm * ratio / vert_total_factor       -- 右边缘距离
      Rmm = Rm - Rml - Rmr                       -- 边注宽（自动推导）
  else
      Rmm = mw                                   -- 指定边注宽
      Lm  = (pw - twr - Rmm) / (1 + ratio)       -- 左侧总距
      Rm  = pw - Lm - twr                        -- 右侧总余白
      Rmr = Rm - Rmm - Rml                       -- 右边缘距离
  end

  -- 左侧内部三段等比切分 (1 : r : r^2)
  local Lmm = Lm / left_total_factor
  local Lml = Lm * ratio / left_total_factor
  local Lmr = Lm * ratio_sq / left_total_factor

  -- 2. 垂直方向分配
  local He  = (ph - thr) / (1 + ratio)           -- 顶部总留白
  local Fo  = ph - He - thr                      -- 底部总留白

  local Het = He * ratio / vert_total_factor     -- Topspace
  local Heb = Het / ratio                        -- Header distance
  local Hem = He - Het - Heb                     -- Header height

  local Fob = Fo * ratio / vert_total_factor     -- Bottomspace
  local Fot = Fob / ratio                        -- Footer distance
  local Fom = Fo - Fot - Fob                     -- Footer height

  local function spstr(x) return tostring(math.floor(x + 0.5)) .. "sp" end

  context.definelayout(
    { "hermes" },
    {
      width               = spstr(twr),
      height              = spstr(ph - Het - Fob),
      backspace           = spstr(Lm),
      leftmargin          = spstr(Lmm),
      leftmargindistance  = spstr(Lml),
      leftedgedistance    = spstr(Lmr),
      leftedge            = "1sp",
      rightmargin         = spstr(Rmm),
      rightmargindistance = spstr(Rml),
      rightedgedistance   = spstr(Rmr),
      rightedge           = "1sp",
      topspace            = spstr(Het),
      header              = spstr(Hem),
      headerdistance      = spstr(Heb),
      footer              = spstr(Fom),
      footerdistance      = spstr(Fot),
      bottomspace         = spstr(Fob),
    }
)
\stopluacode

%%%%% \section{layout}
\definelayout [madsen]  [exotic]
\definelayout [default] [\moduleparameter{memos}{layout}]
\setuplayout  [\moduleparameter{memos}{layout}]

\newif\ifchargridchars    \chargridcharstrue
\newif\ifchargridbaseline \chargridbaselinefalse
\newif\ifchargridlabel    \chargridlabeltrue
\newif\ifchargridruler    \chargridrulertrue

\startuniqueMPgraphic{mm@chargrids}{em,bl,ts,fh,fd,showchars,showbaseline}
  numeric em, bl, ts, fh, fd, pad, n, m, k, i, yb, yt ;
  em := \MPvar{em} ;
  bl := \MPvar{bl} ;
  ts := \MPvar{ts} ;
  fh := \MPvar{fh} ;% 字顶到基线
  fd := \MPvar{fd} ;% 基线到字底
  pad := (em - (fh+fd))/2 ;   % 让 1em 方块包住字身
  if pad < 0 : pad := 0 ; fi ;

  color line, baseline ;
  line     := .55[white,blue] ;
  baseline := .20[white,black] ;
  pickup pencircle scaled .2pt ;

  n := floor((OverlayHeight - ts)/bl) ;
  m := floor(OverlayWidth/em) ;

  for k = 0 upto n :
    % 正方形字格：底边由基线、字深和 padding 决定，边长恒为 1em
    yb := OverlayHeight - ts - k*bl - fd - pad ;
    yt := yb + em ;

    if \MPvar{showbaseline} > 0 :
      draw (0, OverlayHeight - ts - k*bl) -- (OverlayWidth, OverlayHeight - ts - k*bl)
        withcolor baseline ;
    fi ;

    if \MPvar{showchars} > 0 :
      draw (0, yb) -- (OverlayWidth, yb) withcolor line ;
      draw (0, yt) -- (OverlayWidth, yt) withcolor line ;
      for i = 0 upto m :
        draw (i*em, yb) -- (i*em, yt) withcolor line ;
      endfor ;
    fi ;
  endfor ;

  draw unitsquare xscaled OverlayWidth yscaled OverlayHeight
    withcolor .75[white,blue] ;
\stopuniqueMPgraphic

\startuniqueMPgraphic{mm@chargrids:ruler}{w,h,em,bl,ts,bx,by,showlabel}
  numeric mmx, n, i, len, y, w, h, em, bl, ts, bx, by, nci, nli ;
  mmx := 2.845274 ;
  w := \MPvar{w} ;
  h := \MPvar{h} ;
  em := \MPvar{em} ;
  bl := \MPvar{bl} ;
  ts := \MPvar{ts} ;
  bx := \MPvar{bx} ;
  by := \MPvar{by} ;
  nci := round(10*w/em) ;
  nli := round(10*((h-ts)/bl + 1)) ;

  color frame, tick, midtick, cmtick, lab ;
  frame   := .78[white,black] ;
  tick    := .78[white,black] ;
  midtick := .55[white,black] ;
  cmtick  := .45[white,blue] ;
  lab     := .35[white,black] ;
  pickup pencircle scaled .2pt ;

  % 左侧竖尺：贴纸边（内缩 2pt 避开页框），刻度向页内，1mm 步进，5cm 标注，自上而下递增
  draw (2, 0) -- (2, PaperHeight) withcolor frame ;
  n := floor(PaperHeight/mmx) ;
  for i = 0 upto n :
    y := PaperHeight - i*mmx ;
    if (i mod 10) = 0 :
      len := 6 ; draw (2, y) -- (2+len, y) withcolor cmtick ;
    elseif (i mod 5) = 0 :
      len := 4 ; draw (2, y) -- (2+len, y) withcolor midtick ;
    else :
      len := 2 ; draw (2, y) -- (2+len, y) withcolor tick ;
    fi ;
    if ((i mod 50) = 0) and (i > 0) :
      label.rt(textext("\ttxx " & decimal (i div 10) & "cm"), (2+len+2, y)) withcolor cmtick ;
    fi ;
  endfor ;
  label.rt(textext("\ttxx 0cm"), (10, PaperHeight-15)) withcolor cmtick ;

  % 顶部横尺：贴纸边（内缩 2pt 避开页框），刻度向页内，1mm 步进，5cm 标注，自左向右递增
  draw (0, PaperHeight-2) -- (PaperWidth, PaperHeight-2) withcolor frame ;
  n := floor(PaperWidth/mmx) ;
  for i = 0 upto n :
    if (i mod 10) = 0 :
      len := 6 ; draw (i*mmx, PaperHeight-2) -- (i*mmx, PaperHeight-2-len) withcolor cmtick ;
    elseif (i mod 5) = 0 :
      len := 4 ; draw (i*mmx, PaperHeight-2) -- (i*mmx, PaperHeight-2-len) withcolor midtick ;
    else :
      len := 2 ; draw (i*mmx, PaperHeight-2) -- (i*mmx, PaperHeight-2-len) withcolor tick ;
    fi ;
    if ((i mod 50) = 0) and (i > 0) :
      label.bot(textext("\ttxx " & decimal (i div 10) & "cm"), (i*mmx, PaperHeight-2-len-2)) withcolor cmtick ;
    fi ;
  endfor ;

  % 汇总放在版心底部（正文区下沿之外），尾部对齐版心右边缘
  if \MPvar{showlabel} > 0 :
    label.lft(textext("\ttxx " & decimal (nci div 10) & "Char * " & decimal (nli div 10)
      & "Line = " & decimal ((nci div 10)*(nli div 10)) & "Char"),
      (bx+w-2, by-8)) withcolor lab ;
  fi ;
\stopuniqueMPgraphic

\defineoverlay[mm@chargrids][\uniqueMPgraphic{mm@chargrids}{%
  em=\the\bodyfontsize,
  bl=\the\lineheight,
  ts=\the\topskip,
  fh=\the\fontcharht\font`永,
  fd=\the\fontchardp\font`永,
  showchars=\ifchargridchars 1\else 0\fi,
  showbaseline=\ifchargridbaseline 1\else 0\fi,
}]

\defineoverlay[mm@chargrids:ruler][\uniqueMPgraphic{mm@chargrids:ruler}{%
  w=\the\textwidth,
  h=\the\textheight,
  em=\the\bodyfontsize,
  bl=\the\lineheight,
  ts=\the\topskip,
  bx=\the\backspace,
  by=\the\dimexpr\paperheight-\topspace-\headerheight-\headerdistance-\textheight\relax,
  showlabel=\ifchargridlabel 1\else 0\fi,
}]

\getparameters[mm@chargrids][chars=yes,baseline=no,label=yes,ruler=yes]%

\tolerant\def\showchargrids[#1]{%
  \iffirstargument\getparameters[mm@chargrids][#1]\fi%
  \processaction[\mm@chargridschars]%
        [yes=>\chargridcharstrue,
          no=>\chargridcharsfalse,
  \v!default=>\chargridcharstrue,
  \v!unknown=>\chargridcharstrue]%
  \processaction[\mm@chargridsbaseline]%
        [yes=>\chargridbaselinetrue,
          no=>\chargridbaselinefalse,
  \v!default=>\chargridbaselinefalse,
  \v!unknown=>\chargridbaselinefalse]%
  \processaction[\mm@chargridslabel]%
        [yes=>\chargridlabeltrue,
          no=>\chargridlabelfalse,
  \v!default=>\chargridlabeltrue,
  \v!unknown=>\chargridlabeltrue]%
  \processaction[\mm@chargridsruler]%
        [yes=>\chargridrulertrue,
          no=>\chargridrulerfalse,
  \v!default=>\chargridrulertrue,
  \v!unknown=>\chargridrulertrue]%
  \ifchargridruler
    \setupbackgrounds[page][background={mm@chargrids:ruler}]%
  \fi
  \setupbackgrounds[text][background={mm@chargrids}]%
}

