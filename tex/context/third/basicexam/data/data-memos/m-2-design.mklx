\protected\def\definecovervariable#1{\begingroup% #1=element name
    \edef\p_variable{\namedcoverparameter\currentcover{#1}}%
    \edef\p_align{\namedcoverparameter\currentcover{#1align}}%
    \ifempty\p_align\edef\p_align{\coverparameter\c!align}\fi
    \namedcoverparameter\currentcover{#1vspace}%
    \namedcoverparameter\currentcover{#1before}%
    \startalignment[\p_align]%
    \bgroup
    \ifempty\p_variable
      \writestatus{module cover}{warning: #1 is empty! please input #1. or maybe you have some value is undefined.}%
    \else
      \usecoverstyleandcolor{#1style}{#1color}%
      \namedcoverparameter\currentcover{#1left}%
      \namedcoverparameter\currentcover{#1}%
      \namedcoverparameter\currentcover{#1right}%
    \fi
    \egroup
    \stopalignment
    \namedcoverparameter{\currentcover}{#1after}%
    \endgroup}

\definetextbackground[cover]%
\setuptextbackground [cover][location=paragraph,background=,frame=off]

\protected\tolerant\def\makecover[#1]#*[#2]%
  {\begingroup\def\currentcover{#1}%
   \ifarguments\or\or\setupcover[#1][#2]\fi
   \def\currentlist{\namedcoverparameter\currentcover\c!list}
   \startmakeup[\namedcoverparameter\currentcover\c!makeup]%
     \starttextbackground [cover]%
     \vbox to \textheight{%
       \namedcoverparameter\currentcover\c!before
       \useinterlinespaceparameter\coverparameter
       \usealignparameter\coverparameter
       \usecoverstyleandcolor\c!style\c!color
       \processcommacommand[\currentlist]\definecovervariable
       \namedcoverparameter\currentcover{lastvspace}%
       \namedcoverparameter\currentcover\c!after
    }\stoptextbackground%
    \marking[book]{\namedcoverparameter\currentcover\c!book}
    \stopmakeup%
  \endgroup}

