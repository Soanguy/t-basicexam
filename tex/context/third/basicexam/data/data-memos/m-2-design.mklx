\definelayout[graaf][
  % 水平：严格保留 1:2 边距，正文宽度占 6/9
  backspace=\dimexpr 1\paperwidth/9\relax,
   cutspace=\dimexpr 2\paperwidth/9\relax,
      width=\dimexpr 1\paperwidth -\layoutparameter\c!backspace -\layoutparameter\c!cutspace\relax, 
  % 垂直：从页眉顶部到页脚底部总高度占 6/9
   topspace=0mm,bottomspace=0mm,headerdistance=0mm,footerdistance=0mm,
     header=\dimexpr 1\paperheight/9 -\layoutparameter\c!topspace    -\layoutparameter\c!headerdistance\relax,   % 页眉顶部定位在 H/9
     height=\dimexpr 1\paperheight   -\layoutparameter\c!topspace    -\layoutparameter\c!bottomspace\relax,
     footer=\dimexpr 2\paperheight/9 -\layoutparameter\c!bottomspace -\layoutparameter\c!footerdistance\relax,   % 页脚底部定位在 7H/9
]

\definelayout[optvdh][
  vdhnumber=9,
  rightedgewidth=5mm,rightedgedistance=5mm,rightmargindistance=5mm,
        topspace=5mm,bottomspace=5mm,headerdistance=5mm,footerdistance=5mm,
       backspace=\dimexpr 1\paperwidth/(\layoutparameter{vdhnumber} + 3)\relax,
        cutspace=\dimexpr 2\paperwidth/(\layoutparameter{vdhnumber} + 3)\relax,
           width=\dimexpr 1\paperwidth -\layoutparameter\c!backspace -\layoutparameter\c!cutspace\relax,
          header=\dimexpr 3\paperwidth/(\layoutparameter{vdhnumber} + 3)/2 -\layoutparameter\c!topspace    -\layoutparameter\c!headerdistance\relax,
          height=\dimexpr 1\paperheight                   -\layoutparameter\c!topspace    -\layoutparameter\c!bottomspace\relax, 
          footer=\dimexpr 3\paperwidth/(\layoutparameter{vdhnumber} + 3)   -\layoutparameter\c!bottomspace -\layoutparameter\c!footerdistance\relax, 
]

\definelayout[vdh][
  vdhnumber=12,
  rightedgewidth=5mm,rightedgedistance=5mm,rightmargindistance=5mm,
        topspace=5mm,bottomspace=5mm,headerdistance=5mm,footerdistance=5mm,
       backspace=\dimexpr 1\paperwidth/(\layoutparameter{vdhnumber} + 3)\relax,
        cutspace=\dimexpr 2\paperwidth/(\layoutparameter{vdhnumber} + 3)\relax,
           width=\dimexpr 1\paperwidth -\layoutparameter\c!backspace -\layoutparameter\c!cutspace\relax,
          header=\dimexpr 1\paperheight/(\layoutparameter{vdhnumber} + 3) -\layoutparameter\c!topspace    -\layoutparameter\c!headerdistance\relax,
          height=\dimexpr 1\paperheight                  -\layoutparameter\c!topspace    -\layoutparameter\c!bottomspace\relax, 
          footer=\dimexpr 2\paperheight/(\layoutparameter{vdhnumber} + 3) -\layoutparameter\c!bottomspace -\layoutparameter\c!footerdistance\relax, 
]

% layout=grids 已移除。页面模数不属于本模块的设计模型：
% 版心由字符数与行数决定，网格只作用于版心内部。

\setuppapersize  [\moduleparameter{memos}{papersize}]
%% 因为 hermes 需要页面大小， 所以必须先设置页面尺寸。
%% must load font first,then can get real text fontsize(1em)

% 只關心每行寬度每列高度和邊注寬度。其他的依照 1:√2 的比例切割（只是粗略）
\def\c_hermesratio{\moduleparameter{memos}{ratio}}
\newcount\c_textcount     \c_textcount   =\moduleparameter{memos}{textcount}\relax
\newcount\c_heightcount   \c_heightcount =\moduleparameter{memos}{heightcount}\relax
\newcount\c_margincount   \c_margincount =\moduleparameter{memos}{margincount}\relax
\newdimen\d_textfontsize  \d_textfontsize=\bodyfontsize\relax%\fontdimen6\font\relax
\newdimen\d_marginwidth   \d_marginwidth=\dimexpr\bodyfontsize*\c_margincount\relax
\newdimen\d_textlineheight\d_textlineheight=
         \dimexpr\lineheight*\c_heightcount-\strutheight+\topskip\relax

\startluacode
  local todimen
  local thr
  local pw = tex.getdimen("paperwidth")
  local ph = tex.getdimen("paperheight")
  local pr = pw / ph
  local tc = tex.getcount("c_textcount")
  local hc = tex.getcount("c_heightcount")
  local mc = tex.getcount("c_margincount")
  local bs = tex.getdimen("d_textfontsize")
  local hh = tex.getdimen("d_textlineheight")
  local mw = tex.getdimen("d_marginwidth")
  local twr = tc * bs -- 每行字數是必要設置

  local ratio = tonumber(tokens.getters.macro("c_hermesratio")) or 1.414

  if    hc == 0 then  -- 如果沒有設置頁面高度數
        thr = twr / pr
  else
        thr = hh
  end

  local Lm, Rmr, Rml, Rm, Rmm

  if    mc == 0 then
        Lm  = (pw - twr) / (1 + ratio)             -- 左邊距總寬度
        Rmr = Lm * ratio / (2 + ratio + 1/ratio)   -- 右邊緣距離
        Rml = Rmr / ratio                          -- 右邊注距離
        Rm  = pw - Lm - twr                        -- 右邊距總寬度
        Rmm = Rm - Rml - Rmr                       -- 邊注寬度（自動計算）
  else
        Rmm = mw                                   -- 邊注寬度（指定）
        Lm  = (pw - twr - Rmm) / (1 + ratio)       -- 左邊距總寬度（扣除邊注）
        Rm  = pw - Lm - twr                        -- 右邊距總寬度
        Rml = (Rm - Rmm) / (1 + ratio)             -- 右邊注距離
        Rmr = Rm - Rmm - Rml                       -- 右邊緣距離
  end

  local He  = (ph - thr) / (1 + ratio)           -- top total
  local Fo  = ph - He - thr                      -- bot total
  local Het = He * ratio / (2 + ratio + 1/ratio) -- top distance
  local Heb = Het / ratio                        -- header distance
  local Hem = He - Het - Heb                     -- header height
  local Fob = Fo * ratio / (2 + ratio + 1/ratio)
  local Fot = Fob / ratio
  local Fom = Fo - Fot -Fob

  local function spstr(x) return tostring(math.floor(x + 0.5)) .. "sp" end

  local textwidth  = spstr(twr)
  local theight    = ph - Het - Fob        -- textheight 是 頁面 - 頂部 - 尾部
  local textheight = spstr(theight)

  local backspace           = spstr(Lm)
  local rightmargin         = spstr(Rmm)
  local rightmargindistance = spstr(Rml)
  local rightedgedistance   = spstr(Rmr)
  local topdistance         = spstr(Het)
  local header              = spstr(Hem)
  local headerdistance      = spstr(Heb)
  local footer              = spstr(Fom)
  local footerdistance      = spstr(Fot)
  local botdistance         = spstr(Fob)

  -- context("ratio ")context(ratio)context.par()
  -- context("he                  ")context(He/65536)context.par()
  -- context("backspace           ")context(Lm/65536)context.par()
  -- context("topdistance         ")context(Het/65536)context.par()
  -- context("rightmargin         ")context(Rmm/65536)context.par()
  -- context("rightmargindistance ")context(Rml/65536)context.par()
  -- context("rightedgedistance   ")context(Rmr/65536)context.par()
  -- context("header              ")context(Hem/65536)context.par()
  -- context("headerdistance      ")context(Heb/65536)context.par()
  -- context("fo                  ")context(Fo/65536)context.par()
  -- context("footerdistance      ")context(Fot/65536)context.par()
  -- context("footer              ")context(Fom/65536)context.par()
  -- context("botdistance         ")context(Fob/65536)context.par()
