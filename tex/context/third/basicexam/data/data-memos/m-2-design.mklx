% 字符网格只依赖实际版心尺寸，适用于 hermes / moderate 等所有布局。
% 不再绘制页面模数网格，也不再读取 \layoutparameter{grids}。
\newif\ifchargridchars    \chargridcharstrue
\newif\ifchargridbaseline \chargridbaselinefalse
\newif\ifchargridlabel    \chargridlabeltrue
\newif\ifchargridruler    \chargridrulertrue

\startuniqueMPgraphic{chargrid}{em,bl,ts,fh,fd,showchars,showbaseline}
  numeric em, bl, ts, fh, fd, pad, n, m, k, i, yb, yt ;
  em := \MPvar{em} ;
  bl := \MPvar{bl} ;
  ts := \MPvar{ts} ;
  fh := \MPvar{fh} ;% 字顶到基线
  fd := \MPvar{fd} ;% 基线到字底
  pad := (em - (fh+fd))/2 ;   % 让 1em 方块包住字身
  if pad < 0 : pad := 0 ; fi ;

  color line, baseline ;
  line     := .55[white,blue] ;
  baseline := .20[white,black] ;
  pickup pencircle scaled .2pt ;

  n := floor((OverlayHeight - ts)/bl) ;
  m := floor(OverlayWidth/em) ;

  for k = 0 upto n :
    % 正方形字格：底边由基线、字深和 padding 决定，边长恒为 1em
    yb := OverlayHeight - ts - k*bl - fd - pad ;
    yt := yb + em ;

    if \MPvar{showbaseline} > 0 :
      draw (0, OverlayHeight - ts - k*bl) -- (OverlayWidth, OverlayHeight - ts - k*bl)
        withcolor baseline ;
    fi ;

    if \MPvar{showchars} > 0 :
      draw (0, yb) -- (OverlayWidth, yb) withcolor line ;
      draw (0, yt) -- (OverlayWidth, yt) withcolor line ;
      for i = 0 upto m :
        draw (i*em, yb) -- (i*em, yt) withcolor line ;
      endfor ;
    fi ;
  endfor ;

  draw unitsquare xscaled OverlayWidth yscaled OverlayHeight
    withcolor .75[white,blue] ;
\stopuniqueMPgraphic

% 边界尺子：画在纸张边缘，1mm 刻度，5cm 标注
\startuniqueMPgraphic{chargrid:ruler}{w,h,em,bl,ts,bx,by,showlabel}
  numeric mmx, n, i, len, y, w, h, em, bl, ts, bx, by, nci, nli ;
  mmx := 2.845274 ;
  w := \MPvar{w} ;
  h := \MPvar{h} ;
  em := \MPvar{em} ;
  bl := \MPvar{bl} ;
  ts := \MPvar{ts} ;
  bx := \MPvar{bx} ;
  by := \MPvar{by} ;
  nci := round(10*w/em) ;
  nli := round(10*((h-ts)/bl + 1)) ;

  color frame, tick, midtick, cmtick, lab ;
  frame   := .78[white,black] ;
  tick    := .78[white,black] ;
  midtick := .55[white,black] ;
  cmtick  := .45[white,blue] ;
  lab     := .35[white,black] ;
  pickup pencircle scaled .2pt ;

  % 左侧竖尺：贴纸边（内缩 2pt 避开页框），刻度向页内，1mm 步进，5cm 标注，自上而下递增
  draw (2, 0) -- (2, PaperHeight) withcolor frame ;
  n := floor(PaperHeight/mmx) ;
  for i = 0 upto n :
    y := PaperHeight - i*mmx ;
    if (i mod 10) = 0 :
      len := 6 ; draw (2, y) -- (2+len, y) withcolor cmtick ;
    elseif (i mod 5) = 0 :
      len := 4 ; draw (2, y) -- (2+len, y) withcolor midtick ;
    else :
      len := 2 ; draw (2, y) -- (2+len, y) withcolor tick ;
    fi ;
    if ((i mod 50) = 0) and (i > 0) :
      label.rt(textext("\ttxx " & decimal (i div 10) & "cm"), (2+len+2, y)) withcolor cmtick ;
    fi ;
  endfor ;
  label.rt(textext("\ttxx 0cm"), (10, PaperHeight-15)) withcolor cmtick ;

  % 顶部横尺：贴纸边（内缩 2pt 避开页框），刻度向页内，1mm 步进，5cm 标注，自左向右递增
  draw (0, PaperHeight-2) -- (PaperWidth, PaperHeight-2) withcolor frame ;
  n := floor(PaperWidth/mmx) ;
  for i = 0 upto n :
    if (i mod 10) = 0 :
      len := 6 ; draw (i*mmx, PaperHeight-2) -- (i*mmx, PaperHeight-2-len) withcolor cmtick ;
    elseif (i mod 5) = 0 :
      len := 4 ; draw (i*mmx, PaperHeight-2) -- (i*mmx, PaperHeight-2-len) withcolor midtick ;
    else :
      len := 2 ; draw (i*mmx, PaperHeight-2) -- (i*mmx, PaperHeight-2-len) withcolor tick ;
    fi ;
    if ((i mod 50) = 0) and (i > 0) :
      label.bot(textext("\ttxx " & decimal (i div 10) & "cm"), (i*mmx, PaperHeight-2-len-2)) withcolor cmtick ;
    fi ;
  endfor ;

  % 汇总放在版心底部（正文区下沿之外），尾部对齐版心右边缘
  if \MPvar{showlabel} > 0 :
    label.lft(textext("\ttxx " & decimal (nci div 10) & "Char * " & decimal (nli div 10)
      & "Line = " & decimal ((nci div 10)*(nli div 10)) & "Char"),
      (bx+w-2, by-8)) withcolor lab ;
  fi ;
\stopuniqueMPgraphic

\defineoverlay[grid][\uniqueMPgraphic{chargrid}{%
  em=\the\bodyfontsize,
  bl=\the\lineheight,
  ts=\the\topskip,
  fh=\the\fontcharht\font`永,
  fd=\the\fontchardp\font`永,
  showchars=\ifchargridchars 1\else 0\fi,
  showbaseline=\ifchargridbaseline 1\else 0\fi,
}]

\defineoverlay[chargrid:ruler][\uniqueMPgraphic{chargrid:ruler}{%
  w=\the\textwidth,
  h=\the\textheight,
  em=\the\bodyfontsize,
  bl=\the\lineheight,
  ts=\the\topskip,
  bx=\the\backspace,
  by=\the\dimexpr\paperheight-\topspace-\headerheight-\headerdistance-\textheight\relax,
  showlabel=\ifchargridlabel 1\else 0\fi,
}]

\tolerant\def\showchargrids[#1]{%
  \getparameters[chargrids][chars=yes,baseline=no,label=yes,ruler=yes]%
  \iffirstargument\getparameters[chargrids][#1]\fi%
  \processaction[\chargridschars]
    [yes=>\chargridcharstrue,no=>\chargridcharsfalse,
     \v!default=>\chargridcharstrue,\v!unknown=>\chargridcharstrue]%
  \processaction[\chargridsbaseline]
    [yes=>\chargridbaselinetrue,no=>\chargridbaselinefalse,
     \v!default=>\chargridbaselinefalse,\v!unknown=>\chargridbaselinefalse]%
  \processaction[\chargridslabel]
    [yes=>\chargridlabeltrue,no=>\chargridlabelfalse,
     \v!default=>\chargridlabeltrue,\v!unknown=>\chargridlabeltrue]%
  \processaction[\chargridsruler]
    [yes=>\chargridrulertrue,no=>\chargridrulerfalse,
     \v!default=>\chargridrulertrue,\v!unknown=>\chargridrulertrue]%
  \ifchargridruler
    \setupbackgrounds[page][background={chargrid:ruler}]%
  \fi
  \setupbackgrounds[text][background=grid]%
}

