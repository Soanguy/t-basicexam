%%%%%% indeed command start
% if prefixsegments 1:5 will show
% part : chap -- sec.subsec.subsubsec.figure
% if prefixsegments 2:2 will show
% chap . figure
\defineseparatorset [defaults][:,-,.][.]
\defineprocessor    [dostopper][left=,right=]
\defineprocessor    [nostopper][left=,right=]
\defineconversionset[defaultconversion][][dostopper->n]
\defineconversionset[floatconversion]  [][nostopper->n]%
\setupreferencestructureprefix
             [figure][defaults]
             [prefixconversionset=floatconversion,prefixsegments=2:2]
\setupreferencestructureprefix
              [table][defaults]
              [prefixconversionset=floatconversion,prefixsegments=2:2]
\setupreferencestructureprefix
              [defaults]
              [prefixconversionset=defaultconversion]

\startsetups refabout:simp
    \labeltexts{reference:\autoreferencekindtext}{\clf_filterreference{number}}%
    \kern.5em\clf_filterreference{title}%
\stopsetups

\startsetups refabout:full
    \labeltexts{reference:\autoreferencekindtext}{\clf_filterreference{number}}%
    \kern.5em\clf_filterreference{title}(p.\clf_filterreference{realpage})%
\stopsetups

\definereferenceformat[refin]   [label=reference:*,    style=rm, type=number,  ]
\definereferenceformat[refat]   [label=reference:page, style=rm, type=realpage,]
\definereferenceformat[refabout][right=\refsymbol,     style=rm, type=title]%务必用 title 才能正确读值
\definereferenceformat[reftext] [setups=refabout:simp, style=rm, ]%\autoreferencekindtext 会自动拼接，无须label参数
\definereferenceformat[reffull] [setups=refabout:full, style=rm, ]
