\usesymbols      [fontawesome]%
\setupurl        [color=linkcolor,style=tt]

\definenamespace [usersymbol]
  [  name=usersymbol,
   parent=usersymbol,
    setup=list,
  command=list,
  ]

\setupusersymbol
  [from=\symbol[fontawesome][plane],
  Frame=\symbol[fontawesome][quote_right],
    ref=\symbol[fontawesome][circle_blank],
suggest=\symbol[fontawesome][star]]

\def\urlsymbol{{\nobreak\kern1pt\high{\switchtobodyfont[5pt]\useurlstyleandcolor\c!style\c!color\usersymbolparameter{from}}}}
\def\refsymbol{{\nobreak\kern1pt\high{\switchtobodyfont[5pt]\useurlstyleandcolor\c!style\c!color\usersymbolparameter {ref}}}}

\pushoverloadmode
\overloaded\unexpanded\def\from[#label]{\dontleavehmode
   \goto{\clf_from{#label}}[fileorurl(#label)]\urlsymbol}
\popoverloadmode

\def\mailto[#1]{%
  \doifnextcharelse\bgroup
    {\mailto_withsecond[#1]}%
    {\mailto_withoutsecond[#1]}%
}
% 不要在 #2 后添加 空格，否则会被认为 #2 的结束界定符是 空格，导致吞噬一些不该吞噬的文本
\def\mailto_withsecond[#1]#2{\useURL[#1][mailto:#1][][#2]\from[{#1}]\goto{(#1)}[url(mailto:#1)]}
\def\mailto_withoutsecond[#1]{\useURL[#1][mailto:#1][][#1]\from[{#1}]}

\lettonothing\defineurl
\tolerant\def\defineurl[#1][#2]%
 {\begingroup
  \ifarguments\or
    \getdummyparameters[#1]\or
    \getdummyparameters[reference={#1},#2]\fi
  \edef\p_urlormail{\ifempty\dummyparameter{url}mailto:\dummyparameter{mail}\else\dummyparameter{url}\fi}
  \edef\p_reference{\ifempty\dummyparameter\c!reference\p_urlormail\else\dummyparameter\c!reference\fi}%
  \edef\p_text     {\ifempty\dummyparameter\c!text\p_reference\else\dummyparameter\c!text\fi}%
  \expanded{\useURL[\p_reference][\p_urlormail][\dummyparameter\c!file][\p_text]}%
  \endgroup}

\def\linkto#1{{\doifmodeelse{print}{\url[#1]}{\from[#1]}}}

\def\href#1[#2]{\ifempty{#1}\goto{#2}[fileorurl(#2)]\else\doifmodeelse{print}{\goto{#2}[fileorurl(#2)]}{\goto{#1}[fileorurl(#2)]}\fi\urlsymbol}

% \href{baidu}[baidu.com] 无须提前定义，直接使用
% \href[baidu.com]        无须提前定义，直接使用
