%\setupnote affects the number inside the body text,
%\setupnotation affects the text at the bottom of the page (footnote or endnote).
% \note[fn:notei]\notesep\note[fn:noteii]

\startsetups fn:hanzi
  \setglobalscript [custom]%% \restoreglobalbodyfont
\stopsetups

\permanent\protected\def\hanihigh{\typo_scripts_high[hanihigh]}
\setuphigh[hanihigh][distance=1pt,up=\exheight]

\def\notesep    {{\useurlstyleandcolor\c!style\c!color\strc_notes_inject_separator}}
\def\MMS_notecommand#1{\begingroup\nobreak\hanihigh{\languageparameter{leftnotemark}{#1}\languageparameter{rightnotemark}}\endgroup}
\def\MMS_notationcommand#1{\begingroup{\languageparameter{leftnotemark}{#1}\languageparameter{rightnotemark}}\endgroup}
\setupnote      [\c!setups       ={fn:hanzi},
                 \c!textseparator=\textcomma,
                 \c!textcolor    =footnotecolor,
                ]
\setupnotation  [\c!setups       ={fn:hanzi},
                 \c!color        =footnotecolor,
                 \c!headcolor    =footnotecolor,
                 \c!way          =bypage,
                ]

\setupnote     [footnote]   [\c!textcommand  =\MMS_notecommand,]     
\setupnotation [footnote]   [\c!numbercommand=\MMS_notationcommand,] 

\definenote    [marginnote] [footnote]
\setupnote     [marginnote] [location=none]
\setupnotation [marginnote] [align=flushleft, headalign={flushright,lohi}, location=serried,]

\setuptexttexts[margin] []  [\vtop to \textheight{\vskip4pt\relax
                             \setups{fn:hanzi}%
                             \placelocalnotes[marginnote][width=\outermarginwidth]\vfill}]


\definemargindata [sidenoteframe][inoutermargin]
\setupmargindata  [sidenoteframe][style=\setups{fn:hanzi},stack=continue]
\setupmarginframed[sidenoteframe][style=\setups{fn:hanzi},stack=continue]

\defineconversion [sidenote][%
    \hbox to 1.0em{{\tfx\hfill\ast}},
    \hbox to 1.0em{{\tfx\hfill\ast\ast}},
    \hbox to 1.0em{\tfx\raise .5em%
      \hbox to 1.0em{\hfil\ast\hfil}\kern-1.0em
      \hbox to 1.0em{\hfil\ast\ast\hfil}}]


\tolerant\def\movesidenote[#1]{\def\move_sidenote{\doifsomethingelse{#1}{#1}{0em}}}

\movesidenote[-\baselineskip]
\define\PlaceFootnote{\sidenoteframe[dy=\move_sidenote]{%
    \placelocalnotes[sidenote][align={width,hyphenated,morehyphenation,tight},before=,after=,]
  }}
  
\definenote    [sidenote]
\setupnote     [sidenote] [location=text,next=\PlaceFootnote,left=,right=,width=max]
\setupnotation [sidenote] [numberconversion=sidenote,width=2mm,left=,right=,]
