% \enabledirectives[backend.pdf.nounicode=當前非有效版本，請聯繫作者]

\startuseMPgraphic{mp:itemgroup:squares}
  numeric us; path ps;
  us := BodyFontSize;
  ps := fullsquare scaled .5us;
  draw ps shifted (.2us, -.2us) withcolor .5white  withpen pencircle scaled 1pt;
  draw ps shifted (.4us, -.0us) withcolor \MPcolor{lightthemecolor}  withpen pencircle scaled 1pt;
\stopuseMPgraphic

\startuseMPgraphic{mp:itemgroup:circles}
  numeric uc; path pc;
  uc := BodyFontSize;
  pc := fullcircle scaled .55uc;
  draw pc shifted (.15uc, -.15uc) withcolor .5white  withpen pencircle scaled 1pt;
  draw pc       withcolor \MPcolor{lightthemecolor}  withpen pencircle scaled 1pt;
\stopuseMPgraphic

\startuseMPgraphic{mp:itemgroup:square}
  numeric us; path ps;
  us := BodyFontSize;
  ps := fullsquare scaled .6us;
  fill ps shifted (.2us, -.2us) withcolor .5white;
  fill ps withcolor \MPcolor{lightthemecolor};
\stopuseMPgraphic

\startuseMPgraphic{mp:itemgroup:circle}
  numeric uc; path pc;
  uc := BodyFontSize;
  pc := fullcircle scaled .65uc;
  fill pc shifted (.15uc, -.15uc) withcolor .5white;
  fill pc withcolor \MPcolor{lightthemecolor};
\stopuseMPgraphic

\startuseMPgraphic{sym:squares-random}
  save height , depth ;
  height := \the \bodyfontsize * \currentfontscale ;
  depth  := \the \strutdepth ;
  path squaresrandom;
  squaresrandom   := fullsquare scaled .6height randomized 1pt;
  draw squaresrandom crossingunder (fullsquare scaled height)
                     withpen pencircle scaled 2pt
                     withcolor \MPcolor{\itemgroupparameter{color}};
  draw  (fullsquare scaled height)
             withpen pencircle scaled 0pt withtransparency (1,0) ;
\stopuseMPgraphic

\startuniqueMPgraphic{sym:square}
  save height , depth ;
  height := \the \bodyfontsize * \currentfontscale ;
  depth  := \the \strutdepth ;
  path square;
  square   := fullsquare scaled .6height;
  draw square crossingunder (fullsquare scaled height)
              withpen pencircle scaled 1pt
              withcolor \MPcolor{\itemgroupparameter{color}};
  draw  (fullsquare scaled height)
             withpen pencircle scaled 0pt withtransparency (1,0) ;
\stopuniqueMPgraphic

\startuniqueMPgraphic{sym:circle}
  save height , depth ;
  height := \the \bodyfontsize * \currentfontscale ;
  depth  := \the \strutdepth ;
  path circle;
  circle   := fullcircle scaled .6height;
  draw circle crossingunder (fullsquare scaled height)
              withpen pencircle scaled 1pt
              withcolor \MPcolor{\itemgroupparameter{color}};
  draw  (fullsquare scaled height)
             withpen pencircle scaled 0pt withtransparency (1,0) ;
\stopuniqueMPgraphic

\startuniqueMPgraphic{sym:bullet}
  save height , depth ;
  height := \the \bodyfontsize * \currentfontscale ;
  depth  := \the \strutdepth ;
  path bullet;
  bullet := fullcircle scaled .2height;
  fill bullet crossingunder (fullsquare scaled height)
              withpen pencircle scaled 1pt withcolor \MPcolor{\itemgroupparameter{color}};
  draw  (fullsquare scaled height)
             withpen pencircle scaled 0pt withtransparency (1,0) ;
\stopuniqueMPgraphic

\definesymbol [mp:squares]      [{\lower.3ex\vbox{\useMPgraphic{sym:squares-random}}}]
\definesymbol [mp:square]       [{\lower.3ex\vbox{\uniqueMPgraphic{sym:square}}}]
\definesymbol [mp:circle]       [{\lower.3ex\vbox{\uniqueMPgraphic{sym:circle}}}]
\definesymbol [mp:bullet]       [{\lower.3ex\vbox{\uniqueMPgraphic{sym:bullet}}}]

\definesymbol [shadowedsquare]  [{\lower.1\bodyfontsize\hbox{\useMPgraphic{mp:itemgroup:square}}}]
\definesymbol [shadowedcircle]  [{\lower.1\bodyfontsize\hbox{\useMPgraphic{mp:itemgroup:circle}}}]
\definesymbol [shadowedsquares] [{\lower.1\bodyfontsize\hbox{\useMPgraphic{mp:itemgroup:squares}}}]
\definesymbol [shadowedcircles] [{\lower.1\bodyfontsize\hbox{\useMPgraphic{mp:itemgroup:circles}}}]

\definesymbol[blankdiamond][{\tfx ⬥}]

\defineitemgroup    [ordinals] [levels=4]
\setupitemgroup     [ordinals] [each]
                               [before=,after=,right=,
                                headstyle=bf,color=deepthemecolor,
                                width=1em,distance=.25em,
                                stopper=.,symalign=center]
\setupitemgroup     [ordinals] [1]        [n,packed,joinedup]
\setupitemgroup     [ordinals] [2]        [i,packed,joinedup]
\setupitemgroup     [ordinals] [3]        [a,packed,joinedup]
\setupitemgroup     [ordinals] [4]        [i,packed,joinedup]
\defineitemgroup    [points]   [levels=4]% [nowhite]
\setupitemgroup     [points]   [each]     [packed,joinedup]
                               [before=,after=,right=,
                                headstyle=bf,color=deepthemecolor,
                                width=1em,distance=.25em,
                                stopper=.,symalign=center]
\setupitemgroup     [points]   [1]        [symbol=mp:bullet]
\setupitemgroup     [points]   [2]        [symbol=diamond]
\setupitemgroup     [points]   [3]        [symbol=asterisk]
\setupitemgroup     [points]   [4]        [symbol=star]

\definedescription  [hangdescr][
                     before=\par,  after=\par,  inbetween=,
                     width=fit, indenting=2em, indentnext=yes,
                     headstyle=bold, align={flushleft},
                     text={\raise 1pt \hbox to 1em{$\bullet$}},%hang=99,
                     alternative=hanging,]
\definedescription  [topdescr][
                     before=\par,  after=\par,  inbetween=,
                     width=fit, indenting=2em, indentnext=yes,
                     headstyle=bold, align={flushleft},
                     text={\raise 1pt \hbox to 1em{$\bullet$}},
                     alternative=top,]
\definedescription  [description][
                     before=\blank[halfline],  after=\blank[halfline],  inbetween=,
                     width=fit, indenting=2em, indentnext=yes,
                     headstyle=bold, align={flushleft},
                     alternative=serried,]

\defineenumeration[theorem]     [alternative=hanging, width=fit, before=\blank[halfline]\leftskip1em\rightskip\leftskip, after=\blank[halfline], inbetween=, text=\labeltext{reference:theorem},    way=bychapter, prefix=yes, prefixsegments=chapter]
\defineenumeration[lemma]       [alternative=hanging, width=fit, before=\blank[halfline]\leftskip1em\rightskip\leftskip, after=\blank[halfline], inbetween=, text=\labeltext{reference:lemma},      way=bychapter, prefix=yes, prefixsegments=chapter]
\defineenumeration[corollary]   [alternative=hanging, width=fit, before=\blank[halfline]\leftskip1em\rightskip\leftskip, after=\blank[halfline], inbetween=, text=\labeltext{reference:corollary},  way=bychapter, prefix=yes, prefixsegments=chapter]
\defineenumeration[proposition] [alternative=hanging, width=fit, before=\blank[halfline]\leftskip1em\rightskip\leftskip, after=\blank[halfline], inbetween=, text=\labeltext{reference:proposition},way=bychapter, prefix=yes, prefixsegments=chapter]
\defineenumeration[definition]  [alternative=hanging, width=fit, before=\blank[halfline]\leftskip1em\rightskip\leftskip, after=\blank[halfline], inbetween=, text=\labeltext{reference:definition}, way=bychapter, prefix=yes, prefixsegments=chapter]
\defineenumeration[proof]       [alternative=hanging, width=fit, before=\blank[halfline]\leftskip1em\rightskip\leftskip, after=\blank[halfline], inbetween=, text=\labeltext{reference:proof},      way=bychapter, prefix=yes, prefixsegments=chapter]
\defineenumeration[remark]      [alternative=hanging, width=fit, before=\blank[halfline]\leftskip1em\rightskip\leftskip, after=\blank[halfline], inbetween=, text=\labeltext{reference:remark},     way=bychapter, prefix=yes, prefixsegments=chapter]
\defineenumeration[examples]    [alternative=hanging, width=fit, before=\blank[halfline]\leftskip1em\rightskip\leftskip, after=\blank[halfline], inbetween=, text=\labeltext{reference:example},    way=bychapter, prefix=yes, prefixsegments=chapter]
\defineenumeration[tips]        [text=Tips,inbetween=,width=fit,right={.~},
                                  headcommand=\setuptextrules[color=themecolor,rulecolor=themecolor,rulethickness=1.5\linewidth,before=\blank[halfline]]\textrule[top],
                                  before=\vskip-\baselineskip\relax,
                                  after=\setuptextrules[color=themecolor,rulecolor=themecolor,rulethickness=1.5\linewidth,after=\blank[halfline]]\textrule[bottom]\empty,
                                  prefix=yes,% or prefixsegments=chapter:section
                                  prefixsegments=section]
\setupcounter       [tips]       [way=bysection]
\defineenumeration  [mainpoint]
\setupenumeration   [mainpoint] [text=,
                                 title=yes,
                                 titleleft=,titleright=,
                                 titlestyle=sstf,
                                 numberstyle=sstf,
                                 numberconversion=cn,stopper=、,
                                 indentnext=yes,
                                 before=\blank[halfline],
                                 after=,
                                 inbetween=\blank[halfline],
                                 ]

