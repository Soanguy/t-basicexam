    numberalign=2,
    numberbgcolor=lightthemecolor,
    titlebgcolor=white,
    bodybgcolor=white,
    headerbgcolor=transparentcolor,
    numbercolor=white,
    titlecolor=lightthemecolor,
    framecolor=lightthemecolor,
    numberframecolor=lightthemecolor,
    titleframecolor=lightthemecolor,
    numberframe=1,
    titleframe=1,
    leftframe=1,
    rightframe=1,
    topframe=1,
    bottomframe=1,
    numberratio=1,
    titleratio=1,
    rulethickness=1.5pt,
    radius=0pt,
    bodybackground=simple,
    headerdivider=0,
    % symbol=,
    % character=,
    % shadowcolor=,
    % number=, 
    % title=,
]

\definebar[underround] [undergraphic]
  [mp=rules:under:round,
   rulethickness=1.2,
   offset=0,
   order=background,
   continue=yes,
