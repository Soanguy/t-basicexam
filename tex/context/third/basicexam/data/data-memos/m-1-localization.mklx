\setuplanguage  [hant] [date={\v!year,年,mm,月,dd,日},
            leftsentence=——,      rightsentence=——,
         leftsubsentence=——,   rightsubsentence=——,
           leftquotation=『,     rightquotation=』,
               leftquote=「,         rightquote=」,
            leftnotemark=(,      rightnotemark=),]
\setuplabeltext [hant]
                [content={目錄},            page={第,頁},
                   index={索引},        appendix={附錄},
                   table={表},           tables={表},
                  figure={圖},          figures={圖},
                 graphic={圖},          graphics={圖},
            marginfigure={圖},        totalpage={共,頁},
                 preface={前言},
                 january={一月},        february={二月},
                   march={三月},           april={四月},
                     may={五月},            june={六月},
                    july={七月},          august={八月},
               september={九月},         october={十月},
                november={十一月},      december={十二月},
             monday:mnem={週一},    tuesday:mnem={週二},
          wednesday:mnem={週三},   thursday:mnem={週四},
             friday:mnem={週五},   saturday:mnem={週六},
             sunday:mnem={週日},
        reference:figure={圖~,\refsymbol},
         reference:table={表~,\refsymbol},
          reference:page={第,頁\refsymbol},
       reference:chapter={第,章\refsymbol},
       reference:section={第,节\refsymbol},
       reference:theorem={定理~,\refsymbol},
         reference:lemma={引理~,\refsymbol},
     reference:corollary={推論~,\refsymbol},
