\def\mm@ifprovided_setlang#1#2#3{%
  \ifcsname \??module\s!memos #2\endcsname% 如果 module 定义了，就用 module
    \expandafter#3\expandafter[\csname \??module\s!memos #2\endcsname]%
  \else% 否则就用当前语言预定义的设置
    \ifcsname mm@lang_#1setup_#2\endcsname
      \expandafter#3\expandafter[\csname mm@lang_#1setup_#2\endcsname]%
    \fi
  \fi
}

\tolerant\permanent\protected\def\defineuserlanguage[#S#1]#*[#S#2]%
   {\getparameters[mm@lang_#1setup_][#2]%
    \startsetups[mm@lang_#1setup]
      \ifhmode
        \mm@ifprovided_setlang{#1}{bodyfont}\switchtobodyfont
      \else
        \mm@ifprovided_setlang{#1}{before}\gobbleoneoptional
        \mm@ifprovided_setlang{\currentlanguage}{script}\setscript
        \localinterlinespacetrue
        \push_macro_currentinterlinespace
        \ifcsname \??module mm@fallbackfont\endcsname% 回退字体一旦确定，就无法轻易修改。所以目前只支持一次性设置
          \expandafter\setups\expandafter[fallback:\csname \??module\s!memos fallbackfont\endcsname]%
        \else
          \expandafter\setups\expandafter[fallback:\csname mm@lang_#1setup_fallbackfont\endcsname]%
        \fi
        \pop_macro_currentinterlinespace
        \localinterlinespacefalse
        \mm@ifprovided_setlang{#1}{bodyfont}\setupbodyfont
        \mm@ifprovided_setlang{#1}{interlinespace}\setupinterlinespace
        \mm@ifprovided_setlang{#1}{align}\setupalign
        \mm@ifprovided_setlang{#1}{indenting}\setupindenting
        \mm@ifprovided_setlang{#1}{whitespace}\setupwhitespace
        \mm@ifprovided_setlang{#1}{after}\gobbleoneoptional
      \fi
    \stopsetups
    \setuplanguage[#1][setups={mm@lang_#1setup}]%
    }

\defineuserlanguage[hans][
  bodyfont={wenyuanhanslite,11pt},
  fallbackfont=modern,
  script=custom,
  interlinespace=CJK,
  whitespace=miniflex,
  align={granular,lesswidows,lessclubs,lessorphans},
  indenting={first,always,2em},]

\defineuserlanguage[hant][
  bodyfont={modern,11pt},%ipaexhant,
  fallbackfont=modern,
  script=custom,
  interlinespace=CJK,
  whitespace=miniflex,
  align={granular,lesswidows,lessclubs,lessorphans},
  indenting={first,always,2em},]

\defineuserlanguage[ja][
  bodyfont={kozuka,11pt},%ipaexnihon,
  fallbackfont=modern,
  script=custom,
  interlinespace=CJK,
  whitespace=miniflex,
  align={granular,lesswidows,lessclubs,lessorphans},
  indenting={first,always,1em},]

\let\setupuserlanguage\defineuserlanguage

\setuplanguage  [hans]
                [   date={\v!year,年,mm,月,dd,日},
            leftsentence=——,       rightsentence=——,
         leftsubsentence=——,    rightsubsentence=——,
           leftquotation=『,      rightquotation=』,
               leftquote=「,          rightquote=」,
             leftnotemark=(,       rightnotemark=),]
             
\setuplanguage  [hant] [date={\v!year,年,mm,月,dd,日},
            leftsentence=——,      rightsentence=——,
         leftsubsentence=——,   rightsubsentence=——,
           leftquotation=『,     rightquotation=』,
               leftquote=「,         rightquote=」,
            leftnotemark=(,       rightnotemark=),]
            
\setuplanguage  [ja]  [\c!date={西暦,\v!year,年,mm,月,dd,日},
                  leftsentence=——,    rightsentence=——,
               leftsubsentence=——, rightsubsentence=——,
                 leftquotation=『,   rightquotation=』,
                     leftquote=「,       rightquote=」,
                  leftnotemark=(,    rightnotemark=),]

\mainlanguage        [\moduleparameter{memos}{mainlanguage}]
\language            [\moduleparameter{memos}{language}]
% \setupinterlinespace [stretch=0.03, shrink=0.03]%设置一个比较小的值来合理的拉伸页面。避免过于空白的分页出现。height 的 align 必须设置该参数。

\setupkanjiskip[
    yshift      = 0.00,
    % zhpunc 盘古之白（CJK-西文）
    halfwidth   = 0.25,
    halfstretch = 0.10, % 最大拉伸到 0.35em
    halfshrink  = 0.10, % 最小压缩到 0.15em
    % zhpunc kanjiskip（CJK-CJK 备用，width=0 时 stretch/shrink 不生效）
    width       = 0.00,
    stretch     = 0.10,
    shrink      = 0.10,
    %% scrp-cjk 汉字间距（CJK-CJK 主路）
    % intercharhalfstretch    = 0.10,
    % intercharhalfshrink     = 0.10,
    % intercharquarterstretch = 0.05,
    % intercharquartershrink  = 0.05,
    % intercharhangulpenalty  = 50,
]

\setupdelimitedtext  [quotation]   [language=local,location=paragraph]
\setupdelimitedtext  [quotation:1] [\c!left  =\symbol[leftquotation],
                                    \c!right =\symbol[rightquotation]]
\setupdelimitedtext  [quotation:2] [\c!left  =\symbol[leftquote],
                                    \c!right =\symbol[rightquote]]

% 只为中文设置，或许我们应该也为西文设置
\definedelimitedtext [book]        [location=text,language=local]
\setupdelimitedtext  [book:1]      [left=《,right=》]
\setupdelimitedtext  [book:2]      [left=〈,right=〉]

% 只为中文设置，可以接受 正负数字，范围为 ±8，超出范围回退到 11bp
\tolerant\def\zihao#*[#1]{\ifhastoks{-}{#1}\mm@zihaominus{#1}\else\mm@zihaoplus{#1}\fi}

\def\mm@zihaoplus#1{%
  \ifcase\numexpr#1\relax
    \switchtobodyfont[42bp]\or\switchtobodyfont[26bp]\or
    \switchtobodyfont[22bp]\or\switchtobodyfont[16bp]\or
    \switchtobodyfont[14bp]\or\switchtobodyfont[10.5bp]\or
    \switchtobodyfont[7.5bp]\or\switchtobodyfont[5.5bp]\or
    \switchtobodyfont[5bp]\else\switchtobodyfont[11bp]\fi}

\def\mm@zihaominus#1{%
  \ifcase\numexpr0-(#1)\relax
    \switchtobodyfont[36bp]\or\switchtobodyfont[24bp]\or
    \switchtobodyfont[18bp]\or\switchtobodyfont[15bp]\or
    \switchtobodyfont[12bp]\or\switchtobodyfont[9bp]\or
    \switchtobodyfont[6.5bp]\else\switchtobodyfont[11bp]\fi}