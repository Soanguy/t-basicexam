%D \module
%D   [     file=t-zhpunc,
%D      version=2022-10-29,
%D        title=zhpunc,
%D     subtitle=Chinese punctuation support,
%D       author=黄复雄(Huang Fusyong),
%D         date=2022-10-29,
%D    copyright=黄复雄(Huang Fusyong),
%D      license=GNU GPL 2.0,
%D          url=https://github.com/Fusyong/zhpunc]
% 设置模块
% pattern: quanjiao, kaiming, banjiao, yuanyang
% spacequad: 加空的角数基准（0.5）
% hangjian: false, true
% debug: false, true (调试标点处理)
\ctxlua{require("t-zhpunc.lua")}

% 行左专名号和书名号
\startuseMPgraphic{rules:under:zhuanming}
    numeric head; head := 2; 
    draw ((0,RuleDepth) -- (RuleWidth-head*2,RuleDepth))
        shifted (head,RuleFactor*RuleOffset)
        % dashed dashpattern(on RuleFactor/2 off RuleFactor/2)
        withpen pencircle scaled RuleThickness
        withcolor RuleColor ;
    setbounds currentpicture to unitsquare xysized(RuleWidth,RuleHeight) ;
\stopuseMPgraphic

\startuseMPgraphic{rules:under:shuming}
    numeric head; head := 2; 
    draw curvedfunction("x","0.4sin(2x)",0,RuleWidth-head*2,pi/100)
        shifted (head,RuleFactor*RuleOffset)
        % dashed dashpattern(on RuleFactor/2 off RuleFactor/2)
        withpen pencircle scaled RuleThickness
        withcolor RuleColor ;
    setbounds currentpicture to unitsquare xysized(RuleWidth,RuleHeight) ;
\stopuseMPgraphic

\definebar[zhuanmh] [mp=rules:under:zhuanming, offset=-.3, order=background, continue=yes] % method=0,
\definebar[shumh]   [zhuanmh][mp=rules:under:shuming, offset=-.1]

% 用户扩展符号类别接口

% 定义新的符号类别
% #1: 类别名
% #2: 参数（布尔可用 yes/no/true/false）
%     - spacebefore:   前加空角数（0, 0.5, 1 等）
%     - spaceafter:    后加空角数（0, 0.5, 1 等）
%     - protrudeleft:  行首凸排
%     - protruderight: 行尾凸排
%     - forbidstart:   行首禁排
%     - forbidend:     行尾禁排
%     - quad:          占位角数：如果是西文标点，建议设置为 0
%                        0   = 原样输出，不做 kern 压缩，保留字体原始宽度
%                        0.5 = 半角占位（默认标点行为）
%                        1   = 全角占位
%                        2   = 双倍角宽（以此类推）
\unexpanded\def\definepuncs[#1][#2]{\ctxlua{thirddata.zhpunc.define_class([==[#1]==], [==[#2]==])}}

% 添加符号到类别
% #1: 类别名
%     预定义类别:
%       - left:    左半标号（禁止行尾，行首凸排）
%       - right:   右半标号（禁止行首，行尾凸排）
%       - inner:   句内点号（禁止行首）
%       - ending:  句末点号（禁止行首）
%     用户定义类别:  使用 \definepuncs 定义的类别名
% #2（花括号）: 符号字符串（如 ☆★☆○）
\unexpanded\def\addtopuncs[#1]#2{\ctxlua{thirddata.zhpunc.add_to_class([==[#1]==], [==[#2]==])}}

% 从所有类别移除符号（凸排、行间、旋转、加空等一并移除）
% #1（花括号）: 符号字符串
\unexpanded\def\removefrompuncs#1{\ctxlua{thirddata.zhpunc.remove_from_class([==[#1]==])}}

% 设置符号的特殊行为
% #1（方括号参数；布尔可用 yes/no/true/false）:
%     - class:         归类为指定类别（left/right/…，或自定义类别）
%     - hangjian:      行间标点
%     - rotate:        竖排旋转
%     - protrudeleft:  行首凸排
%     - protruderight: 行尾凸排
%     - forbidstart:   行首禁排
%     - forbidend:     行尾禁排
%     - quad:          占位角数：如果是西文标点，建议设置为 0
%                        0   = 原样输出，不做 kern 压缩，保留字体原始宽度
%                        0.5 = 半角占位（默认标点行为）
%                        1   = 全角占位
%                        2   = 双倍角宽（以此类推）
%     - spacebefore:   前加空角数（0.5, 1 等）
%     - spaceafter:    后加空角数（0.5, 1 等）
% #2（花括号）: 符号字符串
\unexpanded\def\setuppunc[#1]#2{\ctxlua{thirddata.zhpunc.setup_chars([==[#2]==], [==[#1]==])}}

\unexpanded\def\enablezhpunc {\par\ctxlua{thirddata.zhpunc.enable()}}
\unexpanded\def\disablezhpunc{\par\ctxlua{thirddata.zhpunc.disable()}}

% 键值设置命令：\setupzhpunc[pattern=..., spacequad=..., hangjianshift=..., hangjian=..., debug=...]
% 可在加载后随时调用覆盖；模块加载时亦支持 \usemodule[zhpunc][key=value] 指定。
\unexpanded\def\setupzhpunc[#1]{\ctxlua{thirddata.zhpunc.set([==[#1]==])}}

\setupzhpunc[%用于支持可以通过 module 直接设置
      pattern=\currentmoduleparameter{pattern},
    spacequad=\currentmoduleparameter{spacequad},
hangjianshift=\currentmoduleparameter{hangjianshift},
     hangjian=\currentmoduleparameter{hangjian},
        debug=\currentmoduleparameter{debug},
]

% 在指定位置（\everystarttext）插入/应用命令
\appendtoks 
  \ctxlua{thirddata.zhpunc.append()}%
\to \everystarttext

% 示例: 让 · 行首禁排、行尾禁排以及不凸排。
\definepuncs[center][forbidstart=true, forbidend=true, quad=0]
\addtopuncs [center]{·}

\definepuncs[forbidstartnotpunc][forbidstart=true, quad=0, punc=false]
\addtopuncs [forbidstartnotpunc]{,:;.!?/°′″℃¢‰ℓぁぃぅぇぉっゃゅょゎゕゖァィゥェォッャュョヮヵヶ}

\definescript [custom] [method=hanzi, preset=custom]
\def\setupkanjiskip[#1]{\ctxlua{thirddata.zhpunc.setdataset("hanzi", "custom", {#1})}}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%                             本地化設置                              %%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\installlanguage [hans] [patterns={zh,us},]% install simplified  chinese
\installlanguage [hant] [patterns={zh,us},]% install traditional chinese
\input type-bak-fallbacks.mkiv
\definebodyfontenvironment [default] [em=boldface]
\pushoverloadmode
\permanent\protected\def\emphasisboldface{\bi}
\popoverloadmode
%%%%%%%% \section {設置 語言 字體 行高等}
\setuplanguage  [hans]
                [   date={\v!year,年,mm,月,dd,日},
            leftsentence=——,       rightsentence=——,
         leftsubsentence=——,    rightsubsentence=——,
           leftquotation=『,      rightquotation=』,
               leftquote=「,          rightquote=」,
             leftnotemark=(,       rightnotemark=),]
\setuplabeltext [hans]
                [content={目录},            page={第,页},
                   index={索引},        appendix={附录},
                   table={表},           tables={表},
                  figure={图},          figures={图},
                 graphic={图},         graphics={图},
            marginfigure={图},             text={参见：,},
                 preface={前言},       totalpage={共,页},
                 january={一月},        february={二月},
                   march={三月},           april={四月},
                     may={五月},            june={六月},
                    july={七月},          august={八月},
               september={九月},         october={十月},
                november={十一月},      december={十二月},
             monday:mnem={周一},    tuesday:mnem={周二},
          wednesday:mnem={周三},   thursday:mnem={周四},
             friday:mnem={周五},   saturday:mnem={周六},
             sunday:mnem={周日},
        reference:figure={图~,\refsymbol},
         reference:table={表~,\refsymbol},
          reference:page={第,页\refsymbol},
       reference:chapter={第,章\refsymbol},
       reference:section={第,节\refsymbol},
       reference:theorem={定理~,\refsymbol},
