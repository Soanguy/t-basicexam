%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%                              目錄相關設置                           %%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%parameter of aleternative:
%- a = number – title –          page number
%- b = number – title – spaces – page number
%- c = number – title – dots   – page number
%- d = number – title          – page number (continuing)
%- e = reserved for interactive purposes
%- f = reserved for interactive purposes
\setuplist  [title,subject,subsubject,subsubsubject,
             part,chapter,section,subsection,subsubsection,
             subsubsection,subsubsubsection,subsubsubsubsection]
            [color=toccolor,style={\feature[+][tabularnumbers]}]
\setuphead  [title,subject][incrementnumber=list]
\definehead [tochead]      [title]
            [placehead=yes,page=right,incrementnumber=no,
             before=\null\vskip2\baselineskip\relax,
             after=\vskip\baselineskip\relax,
             header=stop,]

% \section{TOC: style}
\define[3]\mms_partlabel_default%
          {\framed[align=center,
                    width=max,
                    frame=off,
                    foregroundstyle=bfa,
                    foregroundcolor=themecolor]{%
                      {第\ #1\ 编}\hbox to 1em{ } #2}}

\startsetups memos:toc:default
  \edef\currenttocstyle{default}
  \setupcombinedlist[content][
    list={part,%
          title,subject,
          chapter,section,
          subsubject,subsection,
          subsubsubject,subsubsection,
          subsubsubsection,subsubsubsubsection}]
  \setuplist  [part,chapter,section,
               subsection,subsubsection,subsubsection,
               subsubsubsection,subsubsubsubsection]
              [width=3.5em,distance=.5em,margin=1.0em,
               alternative=c,align=flushright
               before=,after=,label=yes,numberalign=flushright]
  \setuplist  [part]
              [command=\mms_partlabel_default,alternative=interactive,before=\blank]
  \setuplist  [title]              [margin=1.0em,style=bf]
  \setuplist  [subject]            [margin=2.0em]
  \setuplist  [chapter]            [margin=0.0em,style=bf,before=\blank[quarterline]]
  \setuplist  [section]            [width=3.5em]
  \setuplist  [subsection]         [width=4.5em]
  \setuplist  [subsubsection]      [width=5.5em]
  \setuplist  [subsubsubsection]   [width=6.5em]
  \setuplist  [subsubsubsubsection][width=7.5em]
\stopsetups

\startsetups memos:toc:simple
  \edef\currenttocstyle{simple}
  \setupcombinedlist[content][list={part,%
               title,chapter,subject,section,
               subsubject,subsection,
               subsubsubject,subsubsection,
               subsubsubsection,subsubsubsubsection
               }]
  \setuplist  [part,chapter,section]
              [width=1.0em,margin=0.0em,distance=.5em]
  \setuplist  [section,subject,subsection,subsubsection,
               subsubsection,subsubsubsection,subsubsubsubsection]
              [width=1.0em,distance=.5em,alternative=c,margin=2.0em,]
  \setuplist  [title]              [margin=1.5em]
  \setuplist  [subject]            [margin=2.5em]
  \setuplist  [part]               [width=2.0em,margin=1.0em,
                                    pagenumber=no,headnumber=no,
                                    style=ss,after=]
  \setuplist  [chapter]            [margin=0.0em,before=,]
  \setuplist  [section]            [width=1.0em]
  \setuplist  [subsection]         [width=2.0em]
  \setuplist  [subsubsection]      [width=3.0em]
  \setuplist  [subsubsubsection]   [width=4.0em]
  \setuplist  [subsubsubsubsection][width=5.0em]
\stopsetups

\let\mms_partlabel_line\undefined
\define[1]\parenpage{\hskip-.5\emwidth\relax(#1)}
\define[1]\mms_partlabel_line{{\sc\color[themecolor]{\hbox to 2.5em{Part} \ss\tfa #1}\ }}
\define[1]\mms_chaplabel_line{{\sc\color[themecolor]{\hbox to 2.5em{Chap} \ss\tfa #1}\ }}
\startsetups memos:toc:line
  \edef\currenttocstyle{line}
  \setupcombinedlist[content]
    [list={part,title,chapter,subject,
      section,subsubject,subsection,}]
  \setuplist  [part,chapter]
              [width=4.5em,margin=0.0em,distance=.0em]
  \setuplist  [section,subject,subsection]
              [width=0.0em,distance=.5em,alternative=c,]
  \setuplist  [part]      [numbercommand=\mms_partlabel_line,after=]
  \setuplist  [chapter]   [numbercommand=\mms_chaplabel_line,before=]
  \setuplist  [title]     [margin=4.5em]
  \setuplist  [subject]   [margin=5.5em]
  \setuplist  [section]   [margin=3.5em]
  \setuplist  [subsection][margin=4.5em,alternative=d,pagecommand=\parenpage]
\stopsetups

\startsetups memos:toc:madsen
  \edef\currenttocstyle{madsen}
  \setuphead  [tochead] [alternative=madsentoc]
  \setupcombinedlist[content][list={part,title,chapter,subject,section}]
  \setuplist  [chapter,section]
                          [width=1.0em,distance=.5em,before=]
  \setuplist  [part,subsection,subsubsection,subsubsection,
               subsubsubsection,subsubsubsubsection]
                          [width=0.0em,distance=.5em,headnumber=no]
  \setuplist  [part]      [margin=1.0em,color=themecolor,style=ss,
                           headnumber=no,pagenumber=no,after=]
  \setuplist  [title]     [margin=1.5em,color=themecolor,style=\ss]
  \setuplist  [chapter]   [margin=0.0em,color=themecolor,style=\ss]
  \setuplist  [subject]   [margin=3.0em,style=\tt]
  \setuplist  [section]   [margin=1.5em,style=\tt]
  \setuplist  [subsection]         [margin=2.5em]
  \setuplist  [subsubsection]      [margin=3.5em]
  \setuplist  [subsubsubsection]   [margin=4.5em]
  \setuplist  [subsubsubsubsection][margin=5.5em]
\stopsetups

\startsetups memos:toc:colorful
  \edef\currenttocstyle{colorful}
  \startuseMPgraphic{MP:toc}
      numeric width , height ;
      width  = \overlaywidth ;
      height = \overlayheight ;
      numeric textwidth , textheight ;
      txtwidth  := .3*\overlaywidth  ;
      txtheight := \overlayheight ;
      path paper_back ;%%% i
      paper_back  := fullsquare xscaled width yscaled height ;
      fill paper_back withcolor \MPcolor{softthemecolor} ;
      path text_back ;%%% ii
      text_back := fullsquare xscaled txtwidth yscaled txtheight;
      fill text_back shifted(-.35width,0) withcolor \MPcolor{lightthemecolor} ;
  \stopuseMPgraphic
  \defineoverlay   [olay:toc][\useMPgraphic{MP:toc}]
  \setuplabeltext  [cn]  [content=Table Of Contents]
  \setuplabeltext  [hans][content=Table Of Contents]
  \setuplabeltext  [hant][content=Table Of Contents]
  \setuphead       [tochead][
                    before={\setupbackgrounds[page][background=olay:toc]
                            \null\vskip5\baselineskip\relax},
                    after=\null\vskip2\baselineskip\relax,
                    align=center,
                    style=\definedfont[SansBold at 25pt],
                    ]
  \setupcombinedlist[content][list={part,title,chapter,subject,section}]
  \setuplist  [part,chapter,section,title,subject]
                          [width=\backspace,distance=0em,,style=\ss,
                           numbercolor=white,numberalign=flushright]
  \setuplist  [part]      [numbercommand=\groupedcommand{\sc Part\ \tf}{\hskip4em},after=,color=darkthemecolor]
  \setuplist  [chapter]   [numbercommand=\groupedcommand{}{\hskip4em},color=themecolor,before=]
  \setuplist  [title]     [margin=\backspace,color=themecolor,style=it]
  \setuplist  [subject]   [margin=\dimexpr\backspace+1em\relax,style=it]
  \setuplist  [section]   [margin=\dimexpr\backspace+1em\relax,headnumber=no]
\stopsetups

\startsetups memos:toc:classicnovel
  \edef\currenttocstyle{classicnovel}
  \setupcombinedlist[content][list={part,title,chapter}]
  \setuplist        [part,chapter,title,][label=yes,after=,style=]
  \setuplist        [chapter][before=,]
  \setuplist        [title]  [margin=5em]
\stopsetups

\define[3]\mms_chaplabel_classics{\hbox to 1tw{#2第#1\hfill #3}}
\startsetups memos:toc:classics
  \edef\currenttocstyle{classics}
  \setuplist [chapter] [alternative=interactive,command=\mms_chaplabel_classics]
\stopsetups

\startsetups memos:toc:rocket
  \edef\currenttocstyle{rocket}
  \setuphead       [tochead][alternative=middle,before=\null\vskip2\baselineskip\relax]
  \setupcombinedlist[content][list={part,title,chapter,section,subject}]
  \setuplist       [part,chapter,title,subject,section]
                                    [before=,after=,style=ss,distance=.5em,
                                     numberalign=flushright]
  \setuplist       [part]           [width=2.5em,numbercommand=,
                                     color=themecolor,before=\blank]
  \setuplist       [chapter,title]  [width=2.5em,color=themecolor,
                                     style=\ssbf,numberconversion=R]
  \setuplist       [title]          [margin=3.0em,style=\ssbf\sc]
  \setuplist       [section]        [margin=3.5em,headnumber=no]
  \setuplist       [subject]        [margin=4.0em]
\stopsetups

\startsetups memos:toc:hexa
  \edef\currenttocstyle{hexa}
  \setupcombinedlist[content][list={part,%
                     title,chapter,subject,section,
                     subsubject,subsection,
                     subsubsubject,subsubsection,
                     subsubsubsection,subsubsubsubsection}]
  \setuphead       [tochead][alternative=paragraph,align=flushright,
                             before=\null\vskip2\baselineskip\relax]
  \setuplist       [part]   [align=center,,style=bfa,
                             pagenumber=no,headnumber=no
                             before=\null\vskip\baselineskip\relax]
  \setuplist       [title]  [margin=2.0em]
  \setuplist       [subject][margin=3.0em]
  \setuplist       [chapter][width=1.5em,distance=0.5em]
  \setuplist       [section][margin=0.5em,width=1.5em,alternative=c]
  \setuplist       [subsubject,subsection,
                    subsubsubject,subsubsection,
                    subsubsubsection,subsubsubsubsection]
                            [width=fit,distance=0.5em,alternative=c]
  \setuplist  [subsection]         [margin=1.0em]
  \setuplist  [subsubsection]      [margin=1.5em]
  \setuplist  [subsubsubsection]   [margin=2.0em]
  \setuplist  [subsubsubsubsection][margin=2.5em]
\stopsetups

\startsetups memos:toc:kaolike
  \edef\currenttocstyle{kaolike}
  \setupcombinedlist[content][list={part,%
               title,chapter,subject,section,
               subsubject,subsection,
               subsubsubject,subsubsection,
               subsubsubsection,subsubsubsubsection
               }]
  \setuplist  [part,chapter,section]
              [width=1.0em,margin=0.0em,distance=.5em]
  \setuplist  [section,subject,subsection,subsubsection,
               subsubsection,subsubsubsection,subsubsubsubsection]
              [width=1.0em,distance=.5em,alternative=c,margin=2.0em,]
  \setuplist  [title]              [margin=1.5em,style=bf]
  \setuplist  [subject]            [margin=2.5em]
  \setuplist  [part]               [width=2.0em,margin=1.0em,
                                    headnumber=no,style=\feature[+][f:caps]\bf,
                                    before=\blank[3*halfline],after=,]
  \setuplist  [chapter]            [margin=0.0em,before=\blank[halfline],style=bf]
  \setuplist  [section]            [width=2.0em]
  \setuplist  [subsection]         [width=3.0em,margin=3.0em]
  \setuplist  [subsubsection]      [width=3.0em,margin=3.0em]
  \setuplist  [subsubsubsection]   [width=4.0em,margin=4.0em]
  \setuplist  [subsubsubsubsection][width=4.0em,margin=4.0em]
\stopsetups

\startsetups memos:toc:novel
  \setupheader[state=stop]
  \setupcombinedlist[content][list={chapter}]
  \setuplist[chapter][headnumber=no,margin=.25tw,textstyle=\ssa,pagestyle=\tta,color=darkblue]
  \setupheadtext[content=\hbox to .5tw{I\hfil N\hfil D\hfil E\hfil X}]
  \setupbackgrounds[paper][background=color,backgroundcolor=softred,state=start]
  \vbox to 1th{%
    \leftskip.25tw\rightskip.25tw\relax
    \leavevmode\vfill
      \completecontent
    \vfill}
\stopsetups

\startsetups memos:toc:novelnew
  \setupindenting[none]
  \setupbackgrounds   [paper][background=color,backgroundcolor=softthemecolor,state=start]
  \setupcombinedlist  [content][list={chapter}]
  \setuplist[chapter] [headnumber=no,margin=.25tw,
                      textstyle=\ssa,pagestyle=\tta,
                      color=darkblue]
  \setupheadtext      [content=\hbox to .5tw{I\hfil N\hfil D\hfil E\hfil X}]
  \setupheader        [state=stop]
  \setuphead          [title] [style=ttd,color=darkblue]
  \vbox to 1th{%
    \leftskip.25tw\rightskip.25tw\relax
    \vskip-6\baselineskip
    \leavevmode\vfill
    \completecontent
    \vfill}
\stopsetups

  \define[3]\SectionListEntrySimple
    {\par \leftaligned\bgroup
      \hbox to 2em{\color[themecolor]{\ttd #3}}%
          \hskip   1em
          \vtop{\hsize\dimexpr\textwidth-3em\relax\color[contentchapc]{\ssb #2}}
    \egroup \par}

\startsetups memos:toc:simplenovel
  \setupindenting[none]
  \definecolor[contentcolor][h=262C30]
  \definecolor[contentchapc][h=F7FCFD]
  \setupbackgrounds [paper][background=color,backgroundcolor=contentcolor,state=start]
  \setupcombinedlist[content][list={chapter}]
  \setupheader  [state=stop]
  \setuphead    [tochead] [style=ttd,color=darkblue]
  \setupheadtext[content=\hbox to .5tw{I\hfil N\hfil D\hfil E\hfil X}]
  \setuplist    [chapter][headnumber=no,alternative=command,command=\SectionListEntrySimple]
  \vbox to 1th{
    \leavevmode\vfill
    \framed[frame=off,foregroundstyle=\ssd,
            align=flushright,orientation=90,
            height=1tw]{\vfill\par
            \color[contentchapc]{TABLE OF}
            \blank[halfline]
            \definedfont[SansBold at 60pt]%
            \color[themecolor]{CONTENTS}}
    \vskip 2\baselineskip\relax
    \setupinterlinespace[line=30pt]
    \placecontent
  }
\stopsetups

\define[3]\ChapterListEntryDesign
  {\par \leftaligned\bgroup
  \vtop{\hsize\dimexpr\textwidth-3em\relax
  \framed[foregroundstyle=\rmb\bf,
          frame=off,bottomframe=on,
          align=flushleft,
          width=max,
          rulethickness=4pt]{#2}}
  \egroup \par}
\define[3]\SectionListEntryDesign
  {\par \leftaligned\bgroup
    \hbox to 2em{\color[themecolor]{\tta #3}}%
        \vtop{\hsize\dimexpr\textwidth-3em\relax\color[contentchapc]{\ss #2}}
  \egroup \par}

\startsetups memos:toc:design
  \setupindenting[none]
  \setupbackgrounds [paper][background=color,backgroundcolor=softthemecolor,state=start]
  \setupcombinedlist[content][list={chapter,section}]
  \setupheader  [state=stop]
  \setuphead    [tochead] [style=ttd,color=darkblue]
  \setupheadtext[content=\hbox to .5tw{I\hfil N\hfil D\hfil E\hfil X}]
  \setuplist    [chapter][headnumber=no,alternative=command,command=\ChapterListEntryDesign]
  \setuplist    [section][headnumber=no,alternative=command,command=\SectionListEntryDesign]
  \framed[frame=off,foregroundstyle=\rmd,
          align=flushright,]{
          \definedfont[SerifBoldItalic at 40pt]%
          \color[darkgray]{TABLE OF}
          \blank[halfline]
          \color[themecolor]{CONTENTS}}
    \vskip 2\baselineskip\relax
    \setupinterlinespace[line=22pt]
    \startcolumns[n=2]
    \placecontent
    \stopcolumns
\stopsetups

  \define[3]\ChapterListEntryDesignNew
    {\par \leftaligned\bgroup
    \vtop{\hsize\dimexpr\textwidth-3em\relax
    \framed[foregroundstyle=\rmb\bf,
            frame=off,bottomframe=on,
            align=flushleft,
            width=max,
            rulethickness=4pt]{#3}\par
    \framed[foregroundstyle=\rmb\bf,
            frame=off,
            align=flushleft]{#2}}
    \egroup \par}
  \define[3]\SectionListEntryDesignNew
    {\par\hbox\bgroup
      \hbox to 2em{\color[themecolor]{\tta\hfill #3\hfill}}%
      \vtop{\hsize\dimexpr\textwidth-2em\relax\ss #2}
    \egroup\par}

\startsetups memos:toc:designnew
  \setupindenting[none]
  \setupbackgrounds [paper][background=color,backgroundcolor=softthemecolor,state=start]
  \setupcombinedlist[content][list={chapter,section}]
  \setupheader  [state=stop]
  \setuplist    [chapter][headnumber=no,alternative=command,command=\ChapterListEntryDesignNew]
  \setuplist    [section][headnumber=no,alternative=command,command=\SectionListEntryDesignNew]
  \framed[frame=off,foregroundstyle=\rmd,
          align=flushleft,]{
          \definedfont[playfairhairlinebolditalic at 40pt]%
          \color[darkgray]{Table of}
          \blank[halfline]
          \definedfont[playfairhairlinebolditalic at 60pt]
          \color[themecolor]{Contents}}
    \vskip 2\baselineskip\relax
    \setupinterlinespace[line=22pt]
    \startcolumns[n=2]
    \placecontent
    \stopcolumns
\stopsetups

%\section{SCMD:placeTOCs}
\tolerant\def\setupTOCs[#1]%
  {\getparameters[??TOCs][#1]}

\setupTOCs[%#1 to set lists,#2 to set tochead
  alternative=,%
  interlinespace=1.5em,
  title=\labeltext{content},
  placetitle=yes,
  setups=yes,
  layout=moderate,]

\tolerant\def\placeTOCs[#1]{\begingroup%
  \iffirstargument\getparameters[??TOCs][#1]\fi%
  \edef\currenttocstyle{\ifempty\??TOCsalternative\currenttocstyle\else\??TOCsalternative\fi}%
  \edef\p_title{\??TOCstitle}%
  \setups{memos:toc:\currenttocstyle}%
  \doifinsetelse{\namedheadparameter{tochead}\c!page}{no,disable}%
     {}{\startlayout[\??TOCslayout]}%
  \doif{\??TOCsplacetitle}{yes}{%
    \expandafter\expandafter\expandafter\tochead\expandafter{\p_title}}%
  \setuplocalinterlinespace[line=\??TOCsinterlinespace]%
  \doifelse{\??TOCssetups}{yes}{\placecontent}{\setups{\??TOCssetups}}%
  \stoplayout
  \page[\namedheadparameter{tochead}\c!page]%
  \endgroup}

% \placeTOCs[placetitle=no,setups=memos:toc:novel]
% \placeTOCs[placetitle=no,setups=memos:toc:novelnew]
% \placeTOCs[placetitle=no,setups=memos:toc:simplenovel]
% \placeTOCs[placetitle=no,setups=memos:toc:design]
% \placeTOCs[placetitle=no,setups=memos:toc:designnew]

\definemargindata   [outermargin] [outer]
\definemarginframed [outermargin] [outer]
\setupmargindata    [outermargin] [margin=margin,width=\outermarginwidth,align=inner,]
\setupmarginframed  [outermargin] [margin=margin,width=\outermarginwidth,align=inner,]


%%%%%%%%%%%%%%%%%%%%
% \section {Header and Footer Style}
% Pair 1: hdr:odd:sectionmark & hdr:even:chaptermark
%         PageNumber Section 3 : Section Title
%         Chapter 3 : Chapter Title PageNumber
\startsetups hdr:odd:sectionmark
  \framed[frame=off,bottomframe=on,
          align=low,
          height=\headerheight,width=max]
         {\ifdone\rm\userpagenumber  \quad\fi
          \ifzeronum\namedheadnumber{section}\relax
          \else%\limitatetext{}{10cm}{...}
          \hw  \ifdone\else\getmarking[sectionnumber]\quad\fi
               \getmarking[section]\fi}
\stopsetups
\startsetups hdr:even:chaptermark
  \framed[frame=off,bottomframe=on,
          align={flushright,low},
          height=\headerheight,width=max]
         {\ifzeronum\namedheadnumber{chapter}\relax
          \else
          %\limitatetext{}{10cm}{...}
          \hw \ifdone\else\getmarking[chapternumber]\quad\fi
                      \getmarking[chapter]
          \fi\ifdone\quad \rm\userpagenumber\fi}
\stopsetups
% Pair 2 : hdr:odd:noveltitlemark & hdr:even:novelchapmark
\startsetups hdr:odd:noveltitlemark
  \framed[frame=off,bottomframe=on,
          align=low,
          height=\headerheight,width=max]
         {\let\\\quad\hfill\getmarking[chapter]\quad\userpagenumber\par}
\stopsetups
\startsetups hdr:even:novelchaptermark
  \framed[frame=off,bottomframe=on,
          align=low,
          height=\headerheight,width=max]
         {\userpagenumber\let\\\quad \quad\getmarking[chapter] \hfill\par}
\stopsetups
% Pair 3 ：hdr:edge:structuremark
\startsetups hdr:odd:edgesectionmark
  \framed[width=max,     height=max,       foregroundstyle=\ss,
          corner=08,     location=lohi,    frame=off]
         {\hbox orientation 1 {\fetchmark[section][first]}}
\stopsetups
\startsetups hdr:odd:edgechaptermark
  \framed[width=max,     height=max,       foregroundstyle=\ss,
          corner=08,     location=lohi,    frame=off]
        {\hbox orientation 1 {\fetchmark[chapter][first]}}
\stopsetups
% Pair 4 ：hdr:edge:pagenumber
\startsetups ftr:framedpagenumber
  \vbox{\null\vfil
  \framed[width=6em,             height=2em,
          corner=00,             location=lohi,
          rulethickness=0pt,     radius=10pt,
          background=color,      backgroundcolor=themecolor,
          foreground=color,      foregroundcolor=white,]{\completepagenumber}\vfil}%
\stopsetups
% Pair 5 ：pagenumber at variant location
\startsetups hdr:center:pagenumber
  \framed[width=max,height=max,location=lohi,frame=off]
         {\completepagenumber}
\stopsetups
\startsetups hdr:left:pagenumber
  \framed[width=max,height=max,location={lohi},align={flushleft},frame=off]
         {\completepagenumber}
\stopsetups
\startsetups hdr:right:pagenumber
  \framed[width=max,height=max,location={lohi},align={flushright},frame=off]
         {\completepagenumber}
\stopsetups

\ifhdr_sty_book%
  \setupheadertexts  []
  \setupheadertexts  [\donetrue\setups [hdr:odd:sectionmark]][][]
                     [\donetrue\setups [hdr:even:chaptermark]]
\fi
\ifhdr_sty_novel%
  \setupheadertexts  []
  \setupheadertexts  [\setups [hdr:odd:noveltitlemark]][][]
                     [\setups [hdr:even:novelchaptermark]]
\fi
\ifhdr_sty_colorful%
  \setupheader     [state=stop]
  \setupheadertexts[]
  \setuptexttexts  [edge]
                [][\setups[hdr:odd:edgesectionmark]]
                  [\setups[hdr:odd:edgechaptermark]][]
  \setupfootertexts[edge]
                [][\setups[ftr:framedpagenumber]]
                  [\setups[ftr:framedpagenumber]][]
\fi
%%%%%%%%%%%%%%%%%%%
\ifhdr_sty_hctext% page number at center of header
  \setupheader        [state=start]
  \setupheadertexts
                  [\setups[hdr:center:pagenumber]][][]
                  [\setups[hdr:center:pagenumber]]
\fi
%%%%%%%%%%%%%%%%%%%
\ifhdr_sty_fctext% page number at center of footer
  \setupheader        [state=stop]
  \setupheadertexts   []
  \setupfootertexts
                  [\setups[hdr:center:pagenumber]][][]
                  [\setups[hdr:center:pagenumber]]
\fi
%%%%%%%%%%%%%%%%%%%
\ifhdr_sty_foemarginalt% doublesided page : in outermargin but closer to text area
  \setupheadertexts   []% delete middle of header
  \setupfootertexts[margin] []
                  [\setups[hdr:left:pagenumber]]
                  [\setups[hdr:right:pagenumber]][]
\fi
%%%%%%%%%%%%%%%%%%%
\ifhdr_sty_foemargin% doublesided page : page number in outermargin
  \setupheadertexts    []% delete middle of header
  \setupfootertexts[margin] []
                   [\setups[hdr:right:pagenumber]]
                   [\setups[hdr:left:pagenumber]][]
\fi
%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%
\ifhdr_sty_hoemargin%
  \setupheader [state=start]
  \startsetups [header:leftpage]
       \startalignment[flushouter]\setscript[hanzi]
       \kern-\leftmarginwidth\relax
       \color[themecolor]{\prefixedpagenumber}
       \quad% \undepthed
       {\blackrule
           [width=\linewidth,color=themecolor,
            height=\headerheight,depth=.3\baselineskip,]}%\strutht,
            %depth=\dimexpr\headerheight+\topspace\relax,
       \quad
       \color[themecolor]{\getmarking[chapternumber] \quad {\bi\getmarking[chapter]}} \hss
       \stopalignment
  \stopsetups
  \startsetups [header:rightpage]
       \startalignment[flushouter]
       \color[themecolor]{\getmarking[sectionnumber] \quad {\bi\getmarking[section]}}
       \quad% \undepthed
       {\blackrule
           [width=\linewidth,color=themecolor,
           height=\headerheight,depth=.3\baselineskip,]}%\strutht,
            %depth=\dimexpr\headerheight+\topspace\relax,
       \quad
       \color[themecolor]{\prefixedpagenumber}
       \kern-\rightmarginwidth\relax
       \stopalignment
  \stopsetups
  \setupheadertexts[]
  \setupheadertexts[text]
       [] [\directsetup{header:rightpage}]
          [\directsetup{header:leftpage}] []
\fi

\ifhdr_sty_madsen
  \setupheadertexts  []
  \setupheadertexts  [\donetrue\setups [hdr:even:chaptermark]][][]
                     [\donetrue\setups [hdr:odd:sectionmark]]
\fi

\ifhdr_sty_rocket
  \newdimen\pos_xi_hdr_margin
  \newdimen\pos_xii_hdr_margin
  \pos_xii_hdr_margin=\dimexpr\paperwidth-\textwidth-\backspace-\rightmargindistance\relax
  \pos_xi_hdr_margin=\dimexpr\textwidth+\rightmargindistance\relax
  \defineframed
    [hdrtextframed]
    [width=\pos_xi_hdr_margin,
     height=\dimexpr\topspace+\headerheight\relax,
     frame=off,bottomframe=on,
     foregroundstyle=ss,]
  
  \defineframed
    [hdrmarginframed]
    [frame=off,bottomframe=on,
     align={center,low},
     width=\pos_xii_hdr_margin,
     height=\dimexpr\topspace+\headerheight\relax,
     background=color,
     foregroundcolor=white,
     foregroundstyle=ss,]
    
  \def\hdrmarginhigh#1{\dontleavehmode\tfd\raise .8\exheight\relax\hbox {\tfx\sc #1}}
  
  \setupheadertexts[]
  
  \setupheadertexts[text][][%
     \hbox xoffset \rightmargindistance{%
      \hdrtextframed[align={outer,low},framecolor=themecolor,]
     {\hfil\getmarking[chapter]\hbox to \rightmargindistance{}}}]
     [][%
     \hbox xoffset -\rightmargindistance{%
       \hdrtextframed[align={outer,low},framecolor=optcolor,]
     {\hbox to 2\rightmargindistance{}\getmarking[section]\hfil}}]
  
  \setupheadertexts[margin][][%
     \hdrmarginframed
     [backgroundcolor=themecolor,framecolor=themecolor,]{\vfil
        \hdrmarginhigh{Chapter}\ %
        \tfd\getmarking[chapternumber]}]
     [%
     \hdrmarginframed
     [backgroundcolor=optcolor,framecolor=optcolor,]{\vfil
        \hdrmarginhigh{Section\ \getmarking[chapternumber].\,}%
        \tfd\getmarking[sectionnumber]}][]

  \setupfootertexts
    [margin]
    [][\framed[frame=off,align={center,lohi},width=\hsize,height=\footerheight]{\userpagenumber}]
    [\framed[frame=off,align={center,lohi},width=\hsize,height=\footerheight]{\userpagenumber}][]
\fi