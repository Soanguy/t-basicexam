\def\VerticalLine{\blackrules[width=0.8pt, height=\__gyoudori_areaheight{7}, depth=0cm, color=darkthemecolor, n=7, distance=1mm]\kern1mm}
\define[2]\VerticalLineChapterCommand{%
  \dontleavehmode
  \hbox{{\VerticalLine}}\kern-7mm
  \vbox to \__gyoudori_areaheight{7}{\hsize 2em
      \vfill
      \ifempty{#1}%
        \hbox to 1cm{}
      \else
        \framed[%
          background=color,
          backgroundcolor=themecolor,
          foregroundcolor=white,
          frame=off,
          width=1cm, height=1cm,
          align={center,lohi},
          offset=0pt,
        ]{#1}%
      \fi
      \vfill}\kern.5em % 数字框和标题之间的间距
  \vbox to \__gyoudori_areaheight{7}{\hsize=\dimexpr\hsize-2cm\relax\vfill #2\vfill}%
}
