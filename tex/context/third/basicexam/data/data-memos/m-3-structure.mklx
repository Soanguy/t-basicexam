\setupinteractionscreen [option=bookmark]
\placebookmarks         [part,chapter,section][chapter]
\setupinteraction       [state=start,
                         color=linkcolor,
                         contrastcolor=themecolor,
                         ]
\setupcombinedlist      [content] [interaction=all,color=toccolor]
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%                                結構相關設置                         %%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\defineconversionset  [frontpart:pagenumber] [] [Romannumerals]
\defineconversionset  [bodypart:pagenumber]  [] [n]
\setupsectionblock    [frontpart] [page=right,\c!number=\v!yes,before=\setcounter [userpage] [1]\setuplayout[reset]]
\setupsectionblock    [bodypart]  [page=right,\c!number=\v!yes,before=\setcounter [userpage] [1]\setuplayout[default]]
\setupsectionblock    [appendix]  [page=right,before={\setuphead[part][number=no,numbercommand=,placehead=yes,]}]
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%                            標題相關設置                             %%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\definepagebreak[emptyright][yes,header,footer,right]
\setupheads
           [part,chapter,section,subsection,subsubsection,
            subsubsubsection,subsubsubsubsection]
           [indentnext=yes,interlinespace=auto,]
\setuphead [part,chapter]        [page=emptyright]
\setuphead [part,chapter,title]  [header=empty,footer=empty,color=titlecolor]
\setuphead [title,subject]       [incrementnumber=list]
\setuphead [part]                [placehead=yes,
                                  numbercommand=\groupedcommand{\feature[+][f:caps] Part\ }{},
                                  commandbefore=\blank,
                                  before={\null\vfill},
                                  after={\vfill}]
\setuphead [chapter]             [frontpartlabel=preface,
                                  bodypartlabel=chapter,
                                  appendixlabel=appendix,
                                  backpartlabel=backpart,
                                  interlinespace=3\bodyfontsize,
                                  before={\null\vskip3\baselineskip\relax},
                                  after={\vskip\baselineskip\relax}]
\setuphead [part]                [style=\definedfont[Sans sa 2.488]]
\setuphead [chapter]             [style=\ssd]
\setuphead [section]             [before=\vskip1.\lineheight,after=\vskip1.\lineheight,style=\rm\bfb]
\setuphead [subsection]          [before=\vskip.7\lineheight,after=\vskip.3\lineheight,style=\rm\bfa]
\setuphead [subsubsection]       [before=\vskip.7\lineheight,after=\vskip.3\lineheight,style=\rm\bf]
\setuphead [subsubsubsection]    [before=\vskip.7\lineheight,after=\vskip.3\lineheight,style=\rm\bf]
\setuphead [subsubsubsubsection] [before=\vskip.7\lineheight,after=\vskip.3\lineheight,style=\rm\bf]
\setuphead [chapter]             [sectionsegments=chapter]
\setuphead [section]             [sectionsegments=section]
\setuphead [subsection]          [sectionsegments=subsection]
\setuphead [subsubsection]       [sectionsegments=subsubsection]
\setuphead [subsubsubsection]    [sectionsegments=subsubsubsection]
\setuphead [subsubsubsubsection] [sectionsegments=subsubsubsubsection]
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%                          標題相關設置                               %%%%%%
%%%%%%                           數字式標籤                                %%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\definelayout [part] [moderate]
\definemakeup [part] [\c!doublesided=yes%
                     ,\c!pagestate  =start%
                     ,\c!page       =right%
                     ,\c!headerstate=stop%
                     ,\c!footerstate=stop%
                     ,\c!topstate   =stop%
                     ,\c!bottomstate=stop%
                     ,\c!textstate  =stop%
                     ,\c!top        =\pseudostrut\ignorespaces%
                     ,\c!bottom     =\obeydepth\vss%
                     ,\c!height     =\paperheight%
                     ,\c!align      =flushright%
                     ,\c!after      =,]

%characters(a),romannumerals(i),numbers(1),
%chinesenumerals(四十二) chinesecapnumerals(肆拾二) chineseallnumerals(廿二)
%% 1          --- chapter
%% 1 XXXX     --- section
%% 1.1 XXXX   --- subsection
%% (1) XXXX   --- subsubsection
%% (1.1) XXXX --- subsubsubsection
\startsetups memos:chap:simple
  \setuplabeltext [en]             [chapter={{\sc Chapter\ \tf\definedfont[SansBold sa 2.488]},}]
  \setuplabeltext [hans]           [chapter={{\sc Chapter\ \tf\definedfont[SansBold sa 2.488]},}]
  \setuplabeltext [hant]           [chapter={{\sc Chapter\ \tf\definedfont[SansBold sa 2.488]},}]
  \setupheads[chapter]             [commandbefore=\blank[1ex],]
  \setupheads[subsection]          [sectionsegments=section:*]
  \setupheads[subsubsection]       [numbercommand=\paren]
  \setupheads[subsubsubsection]    [sectionsegments=subsubsection:*]
  \setupheads[subsubsubsubsection] [sectionsegments=subsubsection:*]
\stopsetups
%% 第 1 章          --- chapter
%% 第 1 節 XXXX     --- section
%% 1.1 XXXX         --- subsection
%% 1.1.1 XXXX       --- subsubsection
%% 1.1.1.1 XXXX       --- subsubsubsection

\define[2]\part_default_framed{%
  \vbox to 1th{\localheadsetup
  \dontleavehmode
  \ifconditional\headshownumber
    \vbox{\hbox to 6em{%
          \framed[frame=off,corner=rounded,width=4em,
            background=color,backgroundcolor=themecolor,
            ]{#1}\hfil}}%
            #2\par\vfill%
    \hfill\vbox {\hsize .55tw\vfill\hw
    \setuplist[chapter][margin=0pt,width=fit,frame=off,distance=.5em,
                        align=flushleft,numbercommand=,
                        style=\setuplocalinterlinespace[line=1em]\hw,]%
    \placecontent[list=chapter]}%
  \fi
}}

\startsetups memos:chap:default
  \edef\currentchapterstyle{default}

  \setupmakeup[part] [before=\setupbackgrounds[page][background=color,backgroundcolor=palethemecolor],
                       after=\setupbackgrounds[page][background=color,backgroundcolor=transparentcolor]]
  \setuphead  [part] [placehead=yes,
                      align=flushleft,
                      page=no,
                      numbercolor=white,
                      numberstyle=ssd,
                      numbercommand=\groupedcommand{\feature[+][f:caps] Part\ \definedfont[Sans sa 3.583]}{},
                      command=\part_default_framed,
                      before=\startmakeup[part],
                      after=\stopmakeup,
                      ]
  \setupheads[chapter][align=center,distance=\widthofstring{\ssd 章}]
  \setupheads[section,
              subsection,
              subsubsection,
              subsubsubsection,
              subsubsubsubsection] [sectionsegments=section:*]
  \setupheads[subsection,
              subsubsection,
              subsubsubsection,
              subsubsubsubsection] [numbercommand=,]
  \setuplabeltext [hans]  [part={第,部},        appendix=附录,
                           chapter={第,章},     section={第,节},
                           subsection={},      subsubsection={},
                           subsubsubsection={},subsubsubsubsection={}]
  \setuplabeltext [hant]  [part={第,部},        appendix=附録,
                           chapter={第,章},     section={第,節},
                           subsection={},      subsubsection={},
                           subsubsubsection={},subsubsubsubsection={}]
\stopsetups
%%                   1.1 Subsection
%%  1 Chapter        (1) Subsubsection
%% ------------      (1.1) Subsubsubsection
%% 1 Section         (1.1.1) Subsubsubsubsection
%%%%%%
\define[2]\partlineframe{
  \vbox to 1th{\localheadsetup
  \dontleavehmode
  \ifconditional\headshownumber
    \vfill
    \setbox0=\hbox{%
      \hbox to 2em{\hfill #1\hfill}\hskip .5em%
      \setuptextrules[rulecolor=white]%
      \vbox to 4em{\hsize\dimexpr\textwidth-2em\relax\vfill\textrule[top]{#2}\vfill}%
    }%
    \dp0\zeropoint\box0
    \vfill
  \fi
}}

\startsetups memos:chap:line
  \setupmakeup[part] [before=\setupbackgrounds[page][background=color,backgroundcolor=softthemecolor],
                       after=\setupbackgrounds[page][background=color,backgroundcolor=transparentcolor]]
  \setuphead  [part] [placehead=yes,
                      align=flushright,
                      page=no,
                      numbercolor=white,
                      numberstyle=\definedfont[Sans at 5em],
                      numbercommand=,
                      textcolor=white,
                      textstyle=ssb,
                      command=\partlineframe,
                      before=\startmakeup[part],
                      after=\stopmakeup,]
  \setuphead [chapter]             [before=\mbox{}\vskip2\lineheight\relax,
                                    after=\vskip\lineheight\hfil\blackrule[color=titlecolor,height=2pt,width=4em]\hfil\par\vskip3\lineheight\relax,
                                    interlinespace=medium,
                                    align=center,
                                    style=\definedfont[Sans sa 2.488]]
  \setuphead [section,subsection]  [numbercolor=lightthemecolor,numberwidth=2em]
  \setuphead [section]             [style=\ss\bfb,   numberstyle=\ss\bid,]
  \setuphead [subsection]          [style=\ss\tfa,   numberstyle=\ss\itc,]
  \setupheads[subsection]          [numbercommand=,  sectionsegments=section:*]
  \setupheads[subsubsection]       [numbercommand=\paren]
  \setupheads[subsubsubsection]    [numbercommand=\paren,sectionsegments=subsubsection:*]
  \setupheads[subsubsubsubsection] [numbercommand=\paren,sectionsegments=subsubsection:*]
\stopsetups
%%%%%%
%% chapter 1 XXXX    --- chapter
%% 1 XXXX            --- section
%% 1.1 XXXX          --- subsection
%% 1.1.1 XXXX        --- subsubsection
%% 1.1.1.1 XXXX      --- subsubsubsection
\startsetups memos:chap:madsentoc
  \startlocalheadsetup
  \headsetupspacing
  \starttabulate[|ck{0}|]
  \setuplocalinterlinespace[1pt]
  \NC\startframed[background=color,backgroundcolor=softthemecolor,
              foreground=color,foregroundcolor=white,
              corner=03,frame=off,location=bottom,
              width=\textwidth,height=5em,align={lohi,center}]%
              \headtextcontent
  \stopframed\NC\NR\NC
  \startframed[height=\baselineskip,width=\textwidth,corner=01,
              background=color,backgroundcolor=themecolor,
              toffset=-\baselineskip,location=bottom,
              align=right,frame=off,]
  \stopframed\NC\NR
  \stoptabulate
  \stoplocalheadsetup
\stopsetups

\startsetups memos:chap:madsenchapter
  \startlocalheadsetup
  \headsetupspacing
  \startframed[height=fit,width=\headparameter\c!width,
              %background=chapback,
              align=flushright,location=hanging,
              frame=off,bottomframe=on,topframe=on]
    \startframed[frame=off,]%
      \startframed[frame=off,foregroundcolor=lightthemecolor]%
        \ifconditional\headshownumber
          \rotate[rotation=90]{\tf \setcharactercasing[Word]%
                              \sc \currentstructurelabel}%
        \else\strut\fi
      \stopframed
      \startframed[backgroundcolor=themecolor, background=color,
                  foregroundcolor=white,       foreground=color,
                  corner=round,frame=off,
                  backgroundoffset=-4pt,
                  width=5em,height=5em,align={lohi,center}]%
                \setuplocalinterlinespace[0pt]
                \switchtobodyfont[40pt]
                \headnumber[chapter]%
      \stopframed%
    \stopframed\endgraf
    \startframed[height=fit,width=0.65\headparameter\c!width,
                location=hanging,align=right,frame=off,]
                \headtextcontent
    \stopframed
  \stopframed
  \stoplocalheadsetup
\stopsetups

\define[2]\part_madsen_frame{%
  \vbox xoffset 1pt to 1th{
  \vskip 50pt\relax
  \localheadsetup
  \dontleavehmode
  \ifconditional\headshownumber
    \framed[frame=off,
            background=color,backgroundcolor=lightthemecolor,
            width=100pt,height=100pt,
            corner=02,]
    {#1}
    #2\vfil\hw
    \hfill\vbox xoffset -1em {\hsize .5tw\vfill
    \setuplist[chapter][margin=0pt,width=fit,frame=on,
                    align=flushleft,numbercommand=,
                    style=\setuplocalinterlinespace[line=0em]\hw,]
      \placecontent[list=chapter]}%
  \fi
}}

\definelayer[part:madsen:left][width=\paperwidth,height=\paperheight,preset=lefttop]
\definelayer[part:madsen:right][width=\cutspace,height=\paperheight,x=\dimexpr\paperwidth-\cutspace\relax]

\startsetups memos:chap:madsen
  \definebodyfontenvironment [40pt]
  \defineoverlay[chapback][{\externalfigure[][width=0.8\paperwidth,height=6cm]}]

  \defineheadalternative[madsentoc][renderingsetup=memos:chap:madsentoc]
  \defineheadalternative[madsen][renderingsetup=memos:chap:madsenchapter]

  \setupmakeup[part] [before=%
                            \setlayer   [part:madsen:left] {\framed[frame=off,background=color,backgroundcolor=palethemecolor,width=1pw,height=1ph]{}}%
                            \setlayer   [part:madsen:right]{\framed[frame=off,background=color,backgroundcolor=lightthemecolor,width=\cutspace,height=1ph]{}}%
                            \setupbackgrounds[page][background={part:madsen:left,part:madsen:right}]]
  \setuphead  [part] [placehead=yes,
                      align=flushright,
                      page=no,
                      numbercolor=white,
                      numberstyle=ssd,
                      numbercommand=\groupedcommand{\feature[+][f:caps] Part\ \definedfont[Sans sa 3.583]}{},
                      textcommand=\groupedcommand{}{\hbox to 1em{}},
                      command=\part_madsen_frame,
                      before=\startmakeup[part],
                      after=\stopmakeup,]

  \setuphead[chapter][before=,width=\textwidth,%\spanmarginwidth,
                      alternative=madsen,
                      textstyle=\definedfont[Sans sa 2.488]]
  \setupheads[subsection]          [sectionsegments=section:*]
  \setupheads[subsubsection]       [sectionsegments=section:*]
  \setupheads[subsubsubsection]    [sectionsegments=section:*]
  \setupheads[subsubsubsubsection] [sectionsegments=section:*]
\stopsetups
%%%%%%
%% 第 一 回 XXXX
\startsetups memos:chap:classicnovel
  \definestructureconversionset[classicnovelconversionset]
                        [chineseallnumerals][chineseallnumerals]
  \setupheads[part,chapter,section,subsection,
              subsubsection,subsubsubsection,
              subsubsubsubsection]
            [sectionconversionset=classicnovelconversionset]
  \setuplabeltext [hans] [part={部},chapter={第,回},]
  \setuplabeltext [hant] [part={部},chapter={第,回},]
  \setuplist [chapter] [width=4em,distance=1em,numberalign=inner,style=\bf]
  \defineheadalternative[classicnovel]
                        [alternative=vertical,
                        renderingsetup=classicnovel]

  \setwidthof{\headnumbercontent}\to\HeadNumberWidth
  \newdimen\MaxHeadNumberWidth
  \MaxHeadNumberWidth=82pt
  \startsetups[classicnovel]
    \vbox {
          \headsetupspacing
          \veryraggedcenter
          \let\\\endgraf\let\crlf\endgraf
          \setupTABLE[c][each][align={\p_align},frame=off]
          \ifdim\HeadNumberWidth>\MaxHeadNumberWidth
              \bTABLE\bTR\bTD
              \ifconditional\headshownumber%
              \begstrut\headnumbercontent\endstrut%
              \else\fakeheadnumbercontent\fi%
              \eTD\eTR\bTR\bTD%
              \begstrut\headtextcontent\endstrut%
              \eTD\eTR\eTABLE
          \else
              \bTABLE\bTR\bTD[roffset=\headparameter\c!roffset]
              \ifconditional\headshownumber%
                  \strut\headnumbercontent\quad%
              \else\fakeheadnumbercontent\fi%
              \eTD\bTD%
              \begstrut\headtextcontent\endstrut%
              \eTD\eTR\eTABLE%
        \fi
    }
  \stopsetups
  \setupheads[chapter][roffset=1em,% control space between number and title
                      alternative=classicnovel,align={center,lohi}]
\stopsetups
%%%%%%
%% XX 第一
\startsetups memos:chap:classics
  \definestructureconversionset[classicsconversionset]
                        [chineseallnumerals][chineseallnumerals]
  \setupheads[part,chapter,section,subsection,
              subsubsection,subsubsubsection,
              subsubsubsubsection]
            [sectionconversionset=classicsconversionset]
  \setuplabeltext [hans][part={部},chapter={第},]
  \defineheadalternative[classics]
                        [alternative=horizontal,
                        renderingsetup=classics]
  \startsetups[classics]
    \vbox {
          \headsetupspacing
          \veryraggedcenter
          \let\\\endgraf\let\crlf\endgraf
          \begstrut
          \headtextcontent
          \ifconditional\headshownumber
          \headnumbercontent
          \else\fakeheadnumbercontent\fi
          \endstrut\blank
    }
  \stopsetups
  \setupheads[chapter][alternative=classics,align={center}]
\stopsetups
%%%%%%

\startuseMPgraphic{crosspart}
  StartPage ;
      numeric edgewidth     ; edgewidth     := \the\rightedgedistance  ;
      numeric marginwidth   ; marginwidth   := \the\rightmarginwidth   ;
      numeric paperwidth    ; paperwidth    := \the\paperwidth         ;
      numeric paperheight   ; paperheight   := \the\paperheight        ;
      numeric shifttomargin ; shifttomargin := \the\shifttomargin      ;
    path VertBox ; path VertBoxi ;
    VertBox   := lrcorner Field[Bottom]  [OuterEdge] --
                lrcorner Field[OuterEdge]     [Top] --
                urcorner Field[Top]   [OuterMargin] --
                urcorner Field[Bottom][OuterMargin] -- cycle ;
    VertBoxi := lrcorner Field[Bottom]  [RightEdgeSeparator] --
                lrcorner Field[RightEdgeSeparator]     [Top] --
                urcorner Field[Top]            [RightMargin] --
                urcorner Field[Bottom]         [RightMargin] -- cycle ;
      path HorizBox ; path HorizBoxi ; path HorizBoxii ;
      HorizBox  := fullsquare xysized (  paperwidth,.06paperheight)
                              shifted (.5paperwidth, .7paperheight);
      HorizBoxi := fullsquare xysized (  paperwidth,.08paperheight)
                              shifted (.5paperwidth, .7paperheight);
    HorizBoxii := fullsquare xysized (  marginwidth,.06paperheight)
                              shifted (shifttomargin, .7paperheight);
      pickup pencircle scaled 2pt ;
      fill Page        withcolor \MPcolor{softthemecolor}   ;
      fill VertBox     withcolor \MPcolor{lightthemecolor}  ;
      fill VertBoxi    shifted(-edgewidth,0) withcolor white ;
      fill HorizBoxi   withcolor white ;
      fill HorizBox    withcolor \MPcolor{lightthemecolor}  ;
      fill HorizBoxii  withcolor \MPcolor{softthemecolor}  ;
  StopPage ;
\stopuseMPgraphic

\startuseMPgraphic{MP:all}
    numeric width , height ;
    width  = \overlaywidth ;
    height = \overlayheight ;
    numeric textwidth ,              textheight ;
    textwidth  := .9*\overlaywidth ; textheight := .92*\overlayheight ;
    path paper_back ;%%% i
    paper_back  := fullsquare xscaled width yscaled height ;
    fill paper_back withcolor \MPcolor{softthemecolor} ;
    path text_back ;%%% ii
    text_back := fullsquare xscaled textwidth yscaled textheight cornered .5cm;
    fill text_back withcolor white ;
\stopuseMPgraphic

\startuseMPgraphic{MP:chapter}
    numeric width , height ;
    width  = \overlaywidth ;
    height = \overlayheight ;
    numeric textwidth , textheight ;
    textwidth  := .9*\overlaywidth  ;
    textheight := .65*\overlayheight ;
    path paper_back ;%%% i
    paper_back  := fullsquare xscaled width yscaled height ;
    fill paper_back withcolor \MPcolor{softthemecolor} ;
    path text_back ;%%% ii
    text_back := fullsquare xscaled textwidth yscaled textheight cornered .5cm;
    fill text_back shifted(0,-.15textheight) withcolor white ;
\stopuseMPgraphic

\startsetups chapter:pagebackground
  \doifelsemode {colorful:chapterpage} {
    \setlayer[lay:chapter][preset=lefttop]{\useMPgraphic{MP:chapter}}
    \globaldisablemode[colorful:chapterpage]
  }{
    \setlayer[lay:chapter][preset=lefttop]{\useMPgraphic{MP:all}}
  }
  \placelayer[lay:chapter]
\stopsetups

\define[2]\left_margin_placement{%
  \vbox{\localheadsetup
  \dontleavehmode
  \ifconditional\headshownumber
    \vskip\dimexpr.1\paperwidth\relax
    \rightskip = -.85\rightmarginwidth #1
    \vskip\dimexpr3\baselineskip\relax
      #2
    \vskip2.5\baselineskip
  \fi
}}

\newdimen\shifttomargin
\shifttomargin=\dimexpr\paperwidth-%
            2\rightedgedistance-\rightedgewidth-%
           .5\rightmarginwidth\relax%

\startsetups memos:chap:colorful
  \definelayer      [lay:all]     [repeat=yes,width=\paperwidth, height=\paperheight]
  \definelayer      [lay:chapter] [width=\paperwidth, height=\paperheight]
  \defineoverlay    [olay:all]    [\useMPgraphic{MP:all}]
  \defineoverlay    [partoverlay] [\useMPgraphic{crosspart}]
  \defineoverlay    [olay:chapter][\directsetup{chapter:pagebackground}]
% \setupbackgrounds [page]        [background=olay:all,state=repeat]
  \setupbackgrounds [page]        [background=olay:chapter]
  \setupmakeup      [part]        [before=\setupbackgrounds[page][background=partoverlay],
                                    after=\setupbackgrounds[page][background=transparentcolor]]
  \setuphead        [part]        [placehead=yes,align=flushright,page=no,
                                   alternative=\v!command,
                                   \c!command=\left_margin_placement,
                                   before=\startmakeup[part],
                                   after=\stopmakeup,
  %%                                 alternative=paragraph,
  %%                                 location=outermargin,
  %%                               numbercommand=\groupedcommand
  %%                                 {\vskip\dimexpr.06\paperwidth\relax}
  %%                                 {\blank},
                                  ]
  % startpartmakeup \part{} \stoppartmakeup
  % ------------- only set for chapter
  \setuphead[chapter][before={\globaldisablemode[rocket:chapterpage]
                              \globaldisablemode[hexa:chapterpage]
                              \globalenablemode[colorful:chapterpage]
                              \null\vskip2\baselineskip\relax},
                      after={\null\vskip2\baselineskip\relax},]
         
\stopsetups
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% 一种 chapter 样式
% Chapter            ｜   ｜
% -------            ｜ 1 ｜
%                     \  /
%    Chapter Title     \/
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\startuseMPgraphic{style:chapter:rocket:number}
  fill fullsquare   xysized (75pt , 150pt)
                    shifted (0,     10pt)
                    withcolor \MPcolor{lightthemecolor};
  fill downtriangle xysized (75pt ,  40pt)
                    shifted (0,   -78.4pt)
                    withcolor \MPcolor{lightthemecolor};
  label("\definedfont[Sans sa 4]
          \ifnum{\somenamedheadnumber{chapter}{current}}>0
            \somenamedheadnumber{chapter}{current}\fi",
        origin shifted (0, -35pt)) withcolor white;
\stopuseMPgraphic

\startsetups memos:chap:rocket:background
  \doifelsemode {rocket:chapterpage} {
      \setlayer
        [layer:chapter:rocket:number]
        [preset=righttop,hoffset=\rightedgewidth,]
        {\useMPgraphic{style:chapter:rocket:number}}
      \globaldisablemode[rocket:chapterpage]
  } {
      \setlayer
        [layer:chapter:rocket:number]
        [preset=middle]
        {}
  }
  \placelayer[layer:chapter:rocket:number]
\stopsetups

\startsetups[memos:chap:rocketdown]
  \globaldisablemode[colorful:chapterpage]
  \globaldisablemode[hexa:chapterpage]
  \globalenablemode[rocket:chapterpage]
  \vbox{
    \headsetupspacing\hfill
    \let\\\endgraf\let\crlf\endgraf
    \ifnum{\somenamedheadnumber{chapter}{current}}>0
      \framed[frame=off,bottomframe=on,offset=0pt,
              framecolor=titlecolor,rulethickness=2pt]
              {\hfill
      \ifconditional\headshownumber
      \strut\headnumbercontent
      \else\fakeheadnumbercontent\fi}
    \else
      \framed[frame=off,offset=0pt]
              {\hfill
      \ifconditional\headshownumber
      \strut\headnumbercontent
      \else\fakeheadnumbercontent\fi}%
    \fi\par\hfill
    \begstrut\headtextcontent\endstrut
  }
\stopsetups

\newcount\totalparts
\totalparts=3
\defineoverlay[archedbackground][\useMPgraphic{background:arched}]

\startuseMPgraphic{background:arched}
  StartPage;

  numeric arch_radius, arch_depth, split_position;
  arch_radius := PaperWidth/6;
  arch_depth := 60pt;
  split_position := 0.65 * PaperHeight;

  path bottom_layer, top_layer, arch_path;

  bottom_layer := (0, 0) -- (PaperWidth, 0) -- (PaperWidth, PaperHeight)
                  -- (0, PaperHeight) -- cycle;

  top_layer := (0, 0) -- (PaperWidth, 0) -- (PaperWidth, split_position)
               -- (PaperWidth/2 + arch_radius, split_position)
               .. (PaperWidth/2, split_position - arch_depth) ..
               (PaperWidth/2 - arch_radius, split_position)
               -- (0, split_position) -- cycle;

  arch_path := (0, split_position)
               -- (PaperWidth/2 - arch_radius, split_position)
               .. (PaperWidth/2, split_position - arch_depth) ..
               (PaperWidth/2 + arch_radius, split_position)
               -- (PaperWidth, split_position);

  fill bottom_layer withcolor \MPcolor{themecolor};
  fill top_layer withcolor \MPcolor{softthemecolor};

  draw arch_path withcolor white withpen pencircle scaled 4pt;

  numeric current_part, total_parts, progress;
  current_part := \the\numexpr\somenamedheadnumber{part}{current}\relax;
  total_parts := \the\totalparts;
  
  if current_part > 0:
    progress := current_part / total_parts;
  else:
    progress := 0;
  fi;

  path progress_path;
  progress_path := subpath (0, progress * length(arch_path)) of arch_path;

  draw progress_path withcolor \MPcolor{optcolor} withpen pencircle scaled 4pt;

  StopPage;
\stopuseMPgraphic

\define[2]\part_rocket_frame{%
  \vbox to 1th{
  \vskip 50pt\relax
  \localheadsetup
  \dontleavehmode
  \ifconditional\headshownumber
    {\strc_rendering_initialize_style_and_color\relax\c!numbercolor
     \feature[+][f:caps] Part}\par
    #1\blank[2*line]
    #2
    \vfill
    \setuplist[chapter]
              [margin=0pt,width=fit,frame=on,
              align=flushleft,numbercommand=,
              style=\ss,color=darkthemecolor]
    \setuplocalinterlinespace[line=0em]%
    \raggedright
      \color[optcolor]{\ssd\labeltext{content}\vskip 4pt
      \hrule width \hsize height 0pt depth 1pt}
    \hw\placecontent[list=chapter]
  \fi
}}

