\startuseMPgraphic{MPchapter:ugent}
  numeric tw, rmw, h, bx, ruler;
  h   := \overlayheight;
  tw  := \the\textwidth;
  rmw := \the\cutspace;
  ruler :=2pt;
  
  bx := tw ; % 蓝块左边界坐标 (版心宽 + 页边距 - 蓝块宽)
  fill unitsquare xyscaled (1.5rmw, h) shifted (bx-0.5rmw, 0) withcolor \MPcolor{themecolor};
  label(textext("\color[white]{\definedfont[SansBold sa 5]\somenamedheadnumber{chapter}{current}}"), (bx, h/2));
  label(textext("\rotate[rotation=90]{\color[white]{\feature[+][f:caps]\definedfont[Sans sa 1]Chapter }}"), (bx + 0.6rmw, h/2));
  draw (0, ruler/2) -- (bx, ruler/2) withpen pencircle scaled ruler withcolor \MPcolor{themecolor};
\stopuseMPgraphic

