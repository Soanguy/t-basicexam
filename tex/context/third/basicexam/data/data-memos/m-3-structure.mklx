   \c!renderingsetup=\??listrenderings:abc]

\tolerant\protected\def\marginlist[#1]#:[#2]%
  {\begingroup
  \setuplist[section][
    margin=0em,width=fit,align=inner,
    alternative=marginlist,
    distance=.5em,label=no,style=\rm\itx,
