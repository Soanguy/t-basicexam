\newdimen\__gyoudori_ht
\newdimen\__gyoudori_dp
\newdimen\__gyoudori_bs

\def\__gyoudori_metrics{%
  \begingroup
    \setbox\scratchbox=\hbox{永}%
    \global\__gyoudori_ht\ht\scratchbox      % 「あ」的高度（字符框上缘）
    \global\__gyoudori_dp\dp\scratchbox      % 「あ」的深度（字符框下缘）
    \global\__gyoudori_bs\baselineskip % 行送り
  \endgroup}

\def\__gyoudori_linegap{\dimexpr\__gyoudori_bs-\__gyoudori_ht-\__gyoudori_dp\relax}
\def\__gyoudori_areaheight#1{\dimexpr\__gyoudori_bs*(#1-1)+\__gyoudori_ht+\__gyoudori_dp\relax}
\def\setnoflineheight#1{\dimexpr\__gyoudori_bs*(#1-1)+\__gyoudori_ht+\__gyoudori_dp\relax}

\__gyoudori_metrics

\defineheadalternative
  [\v!grid]
  [\c!alternative=\v!vertical,
   \c!renderingsetup=headrenderings:\v!grid]

\startsetups[headrenderings:\v!grid]
    \vbox to \__gyoudori_areaheight{\headparameter\c!lines}{\null
       \doifinset{bottom}{\headparameter\c!align}{\vfill}%
       \doifinset{lohi}  {\headparameter\c!align}{\vfill}%
       \headparameter{headbefore}%
        \headsetupspacing
        \ifconditional\headshownumber
            \ifzeropt\headwidth \else
                \ifzeropt\headnumberwidth
                    \ifzeropt\headtextwidth \else
                        \headnumberwidth{\headwidth-\headtextwidth}%
                    \fi
                \else
                    \ifzeropt\headtextwidth
                        \headtextwidth{\headwidth-\headnumberwidth}%
                    \fi
                \fi
                \hsize\headwidth
            \fi
            \ifzeropt\headnumberwidth \else
                \headnumberdistance\zeropoint
            \fi
            \setbox\scratchbox\hbox
                \s!nokerning
                \ifzeropt\headnumberwidth\else to \headnumberwidth\fi
                {\headnumbercontent}%
            \scratchdimen{\wd\scratchbox+\headnumberdistance}%
            \ifzeropt\headtextwidth \else
                \hsize{\scratchdimen+\headtextwidth}%
            \fi
            \hangindent\scratchdimen
            \hangafter \plusone
            \noindent
            \box\scratchbox
          % \resetcharacterkerning
            \kern\headnumberdistance % was \hskip
            \headparameter{textbefore}%
        \else
            \ifzeropt\headtextwidth
                \ifzeropt\headwidth \else
                    \hsize\headwidth
                \fi
            \else
                \hsize\headtextwidth
            \fi
            \noindent
            \fakeheadnumbercontent
        \fi
       
       \headtextcontent
       \headparameter{textafter}%
       \headparameter{headafter}%
       \doifinset{top} {\headparameter\c!align}{\vfill}%
       \doifinset{lohi}{\headparameter\c!align}{\vfill}%
    }%
\stopsetups

