\startluacode
do
    local jobpositions      = job.positions
    local attributes        = attributes
    local nodes             = nodes
    local tex               = tex
    local interfaces        = interfaces
    local logs              = logs
    local setmetatableindex = table.setmetatableindex

    local nuts              = nodes.nuts
    local new_latelua       = nuts.pool.latelua
    local new_rule          = nuts.pool.rule
    local new_kern          = nuts.pool.kern
    local new_hlist         = nuts.pool.hlist
    local getid             = nuts.getid
    local setlink           = nuts.setlink
    local getheight         = nuts.getheight
    local getdepth          = nuts.getdepth
    local par_code          = nodes.nodecodes.par
    local startofpar        = nuts.startofpar
    local insertbefore      = nuts.insertbefore
    local insertafter       = nuts.insertafter
    local processranges     = nuts.processranges

    local unsetvalue        = attributes.unsetvalue
    local registervalue     = attributes.registervalue
    local getvalue          = attributes.getvalue
    local texsetattribute   = tex.setattribute
    local texgetcount       = tex.getcount
    local c_realpageno      = tex.iscount("realpageno")
    local enableaction      = nodes.tasks.enableaction
    local report_graphics   = logs.reporter("backgrounds")

    local trace_ranges      = false

    local dualindex         = 0
    local dualrealpage      = 1
    local dual_enabled      = false
    local a_dualbackground  -- lazy

    local function get_dual_attribute()
        if not a_dualbackground then
            a_dualbackground = attributes.private("dualbackground")
        end
        return a_dualbackground
    end

    local function dual_check(specification)
        local a     = specification.attribute
        local ix    = specification.index
        local depth = specification.depth
        local d     = specification.data
        local where = specification.where
        local ht    = specification.ht
        local dp    = specification.dp
        local w     = d.shapes[dualrealpage]
        local x, y  = jobpositions.getpos()
        print(string.format("[DBG] dual_check where=%s x=%s y=%s", where, tostring(x), tostring(y)))
        if trace_ranges then
            report_graphics("check %i/%i/%i %s (%p,%p)", a, ix, depth, where, x, y)
        end
        local n = #w
        if d.index ~= ix then
            n = n + 1
            d.index = ix
            d.depth = depth
            w[n] = { y, ht, dp, x, x }
        else
            local wn = w[n]
            local wh = wn[2]
            local wd = wn[3]
            if depth < d.depth then
                local wy = wn[1]
                wn[1] = y
                d.depth = depth
                local dy = wy - y
                wh = wh - dy
                wd = wd - dy
            end
            if where == "r" then
                if x > wn[5] then wn[5] = x end
            else
                if x < wn[4] then wn[4] = x end
            end
            if ht > wh then wn[2] = ht end
            if dp > wd then wn[3] = dp end
        end
    end

    local function flushdual(head, f, l, a, parent, depth)
        print("[DBG] flushdual a=" .. tostring(a))
        local a_dual = get_dual_attribute()
        if not a_dual then
            return head, true
        end
        local d = getvalue(a_dual, a)
        print("[DBG] flushdual d=" .. tostring(d ~= nil))
        if d then
            local ix = dualindex
            local ht = getheight(parent)
            local dp = getdepth(parent)
            local ln = new_latelua {
                action = dual_check, attribute = a, index = ix,
                depth = depth, data = d, where = "l", ht = ht, dp = dp,
            }
            local rn = new_latelua {
                action = dual_check, attribute = a, index = ix,
                depth = depth, data = d, where = "r", ht = ht, dp = dp,
            }
            if trace_ranges then
                ln = new_hlist(setlink(new_rule(65536, 65536 * 4, 0), new_kern(-65536), ln))
                rn = new_hlist(setlink(new_rule(65536, 0, 65536 * 4), new_kern(-65536), rn))
            end
            if getid(f) == par_code and startofpar(f) then
                insertafter(head, f, ln)
            else
                head, f = insertbefore(head, f, ln)
            end
            insertafter(head, l, rn)
        end
        return head, true
    end

    nodes.handlers.dualbackgrounds = function(head, where, parent)
        print("[DBG] handler dualbackgrounds called, page=" .. tostring(texgetcount(c_realpageno)))
        dualindex    = dualindex + 1
        dualrealpage = texgetcount(c_realpageno)
        local a_dual = get_dual_attribute()
        print("[DBG] handler a_dual=" .. tostring(a_dual))
        if a_dual then
            return processranges(a_dual, flushdual, head, parent)
        end
        return head, true
    end

    local function registerdualbackground(name)
        print("[DBG] registerdualbackground name=" .. tostring(name))
        local a_dual = get_dual_attribute()
        print("[DBG] a_dual=" .. tostring(a_dual))
        if not a_dual then
            report_graphics("attribute 'dualbackground' not defined")
            return
        end
        local b = jobpositions.tobesaved["b:" .. name]
        print("[DBG] tobesaved has b:" .. name .. " = " .. tostring(b ~= nil))
        if b then
            local s = setmetatableindex("table")
            b.s = s
            local t = {
                bpos = b, name = name, shapes = s, count = 0, sindex = 0,
            }
            local n = registervalue(a_dual, t)
            t.n = n
            texsetattribute(a_dual, n)
            if not dual_enabled then
                print("[DBG] enabling nodes.handlers.dualbackgrounds")
                enableaction("contributers", "dualbackgrounds")
                -- enableaction("contributers", "nodes.handlers.dualbackgrounds")
                dual_enabled = true
            end
        else
            texsetattribute(a_dual, unsetvalue)
        end
    end

    interfaces.implement {
        name      = "registerdualbackground",
        actions   = registerdualbackground,
        arguments = "string",
    }
end
\stopluacode

%D MP 参数缩写对照（DrawDualBodyOnPath / DrawDualCombinedOnPath）：
%D   dbg   = backgroundcolor   正文底色（不进标题条）
%D   dfc   = framecolor        框线色
%D   dsc   = shadowcolor       阴影色
%D   dth   = rulethickness     线宽
%D   drad  = radius            圆角半径
%D   dcorner/bodycorner        圆角选角：0=四角 1=上 2=下 3=左 4=右 其他=直角
%D   dlf/drF/dtf/dbf           leftframe/rightframe/topframe/bottomframe（>0 画该边）
%D   dshadow=shadow            yes=画阴影
%D   dbar  = bar               yes=左色条（自动启用，不看 leftframe）
%D   dframe= framebox          yes=棋盘格点阵
%D   dch   = character         非空=45° 水印（none/空=关）
%D   dsym  = symbol            非空=右下角标（none/空=关）
%D   dfov  = frameoffset       框线内缩修正；0=线外缘贴边界，-th/2=官方居中跃出
%D   dboff = backgroundoffset  背景外扩量；0=不外扩，>0 向外扩（复刻官方 filloffset）
%D   dox   = th/4 或 th/2      局部内缩（barbox 用 th/4；合并接缝几何用 th/2）

\startMPdefinitions

  % 文字宽度
  vardef GetTextWidth(expr textpic) =
    xpart urcorner textpic - xpart llcorner textpic
  enddef;

  % 文字水平位置：align 1=左 2=中 3=右；padding 为边距
  vardef AlignTextPosition(expr textpic, left, right, align, padding) =
    numeric textw;
    textw := GetTextWidth(textpic);
    if align = 1 :
      left + textw/2 + padding
    elseif align = 3 :
      right - textw/2 - padding
    else :
      left + (right - left)/2
    fi
  enddef;

  % 盒子左边界：align 1=左贴 margin 2=居中 3=右贴 margin
  vardef CalcBoxX(expr boxwidth, align, totalwidth, margin) =
    if align = 1 :
      margin
    elseif align = 3 :
      totalwidth - boxwidth - margin
    else :
      (totalwidth - boxwidth) / 2
    fi
  enddef;

  % 统一圆角矩形：tl/tr/br/bl 控制四角是否圆
  vardef DualHeaderBox(expr left, right, bottom, top, r,
                       tl, tr, br, bl) =
    save p; path p;
    if r > 0 :
      if tl : p := (left, top - r) .. controls (left, top) .. (left + r, top);
      else  : p := (left, top); fi;
      if tr : p := p -- (right - r, top) .. controls (right, top) .. (right, top - r);
      else  : p := p -- (right, top); fi;
      if br : p := p -- (right, bottom + r) .. controls (right, bottom) .. (right - r, bottom);
      else  : p := p -- (right, bottom); fi;
      if bl : p := p -- (left + r, bottom) .. controls (left, bottom) .. (left, bottom + r);
      else  : p := p -- (left, bottom); fi;
      p := p -- cycle;
    else :
      p := (left, top) -- (right, top) -- (right, bottom) -- (left, bottom) -- cycle;
    fi;
    p
  enddef;

  % ---------- 正文绘制 ----------
  % 参数对照见文件头。dmain 为正文区域路径。
  % 简化版正文绘制：
  %   dshadow=1 画阴影；dbar=1 画左色条；dframe=1 画棋盘格点阵
  %   dch 非空 → 字符水印；dsym 非空 → 右下角标
  def DrawDualBodyOnPath(expr dmain, dbg, dfc, dsc,
                         dth, drad, dcorner, dlf, drf, dtf, dbf,
                         dch, dsym, dshadow, dbar, dframe,
                         dfov, dboff) =
    begingroup
      path dmain_; dmain_ := dmain;
      color dbg_, dfc_, dsc_;
      dbg_ := dbg; dfc_ := dfc; dsc_ := dsc;
      numeric dth_, drad_, dcorner_, dlf_, drf_, dtf_, dbf_;
      dth_ := dth; drad_ := drad; dcorner_ := dcorner;
      dlf_ := dlf; drf_ := drf; dtf_ := dtf; dbf_ := dbf;
      numeric dfov_, dboff_; dfov_ := dfov; dboff_ := dboff;
      string dch_, dsym_;
      dch_ := dch; dsym_ := dsym;
      numeric dshadow_, dbar_, dframe_;
      dshadow_ := dshadow; dbar_ := dbar; dframe_ := dframe;

      numeric dox; dox := dth_ / 4;

      % 圆角开关（corner≠9 且 radius>0 时启用）
      boolean ctl, ctr, cbr, cbl;
      if (drad_ > 0) and (dcorner_ <> 9) :
        if dcorner_ = 0 :
          ctl:=true; ctr:=true; cbr:=true; cbl:=true;
        elseif dcorner_ = 1 :
          ctl:=true; ctr:=true; cbr:=false; cbl:=false;
        elseif dcorner_ = 2 :
          ctl:=false; ctr:=false; cbr:=true; cbl:=true;
        elseif dcorner_ = 3 :
          ctl:=true; ctr:=false; cbr:=false; cbl:=true;
        elseif dcorner_ = 4 :
          ctl:=false; ctr:=true; cbr:=true; cbl:=false;
        else :
          ctl:=true; ctr:=true; cbr:=true; cbl:=true;
        fi;
      else :
        ctl:=false; ctr:=false; cbr:=false; cbl:=false;
      fi;

      numeric bxmin, bymin, bxmax, bymax;
      bxmin := xpart llcorner dmain_;  bymin := ypart llcorner dmain_;
      bxmax := xpart urcorner dmain_;  bymax := ypart urcorner dmain_;

      % 背景路径（含圆角）
      path dbody;
      if (drad_ > 0) and (dcorner_ <> 9) :
        dbody := DualHeaderBox(bxmin, bxmax, bymin, bymax,
                               drad_, ctl, ctr, cbr, cbl);
      else :
        dbody := dmain_;
      fi;

      % 框线路径：内缩 dlo = th/2 + frameoffset
      path dbody_in;
      numeric drin, dlo;
      dlo  := dth_ / 2 + dfov_;
      drin := drad_ - dlo;
      if drin < 0 : drin := 0; fi;
      if dlo = 0 :
        dbody_in := dbody;
      elseif (drad_ > 0) and (dcorner_ <> 9) :
        dbody_in := DualHeaderBox(bxmin+dlo, bxmax-dlo, bymin+dlo, bymax-dlo,
                                  drin, ctl, ctr, cbr, cbl);
      else :
        dbody_in := dmain_ enlarged (-dlo);
      fi;

      % 阴影
      if dshadow_ > 0 :
        numeric dst; dst := 8pt;
        path dsh;
        if (drad_ > 0) and (dcorner_ <> 9) :
          path dsh_r;
          dsh_r := DualHeaderBox(bxmin, bxmax, bymin, bymax,
                                 drad_, true, true, true, true);
          dsh := dsh_r shifted (dst/2 * (1,-1));
          fill dsh withcolor dsc_;
        else :
          dsh := dbody shifted (dst/4 * (1,-1));
          draw ((dst*right + llcorner dsh)
                -- lrcorner dsh
                -- (dst*down + urcorner dsh))
            withpen pensquare scaled dst withcolor dsc_;
        fi;
      fi;

      drawoptions(withpen pencircle scaled dth_ withcolor dfc_);

      % 背景填充
      filldraw dbody withcolor dbg_ withpen pencircle scaled (2*dboff_);

      % 字符水印（character 非空时自动）
      if (dch_ <> "") and (dch_ <> "none") :
        draw dbody withpattern image(
          draw textext(dch_) rotated 45 withcolor dfc_ withopacity .2);
      fi;

      % 左色条
      if dbar_ > 0 :
        numeric dbw; dbw := dth_ * 1.5;
        path dbarrect;
        dbarrect := (xpart llcorner dbody_in, ypart llcorner dbody_in)
                  -- (xpart llcorner dbody_in + dbw, ypart llcorner dbody_in)
                  -- (xpart llcorner dbody_in + dbw, ypart urcorner dbody_in)
                  -- (xpart llcorner dbody_in, ypart urcorner dbody_in)
                  -- cycle;
        if (drad_ > 0) and (dcorner_ <> 9) :
          picture dpb;
          dpb := image(fill dbarrect withcolor dfc_);
          clip dpb to dbody;
          draw dpb;
        else :
          fill dbarrect withcolor dfc_;
        fi;
      fi;

      % 棋盘格点阵（framebox=yes）
      if dframe_ > 0 :
        numeric da; da := 2;
        path dp; dp := fullcircle scaled .1da;
        picture dpic;
        dpic := image(
          fill dp withcolor dfc_ withopacity .1;
          fill dp shifted (da,-da) withcolor dfc_ withopacity .1;
        );
        setbounds dpic to ((0,0)--(2da,0)--(2da,-2da)--(0,-2da)--cycle);
        draw dbody withpattern dpic;
      fi;

      % 边框：四边全开则整框；否则按边画（圆角边含相邻角弧）
      % 禁用边框时用透明色，避免遮盖问题
      boolean dall;
      dall := (dlf_>0) and (drf_>0) and (dtf_>0) and (dbf_>0);
      color dline;
      if dall :
        dline := dfc_;
        draw dbody_in withcolor dline;
      else :
        dline := dfc_;
        numeric lox, loy, hix, hiy;
        lox := xpart llcorner dbody_in;
        loy := ypart llcorner dbody_in;
        hix := xpart urcorner dbody_in;
        hiy := ypart urcorner dbody_in;
        if drad_ > 0 :
          numeric rr; rr := drin;
          path dedge;
          if dtf_ > 0 :
            if ctl : dedge := (lox, hiy-rr) .. controls (lox, hiy) .. (lox+rr, hiy);
            else   : dedge := (lox, hiy); fi;
            if ctr : dedge := dedge -- (hix-rr, hiy) .. controls (hix, hiy) .. (hix, hiy-rr);
            else   : dedge := dedge -- (hix, hiy); fi;
            draw dedge withcolor dline;
          fi;
          if dbf_ > 0 :
            if cbl : dedge := (lox, loy+rr) .. controls (lox, loy) .. (lox+rr, loy);
            else   : dedge := (lox, loy); fi;
            if cbr : dedge := dedge -- (hix-rr, loy) .. controls (hix, loy) .. (hix, loy+rr);
            else   : dedge := dedge -- (hix, loy); fi;
            draw dedge withcolor dline;
          fi;
          if dlf_ > 0 :
            if cbl : dedge := (lox+rr, loy) .. controls (lox, loy) .. (lox, loy+rr);
            else   : dedge := (lox, loy); fi;
            if ctl : dedge := dedge -- (lox, hiy-rr) .. controls (lox, hiy) .. (lox+rr, hiy);
            else   : dedge := dedge -- (lox, hiy); fi;
            draw dedge withcolor dline;
          fi;
          if drf_ > 0 :
            if cbr : dedge := (hix-rr, loy) .. controls (hix, loy) .. (hix, loy+rr);
            else   : dedge := (hix, loy); fi;
            if ctr : dedge := dedge -- (hix, hiy-rr) .. controls (hix, hiy) .. (hix-rr, hiy);
            else   : dedge := dedge -- (hix, hiy); fi;
            draw dedge withcolor dline;
          fi;
        else :
          if dlf_ > 0 : draw (lox,loy)--(lox,hiy) withcolor dline; fi;
          if drf_ > 0 : draw (hix,loy)--(hix,hiy) withcolor dline; fi;
          if dtf_ > 0 : draw (lox,hiy)--(hix,hiy) withcolor dline; fi;
          if dbf_ > 0 : draw (lox,loy)--(hix,loy) withcolor dline; fi;
        fi;
      fi;

      % 角标符号（symbol 非空时自动，右下）
      if (dsym_ <> "") and (dsym_ <> "none") :
        picture dstx;
        dstx := textext(dsym_);
        dstx := dstx shifted (xpart urcorner dbody - 0.5*BodyFontSize,
                              ypart llcorner dbody + 0.5*BodyFontSize - 1pt);
        fill bbox dstx withcolor white;
        draw dstx withcolor dfc_;
      fi;
    endgroup
  enddef;

\stopMPdefinitions

\startMPdefinitions
  % ---------- Overlay 版标题：坐标取 OverlayWidth/Height ----------
  % 供 DualTitleBar / DualHeaderTextNew 使用。
  % backgroundcolor 参数未使用（历史遗留，保持签名兼容）。
  def DrawDualHeaderFrameNew(
    expr shownumber, showtitle,
         titlepos, titlealign, numberalign,
         numberbgcolor, titlebgcolor, backgroundcolor,
         numbercolor, titlecolor,
         framecolor, numberframecolor, titleframecolor,
         numberframe, titleframe,
         numberratio, titleratio,
         linethickness, hdrradius, hdrcorner
  ) =
    begingroup;
      numeric w, h, ox, r, headerh, topborderpos;

      w  := OverlayWidth;
      h  := OverlayHeight;
      ox := linethickness / 2;
      r  := hdrradius;

      boolean shownum, showttl, both;
      shownum := shownumber > 0;
      showttl := showtitle  > 0;
      both    := shownum and showttl;

      if shownum or showttl :
        topborderpos := ox;
        headerh      := h - 2 * ox;

        numeric nleft, nright, tleft, tright;
        numeric nbw, tbw, cw, cx, nw;
        picture numbertext, titletext;

        if shownum : numbertext := textext(\MPstring{DualHeaderNumber}); fi;
        if showttl : titletext  := textext(\MPstring{DualHeaderTitle});  fi;

        % 水平范围：titlepos=0 按文字宽 fit；否则按比例占满
        if titlepos = 0 :
          if both :
            nbw := GetTextWidth(numbertext) + 8pt;
            tbw := GetTextWidth(titletext)  + 8pt;
            cw  := nbw + tbw;
            cx  := CalcBoxX(cw, titlealign, w, ox);
            nleft := cx;          nright := cx + nbw;
            tleft := cx + nbw;    tright := cx + cw;
          elseif shownum :
            nbw := GetTextWidth(numbertext) + 8pt;
            nleft := CalcBoxX(nbw, titlealign, w, ox);
            nright := nleft + nbw;
          else :
            tbw := GetTextWidth(titletext) + 8pt;
            tleft := CalcBoxX(tbw, titlealign, w, ox);
            tright := tleft + tbw;
          fi;
        else :
          if both :
            nw    := w * numberratio / (numberratio + titleratio);
            nleft := ox;  nright := nw;
            tleft := nw;  tright := w - ox;
          elseif shownum :
            nleft := ox;  nright := w - ox;
          else :
            tleft := ox;  tright := w - ox;
          fi;
        fi;

        % 圆角开关（hdrcorner：0=外侧四角 1=上外 2=下外 3=左盒左侧 4=右盒右侧）
        boolean ntl, ntr, nbr, nbl, ttl, ttr, tbr, tbl;
        ntl:=false; ntr:=false; nbr:=false; nbl:=false;
        ttl:=false; ttr:=false; tbr:=false; tbl:=false;
        if hdrcorner = 0 :
          if both :
            ntl:=true; nbl:=true; ttr:=true; tbr:=true;
          elseif shownum :
            ntl:=true; ntr:=true; nbr:=true; nbl:=true;
          else :
            ttl:=true; ttr:=true; tbr:=true; tbl:=true;
          fi;
        elseif hdrcorner = 1 :
          if both :
            ntl:=true; ttr:=true;
          elseif shownum :
            ntl:=true; ntr:=true;
          else :
            ttl:=true; ttr:=true;
          fi;
        elseif hdrcorner = 2 :
          if both :
            nbl:=true; tbr:=true;
          elseif shownum :
            nbl:=true; nbr:=true;
          else :
            tbl:=true; tbr:=true;
          fi;
        elseif hdrcorner = 3 :
          if shownum :
            ntl:=true; nbl:=true;
          else :
            ttl:=true; tbl:=true;
          fi;
        elseif hdrcorner = 4 :
          if showttl :
            ttr:=true; tbr:=true;
          else :
            ntr:=true; nbr:=true;
          fi;
        fi;

        path nbox, tbox;
        if shownum :
          nbox := DualHeaderBox(nleft, nright, topborderpos, h - ox, r,
                                ntl, ntr, nbr, nbl);
        fi;
        if showttl :
          tbox := DualHeaderBox(tleft, tright, topborderpos, h - ox, r,
                                ttl, ttr, tbr, tbl);
        fi;

        if shownum : fill nbox withcolor numberbgcolor; fi;
        if showttl : fill tbox  withcolor titlebgcolor;  fi;

        numeric cy, nx, tx;
        cy := topborderpos + headerh / 2;

        if shownum :
          if titlepos = 0 :
            nx := nleft + (nright - nleft)/2;
          else :
            nx := AlignTextPosition(numbertext, nleft, nright, numberalign, 4pt);
          fi;
          draw numbertext shifted (nx, cy - ypart center numbertext)
               withcolor numbercolor;
        fi;

        if showttl :
          if titlepos = 0 :
            tx := tleft + (tright - tleft)/2;
          else :
            tx := AlignTextPosition(titletext, tleft, tright, titlealign, 4pt);
          fi;
          draw titletext shifted (tx, cy - ypart center titletext)
               withcolor titlecolor;
        fi;

        if shownum and (numberframe > 0) :
          draw nbox withpen pencircle scaled linethickness
               withcolor numberframecolor;
        fi;
        if showttl and (titleframe > 0) :
          draw tbox withpen pencircle scaled linethickness
               withcolor titleframecolor;
        fi;
      fi;
    endgroup;
  enddef;

  % ---------- 路径版标题：坐标取自 dmain ----------
  % 供 \startDualText 合并命令使用。
  % dmain 底边为标题与正文的公共边（由调用方切分保证）。
  % 不在此 setbounds（合并命令统一裁到 multibox）。
  def DrawDualHeaderOnPath(
    expr dmain,
         shownumber, showtitle,
         titlepos, titlealign, numberalign,
         numberbgcolor, titlebgcolor,
         numbercolor, titlecolor,
         numberframecolor, titleframecolor,
         numberframe, titleframe,
         numberratio, titleratio,
         linethickness, hdrradius, hdrcorner,
         numtext, tittext
  ) =
    begingroup;
      numeric xmin, ymin, xmax, ymax, w, h, ox, r;
      xmin := xpart llcorner dmain;  ymin := ypart llcorner dmain;
      xmax := xpart urcorner dmain;  ymax := ypart urcorner dmain;
      w := xmax - xmin;  h := ymax - ymin;
      ox := linethickness / 2;
      r  := hdrradius;

      boolean shownum, showttl, both;
      shownum := shownumber > 0;
      showttl := showtitle  > 0;
      both    := shownum and showttl;

      if shownum or showttl :
        numeric nleft, nright, tleft, tright;
        numeric nbw, tbw, cw, cx, nw;
        picture numbertext, titletext;

        if shownum : numbertext := textext(numtext); fi;
        if showttl : titletext  := textext(tittext);  fi;

        % 水平范围（相对 xmin..xmax）
        if titlepos = 0 :
          if both :
            nbw := GetTextWidth(numbertext) + 8pt;
            tbw := GetTextWidth(titletext)  + 8pt;
            cw  := nbw + tbw;
            cx  := xmin + CalcBoxX(cw, titlealign, w, ox);
            nleft := cx;       nright := cx + nbw;
            tleft := cx + nbw; tright := cx + cw;
          elseif shownum :
            nbw := GetTextWidth(numbertext) + 8pt;
            nleft := xmin + CalcBoxX(nbw, titlealign, w, ox);
            nright := nleft + nbw;
          else :
            tbw := GetTextWidth(titletext) + 8pt;
            tleft := xmin + CalcBoxX(tbw, titlealign, w, ox);
            tright := tleft + tbw;
          fi;
        else :
          if both :
            nw    := w * numberratio / (numberratio + titleratio);
            nleft := xmin + ox;  nright := xmin + nw;
            tleft := xmin + nw;  tright := xmax - ox;
          elseif shownum :
            nleft := xmin + ox;  nright := xmax - ox;
          else :
            tleft := xmin + ox;  tright := xmax - ox;
          fi;
        fi;

        % 圆角开关（语义同 DrawDualHeaderFrameNew）
        boolean ntl, ntr, nbr, nbl, ttl, ttr, tbr, tbl;
        ntl:=false; ntr:=false; nbr:=false; nbl:=false;
        ttl:=false; ttr:=false; tbr:=false; tbl:=false;
        if hdrcorner = 0 :
          if both :
            ntl:=true; nbl:=true; ttr:=true; tbr:=true;
          elseif shownum :
            ntl:=true; ntr:=true; nbr:=true; nbl:=true;
          else :
            ttl:=true; ttr:=true; tbr:=true; tbl:=true;
          fi;
        elseif hdrcorner = 1 :
          if both :
            ntl:=true; ttr:=true;
          elseif shownum :
            ntl:=true; ntr:=true;
          else :
            ttl:=true; ttr:=true;
          fi;
        elseif hdrcorner = 2 :
          if both :
            nbl:=true; tbr:=true;
          elseif shownum :
            nbl:=true; nbr:=true;
          else :
            tbl:=true; tbr:=true;
          fi;
        elseif hdrcorner = 3 :
          if shownum :
            ntl:=true; nbl:=true;
          else :
            ttl:=true; tbl:=true;
          fi;
        elseif hdrcorner = 4 :
          if showttl :
            ttr:=true; tbr:=true;
          else :
            ntr:=true; nbr:=true;
          fi;
        fi;

        % 编号/标题框：占满 ymin+ox .. ymax-ox
        path nbox, tbox;
        if shownum :
          nbox := DualHeaderBox(nleft, nright, ymin+ox, ymax-ox, r,
                                ntl, ntr, nbr, nbl);
        fi;
        if showttl :
          tbox := DualHeaderBox(tleft, tright, ymin+ox, ymax-ox, r,
                                ttl, ttr, tbr, tbl);
        fi;

        if shownum : fill nbox withcolor numberbgcolor; fi;
        if showttl : fill tbox  withcolor titlebgcolor;  fi;

        % 文字垂直居中于 ymin..ymax
        numeric cy, nx, tx;
        cy := ymin + h / 2;

        if shownum :
          if titlepos = 0 :
            nx := nleft + (nright - nleft)/2;
          else :
            nx := AlignTextPosition(numbertext, nleft, nright, numberalign, 4pt);
          fi;
          draw numbertext shifted (nx, cy - ypart center numbertext)
               withcolor numbercolor;
        fi;

        if showttl :
          if titlepos = 0 :
            tx := tleft + (tright - tleft)/2;
          else :
            tx := AlignTextPosition(titletext, tleft, tright, titlealign, 4pt);
          fi;
          draw titletext shifted (tx, cy - ypart center titletext)
               withcolor titlecolor;
        fi;

        if shownum and (numberframe > 0) :
          draw nbox withpen pencircle scaled linethickness
               withcolor numberframecolor;
        fi;
        if showttl and (titleframe > 0) :
          draw tbox withpen pencircle scaled linethickness
               withcolor titleframecolor;
        fi;
      fi;
    endgroup;
  enddef;

  % ---------- 合并绘制：标题条 + 正文（单路径） ----------
  % dmain   = 整个 multipar 区域
  % dshowhdr= 是否画标题（0/1）
  % dheadh  = 标题条高度（= hdrheight + rulethickness）
  % 其余 header/body 参数见文件头缩写对照。
  % 不单独画接缝线；靠 header 框与正文框自身边框贴合。
  % corner 独立：dhdrcorner 只作用标题框，dcorner 只作用正文框。
  %
  % 接缝（seam）几何：
  %   dseam = 标题条底边与正文框顶边相接的水平分界线位置
  %          = 区域顶边 bymax 减去标题高度 dheadh
  %   dox   = th/2，框线半宽（框线内缩量）
  %   正文路径顶边在 dseam+dox：框线内缩 th/2 后，线中心落在 dseam
  %   标题路径底边在 dseam-dox：框线内缩 th/2 后，线中心也落在 dseam
  %   → 两条框线中心重合于 dseam，接缝处单线贴合、无错位
  def DrawDualCombinedOnPath(
    expr dmain, dshowhdr, dheadh,
         % --- header ---
         dshownumber, dshowtitle,
         dtitlepos, dtitlealign, dnumberalign,
         dnumberbgcolor, dtitlebgcolor,
         dnumbercolor, dtitlecolor,
         dnumberframecolor, dtitleframecolor,
         dnumberframe, dtitleframe,
         dnumberratio, dtitleratio,
         dhdrradius, dhdrcorner,
         dnumtext, dtittext,
         % --- body ---
         dbg, dfc, dsc,
         dth, drad, dcorner, dlf, drf, dtf, dbf,
         dch, dsym, dshadow, dbar, dframe,
         dfov, dboff
  ) =
    begingroup
      numeric bxmin, bymin, bxmax, bymax, dseam, dox;
      bxmin := xpart llcorner dmain;
      bymin := ypart llcorner dmain;
      bxmax := xpart urcorner dmain;
      bymax := ypart urcorner dmain;
      dox := dth / 2;           % 框线半宽
      dseam := bymax - dheadh;  % 接缝：标题底边与正文顶边的分界线

      if (dshowhdr > 0) and (dheadh > 0) and (dseam > bymin) :
        path dhead, dbody;
        % 正文区域：底边 bymin，顶边 dseam+dox（框线中心落在 dseam）
        dbody := (bxmin, bymin) -- (bxmax, bymin)
               -- (bxmax, dseam + dox) -- (bxmin, dseam + dox) -- cycle;
        % 标题区域：底边 dseam-dox（框线中心落在 dseam），顶边 bymax
        dhead := (bxmin, dseam - dox) -- (bxmax, dseam - dox)
               -- (bxmax, bymax) -- (bxmin, bymax) -- cycle;
        % 阴影：基于完整 multipar 区域绘制（延伸到标题区）
        % 从标题区下 8pt 开始；radius>0 且 corner≠9 时阴影全圆角
        % 传 dshadow=0 给 DrawDualBodyOnPath 避免重复画阴影
        numeric dshadowbody;
        dshadowbody := dshadow;
        if dshadow > 0 :
          numeric dst; dst := 8pt;
          path dsh;
          if (drad > 0) and (dcorner <> 9) :
            path dmain_r;
            dmain_r := DualHeaderBox(bxmin, bxmax, bymin, bymax,
                                     drad, true, true, true, true);
            dsh := dmain_r shifted (dst/2 * (1,-1));
            fill dsh withcolor dsc;
          else :
            dsh := dmain shifted (dst/4 * (1,-1));
            draw ((dst*right + llcorner dsh)
                  -- lrcorner dsh
                  -- (dst*down + urcorner dsh))
              withpen pensquare scaled dst withcolor dsc;
          fi;
          dshadowbody := 0;
        fi;
        DrawDualBodyOnPath(dbody, dbg, dfc, dsc,
                           dth, drad, dcorner, dlf, drf, dtf, dbf,
                           dch, dsym, dshadowbody, dbar, dframe,
                           dfov, dboff);
        DrawDualHeaderOnPath(dhead,
                             dshownumber, dshowtitle,
                             dtitlepos, dtitlealign, dnumberalign,
                             dnumberbgcolor, dtitlebgcolor,
                             dnumbercolor, dtitlecolor,
                             dnumberframecolor, dtitleframecolor,
                             dnumberframe, dtitleframe,
                             dnumberratio, dtitleratio,
                             dth, dhdrradius, dhdrcorner,
                             dnumtext, dtittext);
      else :
        DrawDualBodyOnPath(dmain, dbg, dfc, dsc,
                           dth, drad, dcorner, dlf, drf, dtf, dbf,
                           dch, dsym, dshadow, dbar, dframe,
                           dfov, dboff);
      fi;
    endgroup
  enddef;

\stopMPdefinitions

\startuseMPgraphic{dualbackground:draw}
  color dbg, dfc, dsc;
  dbg := \MPvar{fillcolor};
  dfc := \MPvar{linecolor};
  dsc := \MPvar{shadowcolor};
  numeric dth, drad, dbc;
  dth := \MPvar{linewidth}; drad := \MPvar{lineradius}; dbc := \MPvar{bodycorner};
  numeric dlf, drf, dtf, dbf;
  dlf := \MPvar{leftframe};  drf := \MPvar{rightframe};
  dtf := \MPvar{topframe};   dbf := \MPvar{bottomframe};
  if dlf < 0 : dlf := \MPvar{linetype}; fi;
  if drf < 0 : drf := \MPvar{linetype}; fi;
  if dtf < 0 : dtf := \MPvar{linetype}; fi;
  if dbf < 0 : dbf := \MPvar{linetype}; fi;
    
  string dch, dsym;
  dch  := "\MPvar{character}";
  dsym := "\MPvar{symbol}";
  
  string dnumtext, dtittext;
  dnumtext := "\MPvar{number}";
  dtittext := "\MPvar{title}";
  
  numeric dshadow, dbar, dframe;
  dshadow := 0; if "\MPvar{shadow}"   = "yes" : dshadow := 1; fi;
  dbar    := 0; if "\MPvar{bar}"      = "yes" : dbar    := 1; fi;
  dframe  := 0; if "\MPvar{framebox}" = "yes" : dframe  := 1; fi;
  
  numeric dfov, dboff;
  dfov := \MPvar{lineoffset}; dboff := \MPvar{filloffset};

  numeric dshownumber, dshowtitle, dtitlepos, dtitlealign, dnumberalign;
  dshownumber  := \MPvar{shownumber};
  dshowtitle   := \MPvar{showtitle};
  dtitlepos    := \MPvar{titlepos};
  dtitlealign  := \MPvar{titlealign};
  dnumberalign := \MPvar{numberalign};
  
  color dnumberbgcolor, dtitlebgcolor, dnumbercolor, dtitlecolor;
  color dnumberframecolor, dtitleframecolor;
  dnumberbgcolor    := \MPvar{numberbgcolor};
  dtitlebgcolor     := \MPvar{titlebgcolor};
  dnumbercolor      := \MPvar{numbercolor};
  dtitlecolor       := \MPvar{titlecolor};
  dnumberframecolor := \MPvar{numberframecolor};
  dtitleframecolor  := \MPvar{titleframecolor};
  
  numeric dnumberframe, dtitleframe, dnumberratio, dtitleratio;
  dnumberframe := \MPvar{numberframe}; dtitleframe := \MPvar{titleframe};
  dnumberratio := \MPvar{numberratio}; dtitleratio := \MPvar{titleratio};
  
  numeric dhdrradius, dhdrcorner;
  dhdrradius := \MPvar{hdrradius}; dhdrcorner := \MPvar{hdrcorner};

  numeric dheadh, dshowhdr, drepeat;
  dheadh := \MPvar{hdrheight};
  dshowhdr := 0;
  if ((dshownumber > 0) or (dshowtitle > 0)) and (dheadh > 0) : dshowhdr := 1; fi;
  drepeat := \MPvar{hdrrepeat};

  if nofmultipars > 0 :
    for i=1 upto nofmultipars :
      DrawDualCombinedOnPath(multipars[i], dshowhdr, dheadh,
        dshownumber, dshowtitle, dtitlepos, dtitlealign, dnumberalign,
        dnumberbgcolor, dtitlebgcolor, dnumbercolor, dtitlecolor,
        dnumberframecolor, dtitleframecolor, dnumberframe, dtitleframe,
        dnumberratio, dtitleratio, dhdrradius, dhdrcorner,
        dnumtext, dtittext,
        dbg, dfc, dsc, dth, drad, dbc, dlf, drf, dtf, dbf,
        dch, dsym, dshadow, dbar, dframe, dfov, dboff);
    endfor;
  else :
    DrawDualCombinedOnPath(multibox, dshowhdr, dheadh,
      dshownumber, dshowtitle, dtitlepos, dtitlealign, dnumberalign,
      dnumberbgcolor, dtitlebgcolor, dnumbercolor, dtitlecolor,
      dnumberframecolor, dtitleframecolor, dnumberframe, dtitleframe,
      dnumberratio, dtitleratio, dhdrradius, dhdrcorner,
      dnumtext, dtittext,
      dbg, dfc, dsc, dth, drad, dbc, dlf, drf, dtf, dbf,
      dch, dsym, dshadow, dbar, dframe, dfov, dboff);
  fi;
  setbounds currentpicture to multibox;
\stopuseMPgraphic

\newinteger\c_anch_dualbackgrounds_text_n

\def\v_anch_dualbackgrounds_text_current    {dbg:0}
\def\v_anch_dualbackgrounds_anchor_current_b{b:\v_anch_dualbackgrounds_text_current}
\def\v_anch_dualbackgrounds_anchor_current_e{e:\v_anch_dualbackgrounds_text_current}

\def\anch_dualbackgrounds_text_initialize_next
  {\global\advanceby\c_anch_dualbackgrounds_text_n\plusone
   \edef\v_anch_dualbackgrounds_text_current{dbg:\the\c_anch_dualbackgrounds_text_n}}

\protected\def\anch_dualbackgrounds_text_initialize
  {\doifelsepositionsused\enableparpositions\donothing
   \glet\anch_dualbackgrounds_text_initialize\relax}

\appendtoks
    \anch_dualbackgrounds_text_initialize
\to \everystarttext

\permanent\def\dualbackgroundoverlay#1{\v!text#1}
\newinteger\c_anch_dualbackgrounds_text_level

\definelayer[dual\v!text-2][\c!position=\v!yes,\c!region=,\c!width=\textwidth,\c!height=\textheight]
\definelayer[dual\v!text-1][\c!position=\v!yes,\c!region=,\c!width=\textwidth,\c!height=\textheight]
\definelayer[dual\v!text+1][\c!position=\v!yes,\c!region=,\c!width=\textwidth,\c!height=\textheight]
\definelayer[dual\v!text+2][\c!position=\v!yes,\c!region=,\c!width=\textwidth,\c!height=\textheight]

\unexpanded\def\internaldualoverlay#1% will become more generic and installable
  {\startoverlay                     % i.e. probably an overlay by itself
     {\positionregionoverlay\textanchor{dual\v!text#1}}% see later
     {\composedlayer                   {dual\v!text#1}}%
   \stopoverlay}

\defineoverlay[dual\v!text-2][\internaldualoverlay{-2}]
\defineoverlay[dual\v!text-1][\internaldualoverlay{-1}]
\defineoverlay[dual\v!text+1][\internaldualoverlay{+1}]
\defineoverlay[dual\v!text+2][\internaldualoverlay{+2}]

\appendhiddenbackground{dualtext-2}
\appendhiddenbackground{dualtext-1}
\appendhiddenbackground{dualtext+1}
\appendhiddenbackground{dualtext+2}

\installcorenamespace{dualbackground}
\installcorenamespace{dualbackgroundlevel}

\installcommandhandler \??dualbackground {dualbackground} \??dualbackground

\appendtoks
    \protected\frozen\instance\edefcsname        \currentdualbackground\endcsname{\groupedcommand{\startdualbackground[\currentdualbackground]}{\stopdualbackground}}%
    \protected\frozen\instance\edefcsname\e!start\currentdualbackground\endcsname{\startdualbackground[\currentdualbackground]}%
    \protected\frozen\instance\edefcsname\e!stop \currentdualbackground\endcsname{\stopdualbackground}%
\to \everydefinedualbackground

\newconstant   \c_anch_dualbackgrounds_pos_state
\newconditional\c_anch_dualbackgrounds_pos_no_shape

\def\anch_dualbackgrounds_epos
  {\ifconditional\c_anch_dualbackgrounds_pos_no_shape
     \eposkind\v_anch_dualbackgrounds_text_current\plusthree
   \else
     \eposkind\v_anch_dualbackgrounds_text_current\c_anch_dualbackgrounds_pos_state
   \fi}

\newinteger \c_anch_dualbackgrounds_text_count
\newinteger \c_anch_dualbackgrounds_text_check
\newconstant\c_anch_dualbackgrounds_text_state

\permanent\tolerant\protected\def\startdualbackground[#tag]#spacer[#S#settings]%
  {\begingroup
   \writestatus{DBG}{START dual tag=\the\c_anch_dualbackgrounds_text_n}%
   \global\advanceby\c_anch_dualbackgrounds_text_count\plusone
   \advanceby\c_anch_dualbackgrounds_text_level\plusone
   \cdef\currentdualbackground{#tag}%
   \anch_dualbackgrounds_text_initialize_next
   \ifparameter#settings\or
     \setupcurrentdualbackground[#settings]%
   \fi
   \ifcstok{\dualbackgroundparameter\c!state}\v!start
     \anch_dualbackgrounds_text_preset_yes
   \else
     \anch_dualbackgrounds_text_preset_nop
   \fi
   \anch_dualbackgrounds_text_start_indeed}

\def\anch_dualbackgrounds_text_level_start
  {\c_anch_dualbackgrounds_text_check\c_anch_dualbackgrounds_text_count}

\def\anch_dualbackgrounds_text_level_stop
  {\c_anch_dualbackgrounds_text_state
     \ifnum\c_anch_dualbackgrounds_text_count>\c_anch_dualbackgrounds_text_check
       \plusone
     \else
       \zerocount
     \fi}

\let\anch_dualbackgrounds_text_start_indeed\relax
\let\anch_dualbackgrounds_text_stop_indeed \relax

\lettonothing\p_anch_dualbackgrounds_text_frame
\lettonothing\p_anch_dualbackgrounds_text_corner
\lettonothing\p_anch_dualbackgrounds_text_background

\defcsname\??dualbackgroundlevel\v!text\endcsname
  {\let\anch_dualbackgrounds_text_start_indeed\anch_dualbackgrounds_text_start_txt
   \let\anch_dualbackgrounds_text_stop_indeed \anch_dualbackgrounds_text_stop_txt}

\defcsname\??dualbackgroundlevel\v!paragraph\endcsname
  {\ifnum\c_anch_dualbackgrounds_text_level>\dualbackgroundparameter\c!criterium\relax
     \let\anch_dualbackgrounds_text_start_indeed\anch_dualbackgrounds_text_start_txt
     \let\anch_dualbackgrounds_text_stop_indeed \anch_dualbackgrounds_text_stop_txt
   \else
     \let\anch_dualbackgrounds_text_start_indeed\anch_dualbackgrounds_text_start_par
     \let\anch_dualbackgrounds_text_stop_indeed \anch_dualbackgrounds_text_stop_par
   \fi}

\defcsname\??dualbackgroundlevel\v!always\endcsname
  {\let\anch_dualbackgrounds_text_start_indeed\anch_dualbackgrounds_text_start_par
   \let\anch_dualbackgrounds_text_stop_indeed \anch_dualbackgrounds_text_stop_par}

\defcsname\??dualbackgroundlevel\v!none\endcsname
  {\anch_dualbackgrounds_text_preset_nop}

\def\anch_dualbackgrounds_text_preset_nop
  {\let\anch_dualbackgrounds_text_start_indeed\relax
   \let\anch_dualbackgrounds_text_stop_indeed \relax}

\def\anch_dualbackgrounds_text_preset_yes
  {\anch_dualbackgrounds_text_preset_nop
   \csname\??dualbackgroundlevel\dualbackgroundparameter\c!location\endcsname
   \edef\p_anch_dualbackgrounds_text_frame     {\dualbackgroundparameter\c!frame}%
   \edef\p_anch_dualbackgrounds_text_corner    {\dualbackgroundparameter\c!corner}%
   \edef\p_anch_dualbackgrounds_text_background{\dualbackgroundparameter\c!background}%
   \edef\p_anch_dualbackgrounds_text_showtitle {\dualbackgroundparameter{showtitle}}%
   \edef\p_anch_dualbackgrounds_text_shownumber{\dualbackgroundparameter{shownumber}}%
   \ifx\p_anch_dualbackgrounds_text_showtitle\v!yes
     \let\p_anch_dualbackgrounds_text_showtitle\!!plusone
   \else
     \let\p_anch_dualbackgrounds_text_showtitle\!!zerocount
   \fi
   \ifx\p_anch_dualbackgrounds_text_shownumber\v!yes
     \let\p_anch_dualbackgrounds_text_shownumber\!!plusone
   \else
     \let\p_anch_dualbackgrounds_text_shownumber\!!zerocount
   \fi
   \ifnum\p_anch_dualbackgrounds_text_showtitle=\!!zerocount
     \ifnum\p_anch_dualbackgrounds_text_shownumber=\!!zerocount
       \setupcurrentdualbackground[hdrheight=0pt]%
     \fi
   \fi
   \ifdim\dualbackgroundparameter{hdrheight}>\zeropoint
     \scratchdimen\dimexpr
      \dualbackgroundparameter{topoffset}%
     +\dualbackgroundparameter{hdrheight}%
     +\dualbackgroundparameter{rulethickness}\relax
     \setupcurrentdualbackground[\c!topoffset=\the\scratchdimen]%
   \fi
   \ifx\p_anch_dualbackgrounds_text_frame\v!on
     \ifx\p_anch_dualbackgrounds_text_corner\v!round
       \let\p_anch_dualbackgrounds_text_frame\!!plustwo
     \else
       \let\p_anch_dualbackgrounds_text_frame\!!plusone
     \fi
   \else
     \let\p_anch_dualbackgrounds_text_frame\!!zerocount
   \fi
   \ifx\p_anch_dualbackgrounds_text_background\v!color
     \let\p_anch_dualbackgrounds_text_background\!!plusone
   \else
     \let\p_anch_dualbackgrounds_text_background\!!zerocount
   \fi
   \startpositionoverlay{\dualbackgroundoverlay{\dualbackgroundparameter\c!level}}%
     \anch_dualbackgrounds_text_meta_graphic % gets expanded directly
   \stoppositionoverlay}

\def\anch_dualbackgrounds_text_meta_graphic
  {\writestatus{DBG}{b=\v_anch_dualbackgrounds_anchor_current_b}%
   \expanded{\setMPpositiongraphicrange % needs to be optimized
            {\v_anch_dualbackgrounds_anchor_current_b}%
            {\v_anch_dualbackgrounds_anchor_current_e}%
            {\dualbackgroundparameter\c!method}%
            {self=\v_anch_dualbackgrounds_text_current,
               mp=\dualbackgroundparameter\c!mp,
         gridtype=\dualbackgroundparameter\c!alternative,
         filltype=\p_anch_dualbackgrounds_text_background,
         linetype=\p_anch_dualbackgrounds_text_frame,
         dashtype=\dualbackgroundparameter{dash},
        gridcolor=\dualbackgroundparameter{framecolor},
        linecolor=\dualbackgroundparameter{framecolor},
       lineoffset=\dualbackgroundparameter{frameoffset},
        fillcolor=\dualbackgroundparameter{backgroundcolor},
       filloffset=\dualbackgroundparameter{backgroundoffset},
        gridwidth=\dualbackgroundparameter{rulethickness},
        gridshift=\dualbackgroundparameter{voffset},
        linewidth=\dualbackgroundparameter{rulethickness},
       lineradius=\dualbackgroundparameter{radius},
       shownumber=\p_anch_dualbackgrounds_text_shownumber,
        showtitle=\p_anch_dualbackgrounds_text_showtitle,
         titlepos=\dualbackgroundparameter{titlepos},
       titlealign=\dualbackgroundparameter{titlealign},
      numberalign=\dualbackgroundparameter{numberalign},
    numberbgcolor=\dualbackgroundparameter{numberbgcolor},
     titlebgcolor=\dualbackgroundparameter{titlebgcolor},
      numbercolor=\dualbackgroundparameter{numbercolor},
       titlecolor=\dualbackgroundparameter{titlecolor},
 numberframecolor=\dualbackgroundparameter{numberframecolor},
  titleframecolor=\dualbackgroundparameter{titleframecolor},
      shadowcolor=\dualbackgroundparameter{shadowcolor},
      numberframe=\dualbackgroundparameter{numberframe},
       titleframe=\dualbackgroundparameter{titleframe},
      numberratio=\dualbackgroundparameter{numberratio},
       titleratio=\dualbackgroundparameter{titleratio},
        hdrradius=\dualbackgroundparameter{hdrradius},
        hdrcorner=\dualbackgroundparameter{hdrcorner},
        hdrrepeat=\dualbackgroundparameter{hdrrepeat},
           number=\dualbackgroundparameter{number},
            title=\dualbackgroundparameter{title},
        hdrheight=\the\dimexpr\dualbackgroundparameter{hdrheight}\relax,
       bodycorner=\dualbackgroundparameter{bodycorner},
        leftframe=\dualbackgroundparameter{leftframe},
       rightframe=\dualbackgroundparameter{rightframe},
         topframe=\dualbackgroundparameter{topframe},
      bottomframe=\dualbackgroundparameter{bottomframe},
        character=\dualbackgroundparameter{character},
           symbol=\dualbackgroundparameter{symbol},
           shadow=\dualbackgroundparameter{shadow},
              bar=\dualbackgroundparameter{bar},
         framebox=\dualbackgroundparameter{framebox},
      shadowcolor=\dualbackgroundparameter{shadowcolor},}}}

\permanent\protected\def\stopdualbackground
  {\writestatus{DBG}{STOP dual}%
   \anch_dualbackgrounds_text_stop_indeed
   \carryoverpar\endgroup} % why doesn't this work ?

\permanent\protected\def\startdualbackgroundmanual
  {\begingroup
   \c_anch_dualbackgrounds_pos_state\plusone
   \usedualbackgroundstyleandcolor\c!style\c!color
   \anch_dualbackgrounds_bpos}

\permanent\protected\def\stopdualbackgroundmanual
  {\anch_dualbackgrounds_epos
   \carryoverpar\endgroup}

\def\anch_dualbackgrounds_text_start_txt
  {\ifvmode\dontleavehmode\fi
   \begingroup
   \c_anch_dualbackgrounds_pos_state\plusone
   \usedualbackgroundstyleandcolor\c!style\c!color
   \anch_dualbackgrounds_bpos}

\def\anch_dualbackgrounds_text_stop_txt
  {\anch_dualbackgrounds_epos
   \carryoverpar\endgroup}

\newgluespec\dualbackgroundskip

\def\anch_dualbackgrounds_grid_bpos
  {\spac_helpers_assign_skip\dualbackgroundskip{\dualbackgroundparameter\c!topoffset}%
   \ifdim\dualbackgroundskip>\zeropoint
     \struttedbox % not always ok (e.g. setups)
       {\hpack{\raise\dualbackgroundskip\hpack{\anch_dualbackgrounds_bpos}}}%
   \else
     \anch_dualbackgrounds_bpos
   \fi}

\def\anch_dualbackgrounds_text_start_par % beware .. background shapes
  {\endgraf % new
   \dualbackgroundparameter\c!before
   \begingroup
   \c_anch_dualbackgrounds_pos_state\plustwo
   \begingroup
   \anch_backgrounds_reset_attributes
   \noindent
   \ifgridlinesnapping
     % gridlinesnapping: to be decided
     \anch_dualbackgrounds_grid_bpos
   \orelse\ifgridsnapping
     \anch_dualbackgrounds_grid_bpos
   \else
     \anch_dualbackgrounds_bpos
   \fi
   \endgraf % we need a vertical nobreak - 29/06/2004
   \endgroup
   \nobreak
   \vskip-\lineheight
   \nobreak
   \ifgridlinesnapping
     % nothing
   \orelse\ifgridsnapping
     % nothing
   \else
     \spac_helpers_assign_skip\dualbackgroundskip{\dualbackgroundparameter\c!topoffset}%
     \ifdim\dualbackgroundskip>\zeropoint
        \kern\dualbackgroundskip\nobreak
     \fi
   \fi
   \doadaptleftskip {\dualbackgroundparameter\c!leftoffset}%
   \doadaptrightskip{\dualbackgroundparameter\c!rightoffset}%
   % new
   \dosetraggedcommand{\dualbackgroundparameter\c!align}%
   \raggedcommand
   \usedualbackgroundstyleandcolor\c!style\c!color
   \nowhitespace
   \seteffectivehsize
   \doinhibitblank %   \blank[\v!disable]% new
   \par}

\def\anch_dualbackgrounds_grid_epos
  {\ifdim\dualbackgroundskip>\zeropoint
     \struttedbox % not always ok (e.g. setups)
      {\hpack{\lower\dualbackgroundskip\hpack{\anch_dualbackgrounds_epos}}}%
   \else
     \anch_dualbackgrounds_epos
   \fi}

\def\anch_dualbackgrounds_text_stop_par
  {\par
   \removelastskip % new
   \spac_helpers_assign_skip\dualbackgroundskip{\dualbackgroundparameter\c!bottomoffset}%
   \ifdim\lastskip>\zeropoint
     \advanceby\dualbackgroundskip-\lastskip
   \fi
   \ifgridlinesnapping
     % nothing
   \orelse\ifgridsnapping
     % nothing
   \orelse\ifdim\dualbackgroundskip>\zeropoint
     \kern\dualbackgroundskip\nobreak
   \fi
   \nobreak
   \vskip{-\lineheight-\parskip}% problem: we loose the hangindent
   \nobreak
   \endgroup
   \begingroup
   \forgeteverypar % NOT REALLY NEEDED, SAVES HASH/MEM
   \anch_backgrounds_reset_attributes
   \nobreak \noindent \strut \hfill \kern\zeropoint
   % so far
   \spac_helpers_assign_skip\dualbackgroundskip{\dualbackgroundparameter\c!bottomoffset}%
   \ifgridlinesnapping
     % gridlinesnapping: to be decided
     \anch_dualbackgrounds_grid_epos
   \orelse\ifgridsnapping % experimental, pascal (todo: topoffset in same way)
     \anch_dualbackgrounds_grid_epos
   \else
     \anch_dualbackgrounds_epos
   \fi
   \endgraf
   \carryoverpar\endgroup
   \endgraf % new
   \dualbackgroundparameter\c!after}

\definesystemattribute[dualbackground][public]

\def\anch_dualbackgrounds_bpos
  {\ifconditional\c_anch_dualbackgrounds_pos_no_shape
     \c_attr_dualbackground\attributeunsetvalue
     \bposkind\v_anch_dualbackgrounds_text_current\plusthree
   \orelse\ifnum\c_anch_dualbackgrounds_pos_state=\plusone
     \bposkind\v_anch_dualbackgrounds_text_current\c_anch_dualbackgrounds_pos_state
     \writestatus{DBG}{dual bpos -> \v_anch_dualbackgrounds_text_current}%
     \clf_registerdualbackground{\v_anch_dualbackgrounds_text_current}%
   \else
     \bposkind\v_anch_dualbackgrounds_text_current\c_anch_dualbackgrounds_pos_state
     \c_attr_dualbackground\attributeunsetvalue
   \fi}


% 可分发参数：
%   --- 标题 ---
%   shownumber/showtitle    1=显示（默认 1）
%   number/title            编号/标题文字
%   titlepos                0=按文字宽 fit；其他=按比例占满（默认 1）
%   titlealign/numberalign  1=左 2=中 3=右（默认 2）
%   numberbgcolor/titlebgcolor  编号/标题底色（默认 lightthemecolor / white）
%   numbercolor/titlecolor  字色（默认 white / lightthemecolor）
%   framecolor              默认框色（默认 lightthemecolor）
%   numberframecolor/titleframecolor  独立框色（默认同 framecolor）
%   numberframe/titleframe  各自边框开关（默认 1）
%   numberratio/titleratio  比例分配（默认 1:1）
%   hdrradius               标题框圆角（默认 5pt）
%   hdrcorner               标题圆角选角（默认 9=关闭；0=外侧四角 1=上 2=下 3=左 4=右）
%   hdrheight               标题条基础高度（默认 2.2×BodyFontSize）
%   hdrrepeat               1=每页都画标题（默认）；0=仅首页画标题
%   --- 正文 ---
%   backgroundcolor         正文底色（不进标题条，默认 white）
%   framecolor              正文框线色（默认 lightthemecolor）
%   rulethickness           线宽（默认 1pt）
%   radius                  正文圆角（默认 5pt）
%   bodycorner              正文圆角选角（同 hdrcorner 语义，默认 9=关闭）
%   leftframe/rightframe/topframe/bottomframe  按边框（默认 1）
%   shadow                  yes=画阴影（默认 no）
%   bar                     yes=左色条（默认 no）
%   framebox                yes=棋盘格点阵（默认 no）
%   symbol/character        非空=角标/水印（默认 none）
%   shadowcolor             阴影色（默认 lightthemecolor）
%   frameoffset             框线内缩修正（默认 0pt，见 DrawDualBodyOnPath）
%   backgroundoffset        背景外扩（默认 0pt，见 DrawDualBodyOnPath）
%   before                  内容前钩子
%
% 标题条高度 H = hdrheight + rulethickness（烘焙进 MP 的 \_dualheff）
%   textbackground topoffset = H + topoffset 参数（默认 1ex）
%   shownumber=0 且 showtitle=0 时 H=0，不占高度。
%   hdrrepeat=0 时仅首页画标题；后续页 topoffset 仍预留空间，正文画在完整 multipar 上。
%
% 实现：单 namespace dualtextN 存参数；单 MP 读取后调 DrawDualCombinedOnPath；
%   在 multipars 顶部切出高度 H 的条带画标题，其余画正文。
%   backgroundcolor 只进正文；hdrcorner/bodycorner 各自独立。
%   不单独画接缝线。

\setupdualbackground
  [\c!mp=dualbackground:draw,
   \c!method=mpos:region,
   \c!state=\v!start,
   \c!location=\v!paragraph,
   \c!leftoffset=1ex, % 1em,
   \c!rightoffset=\dualbackgroundparameter\c!leftoffset,
   \c!topoffset=\!!zeropoint,  % \v!medium,
   \c!bottomoffset=\ifdim\dualbackgroundparameter{hdrheight}>\zeropoint 1ex\else\dualbackgroundparameter\c!topoffset\fi,
   \c!criterium=\plusone,
   \c!level=-1,
   \c!alternative=0,
   \c!align=,
   \c!dash=0, % to be internationalized
   \c!background=\v!color,
   \c!backgroundcolor=lightgray,
   \c!backgroundoffset=\!!zeropoint,
   \c!corner=\v!rectangular,
   \c!radius=2pt,
   \c!voffset=\!!zeropoint,
   \c!frame=\v!on,
   \c!framecolor=lightgray,
   \c!frameoffset=\!!zeropoint,
   \c!rulethickness=\linewidth,
   \c!leftframe=-1, 
   \c!rightframe=-1, 
   \c!topframe=-1, 
   \c!bottomframe=-1,
   shownumber=no,
   showtitle=no,
   number=A, 
   numberalign=2,
   numberratio=1,
   numberframe=1, 
   numberbgcolor=lightgray, 
   numbercolor=white, 
   numberframecolor=lightgray, 
   title=B, 
   titlepos=1,
   titlealign=2,
   titleratio=1,
   titleframe=1,
   titlebgcolor=lightgray,
   titlecolor=white,
   titleframecolor=lightgray,
   hdrradius=2pt,
   hdrcorner=1, 
   hdrrepeat=1,
   hdrheight=0pt,
   bodycorner=2,
   character=none, 
   symbol=none,
   shadow=no, 
   bar=no,
   framebox=no,
   shadowcolor=lightgray,
   ]

% ============================================================
% 模式一：\DualBodyframe — framed + overlay
% ============================================================
\startuseMPgraphic{DualBodyFrame}
  color dbg, dfc, dsc;
  dbg := \MPvar{backgroundcolor};
  dfc := \MPvar{framecolor};
  dsc := \MPvar{shadowcolor};

  numeric dth, drad, dcorner;
  dth  := \MPvar{rulethickness};
  drad := \MPvar{radius};
  dcorner := \MPvar{bodycorner};

  numeric dlf, drf, dtf, dbf;
  dlf := \MPvar{leftframe};
  drf := \MPvar{rightframe};
  dtf := \MPvar{topframe};
  dbf := \MPvar{bottomframe};

  string dch, dsym;
  dch    := "\MPvar{character}";
  dsym   := "\MPvar{symbol}";

  numeric dshadow, dbar, dframe;
  dshadow := 0;
  dbar    := 0;
  dframe  := 0;
  if "\MPvar{shadow}"   = "yes" : dshadow := 1; fi;
  if "\MPvar{bar}"      = "yes" : dbar    := 1; fi;
  if "\MPvar{framebox}" = "yes" : dframe  := 1; fi;

  numeric dfov, dboff;
  dfov  := \MPvar{frameoffset};
  dboff := \MPvar{backgroundoffset};

  path dmain;
  numeric dox; 
  dox   := dth/4;
  dmain := (dox,dox)--(OverlayWidth-dox,dox)
         --(OverlayWidth-dox,OverlayHeight-dox)--(dox,OverlayHeight-dox)--cycle;

  DrawDualBodyOnPath(dmain, dbg, dfc, dsc,
                     dth, drad, dcorner, dlf, drf, dtf, dbf,
                     dch, dsym, dshadow, dbar, dframe,
                     dfov, dboff);
\stopuseMPgraphic

\defineoverlay[DualBodyOL][\useMPgraphic{DualBodyFrame}]

\tolerant\def\DualBodyframe[#1]#2{%
  \begingroup
  \setupMPvariables[DualBodyFrame][
    backgroundcolor=lightgray,
    framecolor=lightgray,
    rulethickness=1pt,
    radius=5pt,
    bodycorner=9,
    leftframe=1,
    rightframe=1,
    topframe=1,
    bottomframe=1,
    symbol=none,
    character=none,
    shadow=no,
    bar=no,
    framebox=no,
    shadowcolor=lightgray,
    frameoffset=0pt,
    backgroundoffset=0pt,
    #1
  ]%
  \framed[frame=off,
          width=max,
          background=DualBodyOL,
          align={flushleft},
          offset=1ex,#1]{#2}%
  \endgroup
}