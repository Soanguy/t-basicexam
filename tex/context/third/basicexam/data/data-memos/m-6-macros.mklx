\startluacode
  thirddata        = thirddata or {}
  thirddata.memos  = thirddata.memos or {}
  local memos      = thirddata.memos

  memos.fullwidthmap = {
      ["0"]="０",["1"]="１",["2"]="２",["3"]="３",["4"]="４",
      ["5"]="５",["6"]="６",["7"]="７",["8"]="８",["9"]="９",
      ["A"]="Ａ",["B"]="Ｂ",["C"]="Ｃ",["D"]="Ｄ",["E"]="Ｅ",
      ["F"]="Ｆ",["G"]="Ｇ",["H"]="Ｈ",["I"]="Ｉ",["J"]="Ｊ",
      ["K"]="Ｋ",["L"]="Ｌ",["M"]="Ｍ",["N"]="Ｎ",["O"]="Ｏ",
      ["P"]="Ｐ",["Q"]="Ｑ",["R"]="Ｒ",["S"]="Ｓ",["T"]="Ｔ",
      ["U"]="Ｕ",["V"]="Ｖ",["W"]="Ｗ",["X"]="Ｘ",["Y"]="Ｙ",["Z"]="Ｚ",
      ["a"]="ａ",["b"]="ｂ",["c"]="ｃ",["d"]="ｄ",["e"]="ｅ",
      ["f"]="ｆ",["g"]="ｇ",["h"]="ｈ",["i"]="ｉ",["j"]="ｊ",
      ["k"]="ｋ",["l"]="ｌ",["m"]="ｍ",["n"]="ｎ",["o"]="ｏ",
      ["p"]="ｐ",["q"]="ｑ",["r"]="ｒ",["s"]="ｓ",["t"]="ｔ",
      ["u"]="ｕ",["v"]="ｖ",["w"]="ｗ",["x"]="ｘ",["y"]="ｙ",["z"]="ｚ",
      [" "]="　",["!"]="！",["?"]="？",[","]="，",["."]="．",
      [":"]="：",[";"]="；",["("]="（",[")"]="）",["["]="［",["]"]="］",
      ["{"]="｛",["}"]="｝",["<"]="＜",[">"]="＞",["@"]="＠",["#"]="＃",
      ["$"]="＄",["%"]="％",["&"]="＆",["*"]="＊",["+"]="＋",["="]="＝",
      ["-"]="－",["_"]="＿",["/"]="／",["|"]="｜",["'"]="＇",['"']="＂",
      ["\\"]="＼",["~"]="～",["^"]="＾",
  }

  function memos.fullwidthconvert(s)
      local out = {}
      for _, c in utf8.codes(s) do
          local ch = utf8.char(c)
          out[#out+1] = memos.fullwidthmap[ch] or ch
      end
      return table.concat(out)
  end
\stopluacode

\def\fullwidth#1{\ctxlua{context(thirddata.memos.fullwidthconvert([==[#1]==]))}}

\startluacode
-- 1. 拦截 HTML 生成：覆盖原生指令
directives.register("system.showerror", function(v)
    -- 留空，彻底阻止生成 -status.html
end)

-- 2. 拦截 -error.log 生成：劫持 table.save
local original_save = table.save
table.save = function(filename, data)
    -- 如果文件名包含 "-error.log"，我们就假装保存了，直接 return
    if filename and string.find(filename, "%-error%.log$") then
        return
    end
    -- 其他正常的 table.save 调用继续执行
    return original_save(filename, data)
end
\stopluacode