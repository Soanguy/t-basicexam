
\definefontfeature [simplified-chinese] [default]% [pwid=yes]%
\definefontfeature [traditional-chinese][default]% [pwid=yes]%
\definefontfeature [japanese]           [default]% [pwid=yes]%
\definefontfeature [chinese]            [simplified-chinese]%
\definefontfeature [italic]             [ital=yes]
\definefontfeature [boldslanted]        [default]%
                   [effect={width=0.30,auto=yes,slant=.2}]%

\starttypescriptcollection[sourcevf]%

    \definefontfeature [sourcehanvf-extralight] [axis={wght=250}]
    \definefontfeature [sourcehanvf-light]      [axis={wght=300}]
    \definefontfeature [sourcehanvf-regular]    [axis={wght=400}]
    \definefontfeature [sourcehanvf-medium]     [axis={wght=500}]
    \definefontfeature [sourcehanvf-bold]       [axis={wght=700}]
    \definefontfeature [sourcehanvf-heavy]      [axis={wght=900}]

    \definetypescriptprefix [n:sourcehansvfserif]  [sourcehanserifcnvf]
    \definetypescriptprefix [n:sourcehansvfsans]   [sourcehansanscnvf]
    \definetypescriptprefix [n:sourcenihonvfserif] [sourcehanserifjpvf]
    \definetypescriptprefix [n:sourcenihonvfsans]  [sourcehansansjpvf]
    \definetypescriptprefix [n:sourcehantvfserif]  [sourcehanserifkrvf]   % K=繁体中文
    \definetypescriptprefix [n:sourcehantvfsans]   [sourcehansanskrvf]

    \definetypescriptprefix [n:sourcehansvfmono]   [wenyuanroundedscvf]%
    \definetypescriptprefix [n:sourcehansvfhandw]  [wenyuanroundedscvf]%
    
    \definetypescriptprefix [n:wenyuanhansvfserif] [wenyuanserifscvf]%
    \definetypescriptprefix [n:wenyuanhansvfsans]  [wenyuansansscflexvf]%
    \definetypescriptprefix [n:wenyuanhansvfmono]  [wenyuanroundedscvf]%
    \definetypescriptprefix [n:wenyuanhansvfhandw] [wenyuanroundedscvf]%
    
    \definetypescriptprefix [n:shangguvfserif]     [shangguserifvf]%
    \definetypescriptprefix [n:shangguvfsans]      [shanggusansvf]%
    \definetypescriptprefix [n:shangguvfmono]      [shangguround]%
    \definetypescriptprefix [n:shangguvfhandw]     [shangguround]%

    \definetypescriptprefix [n:sourcenihonvfmono]  [kleeprom]%
    \definetypescriptprefix [n:sourcenihonvfhandw] [kleeprom]%

    \definetypescriptprefix [n:sourcehantvfmono]   [lxgwwenkaitcregular]%
    \definetypescriptprefix [n:sourcehantvfhandw]  [lxgwwenkaitcregular]%

    \definetypescriptprefix [f:sourcehansvf]       [simplified-chinese]
    \definetypescriptprefix [f:sourcenihonvf]      [japanese]
    \definetypescriptprefix [f:sourcehantvf]       [traditional-chinese]

    \starttypescript [\s!serif,\s!sans] [sourcehansvf, sourcenihonvf, sourcehantvf, wenyuanhansvf, shangguvf] [\s!name]
      \setups[\s!font:\s!fallback:\typescriptone]
      \edefinefontsynonym [\typescriptprefix\typescriptone ExtraLight]      [\s!name:\typescriptprefix{n:\typescripttwo\typescriptone}] [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-extralight},\s!fallbacks=fallback-\typescriptone extralight]
      \edefinefontsynonym [\typescriptprefix\typescriptone ExtraLightItalic][HandwritingExtraLightItalic]                               [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-extralight,italic},\s!fallbacks=fallback-\typescriptone extralightitalic]
      \edefinefontsynonym [\typescriptprefix\typescriptone Light]           [\s!name:\typescriptprefix{n:\typescripttwo\typescriptone}] [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-light},\s!fallbacks=fallback-\typescriptone light]
      \edefinefontsynonym [\typescriptprefix\typescriptone LightItalic]     [HandwritingLightItalic]                                    [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-light,italic},\s!fallbacks=fallback-\typescriptone lightitalic]
      \edefinefontsynonym [\typescriptprefix\typescriptone ]                [\s!name:\typescriptprefix{n:\typescripttwo\typescriptone}] [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-regular},\s!fallbacks=fallback-\typescriptone ]
      \edefinefontsynonym [\typescriptprefix\typescriptone Italic]          [HandwritingItalic]                                         [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-regular,italic},\s!fallbacks=fallback-\typescriptone italic]
      \edefinefontsynonym [\typescriptprefix\typescriptone Medium]          [\s!name:\typescriptprefix{n:\typescripttwo\typescriptone}] [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-medium},\s!fallbacks=fallback-\typescriptone medium]
      \edefinefontsynonym [\typescriptprefix\typescriptone MediumItalic]    [HandwritingMediumItalic]                                   [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-medium,italic},\s!fallbacks=fallback-\typescriptone mediumitalic]
      \edefinefontsynonym [\typescriptprefix\typescriptone Bold]            [\s!name:\typescriptprefix{n:\typescripttwo\typescriptone}] [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-bold},\s!fallbacks=fallback-\typescriptone bold]
      \edefinefontsynonym [\typescriptprefix\typescriptone BoldItalic]      [HandwritingBoldItalic]                                     [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-bold,italic},\s!fallbacks=fallback-\typescriptone bolditalic]
      \edefinefontsynonym [\typescriptprefix\typescriptone Heavy]           [\s!name:\typescriptprefix{n:\typescripttwo\typescriptone}] [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-heavy},\s!fallbacks=fallback-\typescriptone heavy]
      \edefinefontsynonym [\typescriptprefix\typescriptone HeavyItalic]     [HandwritingHeavyItalic]                                    [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-heavy,italic},\s!fallbacks=fallback-\typescriptone heavyitalic]
      \edefinefontsynonym [\typescriptprefix\typescriptone Slanted]         [\typescriptprefix\typescriptone ]                          [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-regular, slanted},\s!fallbacks=fallback-\typescriptone slanted]
      \edefinefontsynonym [\typescriptprefix\typescriptone BoldSlanted]     [\typescriptprefix\typescriptone Bold]                      [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-bold, slanted},\s!fallbacks=fallback-\typescriptone boldslanted]
      \edefinefontsynonym [\typescriptprefix\typescriptone Caps]            [\typescriptprefix\typescriptone ]                          [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-regular},\s!fallbacks=fallback-\typescriptone caps]
    \stoptypescript
    
    \starttypescript [mono] [sourcehansvf, wenyuanhansvf,] [\s!name]
      \setups[\s!font:\s!fallback:\typescriptone]
      \edefinefontsynonym [\typescriptprefix\typescriptone ExtraLight]      [\s!name:\typescriptprefix{n:\typescripttwo\typescriptone}] [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-extralight},\s!fallbacks=fallback-monoextralight]
      \edefinefontsynonym [\typescriptprefix\typescriptone ExtraLightItalic][HandwritingExtraLightItalic]                               [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-extralight,italic},\s!fallbacks=fallback-monoextralightitalic]
      \edefinefontsynonym [\typescriptprefix\typescriptone Light]           [\s!name:\typescriptprefix{n:\typescripttwo\typescriptone}] [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-light},\s!fallbacks=fallback-monolight]
      \edefinefontsynonym [\typescriptprefix\typescriptone LightItalic]     [HandwritingLightItalic]                                    [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-light,italic},\s!fallbacks=fallback-monolightitalic]
      \edefinefontsynonym [\typescriptprefix\typescriptone ]                [\s!name:\typescriptprefix{n:\typescripttwo\typescriptone}] [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-regular},\s!fallbacks=fallback-mono]
      \edefinefontsynonym [\typescriptprefix\typescriptone Italic]          [HandwritingItalic]                                         [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-regular,italic},\s!fallbacks=fallback-monoitalic]
      \edefinefontsynonym [\typescriptprefix\typescriptone Medium]          [\s!name:\typescriptprefix{n:\typescripttwo\typescriptone}] [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-medium},\s!fallbacks=fallback-monomedium]
      \edefinefontsynonym [\typescriptprefix\typescriptone MediumItalic]    [HandwritingMediumItalic]                                   [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-medium,italic},\s!fallbacks=fallback-monomediumitalic]
      \edefinefontsynonym [\typescriptprefix\typescriptone Bold]            [\s!name:\typescriptprefix{n:\typescripttwo\typescriptone}] [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-bold},\s!fallbacks=fallback-monobold]
      \edefinefontsynonym [\typescriptprefix\typescriptone BoldItalic]      [HandwritingBoldItalic]                                     [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-bold,italic},\s!fallbacks=fallback-monobolditalic]
      \edefinefontsynonym [\typescriptprefix\typescriptone Heavy]           [\s!name:\typescriptprefix{n:\typescripttwo\typescriptone}] [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-heavy},\s!fallbacks=fallback-monoheavy]
      \edefinefontsynonym [\typescriptprefix\typescriptone HeavyItalic]     [HandwritingHeavyItalic]                                    [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-heavy,italic},\s!fallbacks=fallback-monoheavyitalic]
      \edefinefontsynonym [\typescriptprefix\typescriptone Slanted]         [\typescriptprefix\typescriptone ]                          [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-regular, slanted},\s!fallbacks=fallback-monoslanted]
      \edefinefontsynonym [\typescriptprefix\typescriptone BoldSlanted]     [\typescriptprefix\typescriptone Bold]                      [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-bold, slanted},\s!fallbacks=fallback-monoboldslanted]
      \edefinefontsynonym [\typescriptprefix\typescriptone Caps]            [\typescriptprefix\typescriptone ]                          [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-regular},\s!fallbacks=fallback-monocaps]
    \stoptypescript

    \starttypescript [mono] [sourcenihonvf, sourcehantvf, shangguvf][\s!name]%
        \setups[\s!font:\s!fallback:\typescriptone]%
        \definefontsynonym [MonoExtraLight]                                   [\s!name:\typescriptprefix{n:\typescripttwo\typescriptone}]            [\s!features=\typescriptprefix{f:\typescripttwo},\s!fallbacks=fallback-monoextralight]%
        \definefontsynonym [MonoExtraLightItalic]                             [\s!name:\typescriptprefix{n:\typescripttwo\typescriptone}]            [\s!features=\typescriptprefix{f:\typescripttwo},\s!fallbacks=fallback-monoextralightitalic]%
        \definefontsynonym [MonoLight]                                        [\s!name:\typescriptprefix{n:\typescripttwo\typescriptone}]            [\s!features=\typescriptprefix{f:\typescripttwo},\s!fallbacks=fallback-monolight]%
        \definefontsynonym [MonoLightItalic]                                  [\s!name:\typescriptprefix{n:\typescripttwo\typescriptone}]            [\s!features=\typescriptprefix{f:\typescripttwo},\s!fallbacks=fallback-monolightitalic]%
        \definefontsynonym [Mono]                                             [\s!name:\typescriptprefix{n:\typescripttwo\typescriptone}]            [\s!features=\typescriptprefix{f:\typescripttwo},\s!fallbacks=fallback-mono]%
        \definefontsynonym [MonoItalic]                                       [\s!name:\typescriptprefix{n:\typescripttwo\typescriptone}]            [\s!features=\typescriptprefix{f:\typescripttwo},\s!fallbacks=fallback-monoitalic]%
        \definefontsynonym [MonoMedium]                                       [\s!name:\typescriptprefix{n:\typescripttwo\typescriptone}]            [\s!features={boldened-15,\typescriptprefix{f:\typescripttwo}},\s!fallbacks=fallback-monomedium]%
        \definefontsynonym [MonoMediumItalic]                                 [\s!name:\typescriptprefix{n:\typescripttwo\typescriptone}]            [\s!features={boldened-15,\typescriptprefix{f:\typescripttwo}},\s!fallbacks=fallback-monomediumitalic]%
        \definefontsynonym [MonoBold]                                         [\s!name:\typescriptprefix{n:\typescripttwo\typescriptone}]            [\s!features={boldened-25,\typescriptprefix{f:\typescripttwo}},\s!fallbacks=fallback-monobold]%
        \definefontsynonym [MonoBoldItalic]                                   [\s!name:\typescriptprefix{n:\typescripttwo\typescriptone}]            [\s!features={boldened-25,\typescriptprefix{f:\typescripttwo}},\s!fallbacks=fallback-monobolditalic]%
        \definefontsynonym [MonoHeavy]                                        [\s!name:\typescriptprefix{n:\typescripttwo\typescriptone}]            [\s!features={boldened-30,\typescriptprefix{f:\typescripttwo}},\s!fallbacks=fallback-monoheavy]%
        \definefontsynonym [MonoHeavyItalic]                                  [\s!name:\typescriptprefix{n:\typescripttwo\typescriptone}]            [\s!features={boldened-30,\typescriptprefix{f:\typescripttwo}},\s!fallbacks=fallback-monoheavyitalic]%
        \definefontsynonym [MonoCaps]                                         [\s!name:\typescriptprefix{n:\typescripttwo\typescriptone}]            [\s!features={\typescriptprefix{f:\typescripttwo}},\s!fallbacks=fallback-mono]%
        \definefontsynonym [MonoSlanted]                                      [\s!name:\typescriptprefix{n:\typescripttwo\typescriptone}]            [\s!features={slanted,\typescriptprefix{f:\typescripttwo}},\s!fallbacks=fallback-monoslanted]%
        \definefontsynonym [MonoBoldSlanted]                                  [\s!name:\typescriptprefix{n:\typescripttwo\typescriptone}]            [\s!features={boldslanted,\typescriptprefix{f:\typescripttwo}},\s!fallbacks=fallback-monoboldslanted]%
    \stoptypescript
    
    \starttypescript [handwriting] [sourcehansvf, wenyuanhansvf,] [\s!name]
      \setups[\s!font:\s!fallback:\typescriptone]
      \edefinefontsynonym [\typescriptprefix\typescriptone ExtraLight]      [\s!name:\typescriptprefix{n:\typescripttwo handw}]                      [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-extralight},\s!fallbacks=fallback-handwextralight]
      \edefinefontsynonym [\typescriptprefix\typescriptone ExtraLightItalic][\s!name:\typescriptprefix{n:\typescripttwo handw}]                      [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-extralight,italic},\s!fallbacks=fallback-handwextralightitalic]
      \edefinefontsynonym [\typescriptprefix\typescriptone Light]           [\s!name:\typescriptprefix{n:\typescripttwo handw}]                      [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-light},\s!fallbacks=fallback-handwlight]
      \edefinefontsynonym [\typescriptprefix\typescriptone LightItalic]     [\s!name:\typescriptprefix{n:\typescripttwo handw}]                      [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-light,italic},\s!fallbacks=fallback-handwlightitalic]
      \edefinefontsynonym [\typescriptprefix\typescriptone ]                [\s!name:\typescriptprefix{n:\typescripttwo handw}]                      [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-regular},\s!fallbacks=fallback-handw]
      \edefinefontsynonym [\typescriptprefix\typescriptone Italic]          [\s!name:\typescriptprefix{n:\typescripttwo handw}]                      [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-regular,italic},\s!fallbacks=fallback-handwitalic]
      \edefinefontsynonym [\typescriptprefix\typescriptone Medium]          [\s!name:\typescriptprefix{n:\typescripttwo handw}]                      [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-medium},\s!fallbacks=fallback-handwmedium]
      \edefinefontsynonym [\typescriptprefix\typescriptone MediumItalic]    [\s!name:\typescriptprefix{n:\typescripttwo handw}]                      [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-medium,italic},\s!fallbacks=fallback-handwmediumitalic]
      \edefinefontsynonym [\typescriptprefix\typescriptone Bold]            [\s!name:\typescriptprefix{n:\typescripttwo handw}]                      [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-bold},\s!fallbacks=fallback-handwbold]
      \edefinefontsynonym [\typescriptprefix\typescriptone BoldItalic]      [\s!name:\typescriptprefix{n:\typescripttwo handw}]                      [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-bold,italic},\s!fallbacks=fallback-handwbolditalic]
      \edefinefontsynonym [\typescriptprefix\typescriptone Heavy]           [\s!name:\typescriptprefix{n:\typescripttwo handw}]                      [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-heavy},\s!fallbacks=fallback-handwheavy]
      \edefinefontsynonym [\typescriptprefix\typescriptone HeavyItalic]     [\s!name:\typescriptprefix{n:\typescripttwo handw}]                      [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-heavy,italic},\s!fallbacks=fallback-handwheavyitalic]
      \edefinefontsynonym [\typescriptprefix\typescriptone Slanted]         [\s!name:\typescriptprefix{n:\typescripttwo handw}]                      [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-regular, slanted},\s!fallbacks=fallback-handwslanted]
      \edefinefontsynonym [\typescriptprefix\typescriptone BoldSlanted]     [\s!name:\typescriptprefix{n:\typescripttwo handw}]                      [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-bold, slanted},\s!fallbacks=fallback-handwboldslanted]
      \edefinefontsynonym [\typescriptprefix\typescriptone Caps]            [\s!name:\typescriptprefix{n:\typescripttwo handw}]                      [\s!features={\typescriptprefix{f:\typescripttwo}, sourcehanvf-regular},\s!fallbacks=fallback-handwcaps]
    \stoptypescript

    \starttypescript [handwriting] [sourcenihonvf, sourcehantvf, shangguvf][\s!name]%
        \setups[\s!font:\s!fallback:\typescriptone]%
        \edefinefontsynonym [HandwritingExtraLight]                           [\s!name:\typescriptprefix{n:\typescripttwo handw}]                    [\s!features=\typescriptprefix{f:\typescripttwo},\s!fallbacks=fallback-handwextralight]%
        \edefinefontsynonym [HandwritingExtraLightItalic]                     [\s!name:\typescriptprefix{n:\typescripttwo handw}]                    [\s!features=\typescriptprefix{f:\typescripttwo},\s!fallbacks=fallback-handwextralightitalic]%
        \edefinefontsynonym [HandwritingLight]                                [\s!name:\typescriptprefix{n:\typescripttwo handw}]                    [\s!features=\typescriptprefix{f:\typescripttwo},\s!fallbacks=fallback-handwlight]%
        \edefinefontsynonym [HandwritingLightItalic]                          [\s!name:\typescriptprefix{n:\typescripttwo handw}]                    [\s!features=\typescriptprefix{f:\typescripttwo},\s!fallbacks=fallback-handwlightitalic]%
        \edefinefontsynonym [Handwriting]                                     [\s!name:\typescriptprefix{n:\typescripttwo handw}]                    [\s!features=\typescriptprefix{f:\typescripttwo},\s!fallbacks=fallback-handw]%
        \edefinefontsynonym [HandwritingItalic]                               [\s!name:\typescriptprefix{n:\typescripttwo handw}]                    [\s!features=\typescriptprefix{f:\typescripttwo},\s!fallbacks=fallback-handwitalic]%
        \edefinefontsynonym [HandwritingMedium]                               [\s!name:\typescriptprefix{n:\typescripttwo handw}]                    [\s!features={boldened-15,\typescriptprefix{f:\typescripttwo}},\s!fallbacks=fallback-handwmedium]%
        \edefinefontsynonym [HandwritingMediumItalic]                         [\s!name:\typescriptprefix{n:\typescripttwo handw}]                    [\s!features={boldened-15,\typescriptprefix{f:\typescripttwo}},\s!fallbacks=fallback-handwmediumitalic]%
        \edefinefontsynonym [HandwritingBold]                                 [\s!name:\typescriptprefix{n:\typescripttwo handw}]                    [\s!features={boldened-25,\typescriptprefix{f:\typescripttwo}},\s!fallbacks=fallback-handwbold]%
        \edefinefontsynonym [HandwritingBoldItalic]                           [\s!name:\typescriptprefix{n:\typescripttwo handw}]                    [\s!features={boldened-25,\typescriptprefix{f:\typescripttwo}},\s!fallbacks=fallback-handwbolditalic]%
        \edefinefontsynonym [HandwritingHeavy]                                [\s!name:\typescriptprefix{n:\typescripttwo handw}]                    [\s!features={boldened-30,\typescriptprefix{f:\typescripttwo}},\s!fallbacks=fallback-handwheavy]%
        \edefinefontsynonym [HandwritingHeavyItalic]                          [\s!name:\typescriptprefix{n:\typescripttwo handw}]                    [\s!features={boldened-30,\typescriptprefix{f:\typescripttwo}},\s!fallbacks=fallback-handwheavyitalic]%
        \edefinefontsynonym [HandwritingSlanted]                              [\s!name:\typescriptprefix{n:\typescripttwo handw}]                    [\s!features={slanted,\typescriptprefix{f:\typescripttwo}},\s!fallbacks=fallback-handwslanted]%
        \edefinefontsynonym [HandwritingBoldSlanted]                          [\s!name:\typescriptprefix{n:\typescripttwo handw}]                    [\s!features={boldslanted,\typescriptprefix{f:\typescripttwo}},\s!fallbacks=fallback-handwboldslanted]%
        \edefinefontsynonym [HandwritingCaps]                                 [\s!name:\typescriptprefix{n:\typescripttwo handw}]                    [\s!features=\typescriptprefix{f:\typescripttwo},\s!fallbacks=fallback-handwcaps]%
    \stoptypescript

    \starttypescript [sourcehansvf, sourcenihonvf, sourcehantvf, wenyuanhansvf, shangguvf]
      \definetypeface [\typescriptone] [\s!rm] [\s!serif]       [\typescriptone] [\s!default]
      \definetypeface [\typescriptone] [\s!ss] [\s!sans]        [\typescriptone] [\s!default]
      \definetypeface [\typescriptone] [\s!hw] [\s!handwriting] [\typescriptone] [\s!default]
      \definetypeface [\typescriptone] [\s!tt] [\s!mono]        [\typescriptone] [\s!default]
      \definetypeface [\typescriptone] [\s!mm] [\s!math]        [pagella]        [\s!default]
    \stoptypescript

  \definefontalternative[EF] % light
  \definefontalternative[EI] % light
  \definefontalternative[LF] % light
  \definefontalternative[LI] % light
  \definefontalternative[MF] % medium
  \definefontalternative[MI] % mediumitalic
  \definebodyfont [default] [rm]%
     [EF=SerifExtraLight        sa 1,
      EI=SerifExtraLightItalic  sa 1,
      LF=SerifLight             sa 1,
      LI=SerifLightItalic       sa 1,
      tf=Serif                  sa 1,
      it=SerifItalic            sa 1,
      MF=SerifMedium            sa 1,
      MI=SerifMediumItalic      sa 1,
      bf=SerifBold              sa 1,
      bi=SerifBoldItalic        sa 1,
      sl=SerifSlanted           sa 1,
      bs=SerifBoldSlanted       sa 1,
      sc=SerifCaps              sa 1,
      ]%
  \definebodyfont [default] [ss]%
     [EF=SansExtraLight        sa 1,
      EI=SansExtraLightItalic  sa 1,
      LF=SansLight             sa 1,
      LI=SansLightItalic       sa 1,
      tf=Sans                  sa 1,
      it=SansItalic            sa 1,
      MF=SansMedium            sa 1,
      MI=SansMediumItalic      sa 1,
      bf=SansBold              sa 1,
      bi=SansBoldItalic        sa 1,
      sl=SansSlanted           sa 1,
      bs=SansBoldSlanted       sa 1,
      sc=SansCaps              sa 1]%
  \definebodyfont [default] [tt]%
     [EF=MonoExtraLight        sa 1,
      EI=MonoExtraLightItalic  sa 1,
      LF=MonoLight             sa 1,
      LI=MonoLightItalic       sa 1,
      tf=Mono                  sa 1,
      it=MonoItalic            sa 1,
      MF=MonoMedium            sa 1,
      MI=MonoMediumItalic      sa 1,
      bf=MonoBold              sa 1,
      bi=MonoBoldItalic        sa 1,
      sl=MonoSlanted           sa 1,
      bs=MonoBoldSlanted       sa 1,
      sc=MonoCaps              sa 1]%
  \definebodyfont [default] [hw]%
     [EF=HandwritingExtraLight        sa 1,
      EI=HandwritingExtraLightItalic  sa 1,
      LF=HandwritingLight             sa 1,
      LI=HandwritingLightItalic       sa 1,
      tf=Handwriting                  sa 1,
      it=HandwritingItalic            sa 1,
      MF=HandwritingMedium            sa 1,
      MI=HandwritingMediumItalic      sa 1,
      bf=HandwritingBold              sa 1,
      bi=HandwritingBoldItalic        sa 1,
      sl=HandwritingSlanted           sa 1,
      bs=HandwritingBoldSlanted       sa 1,
      sc=HandwritingCaps              sa 1]%
\stoptypescriptcollection