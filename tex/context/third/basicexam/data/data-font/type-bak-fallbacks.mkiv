\tolerant\def\zihao#*[#1]{\ifhastoks{-}{#1}\__ZIHAOMINUS{#1}\else\__ZIHAOPLUS{#1}\fi}

\def\__ZIHAOPLUS#1{%
  \ifcase\numexpr#1\relax
    \switchtobodyfont[42bp]\or
    \switchtobodyfont[26bp]\or
    \switchtobodyfont[22bp]\or
    \switchtobodyfont[16bp]\or
    \switchtobodyfont[14bp]\or
    \switchtobodyfont[10.5bp]\or
    \switchtobodyfont[7.5bp]\or
    \switchtobodyfont[5.5bp]\or
    \switchtobodyfont[5bp]\else
    \switchtobodyfont[11bp]\fi}

\def\__ZIHAOMINUS#1{%
  \ifcase\numexpr0-(#1)\relax
    \switchtobodyfont[36bp]\or
    \switchtobodyfont[24bp]\or
    \switchtobodyfont[18bp]\or
    \switchtobodyfont[15bp]\or
    \switchtobodyfont[12bp]\or
    \switchtobodyfont[9bp]\or
    \switchtobodyfont[6.5bp]\else
    \switchtobodyfont[11bp]\fi}

