\definefontalternative[LF]% light%
\definefontalternative[LI]% light%
\definefontalternative[MF]% medium%
\definefontalternative[MI]% mediumitalic%
\definebodyfont [default] [rm]%
    [LF=SerifLight        ,%
     LI=SerifLightItalic  ,%
     tf=Serif             ,% or you can set Serif*boldened-15 %
     it=SerifItalic       ,%
     MF=SerifMedium       ,%
     MI=SerifMediumItalic ,%
     bf=SerifBold         ,%
     bi=SerifBoldItalic   ,%
     sl=SerifSlanted      ,%
     bs=SerifBoldSlanted  ,%
     sc=SerifCaps         ,%
    ]%
\definebodyfont [default] [ss]%
    [LF=SansLight         ,%
     LI=SansLightItalic   ,%
     tf=Sans              ,%
     it=SansItalic        ,%
     MF=SansMedium        ,%
     MI=SansMediumItalic  ,%
     bf=SansBold          ,%
     bi=SansBoldItalic    ,%
     sl=SansSlanted       ,%
     bs=SansBoldSlanted   ,%
     sc=SansCaps          ]%
\definebodyfont [default] [tt]%
    [LF=MonoLight         ,%
     LI=MonoLightItalic   ,%
     tf=Mono              ,%
     it=MonoItalic        ,%
     MF=MonoMedium        ,%
     MI=MonoMediumItalic  ,%
     bf=MonoBold          ,%
     bi=MonoBoldItalic    ,%
     sl=MonoSlanted       ,%
     bs=MonoBoldSlanted   ,%
     sc=MonoCaps          ]%
\definebodyfont [default] [hw]%
    [LF=HandwritingLight        ,%
     LI=HandwritingLightItalic  ,%
     tf=Handwriting             ,%
     it=HandwritingItalic       ,%
     MF=HandwritingMedium       ,%
     MI=HandwritingMediumItalic ,%
     bf=HandwritingBold         ,%
     bi=HandwritingBoldItalic   ,%
     sl=HandwritingSlanted      ,%
     bs=HandwritingBoldSlanted  ,%
     sc=HandwritingCaps         ]%