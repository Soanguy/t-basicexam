% macros=mkvi
% 查字符： https://uutool.cn/font-glyph/
% 转字符： https://rakko.tools/zh-cn/tools/unicode-converter 
% 整理字符：  tr ' ' '\n' < codes.txt | sort -n | uniq | awk 'NR==1{start=$1;end=$1} $1==end+1{end=$1;next} {if(start==end) printf "0x%04X", start; else printf "0x%04X-0x%04X", start,end; start=end=$1; printf ", "} END{if(start==end) printf "0x%04X", start; else printf "0x%04X-0x%04X", start,end}'
% \definefontfeature [default][default][expansion=conservative, protrusion=quality]
\startluacode
  thirddata        = thirddata or {}
  thirddata.memos  = thirddata.memos or {}
  local memos      = thirddata.memos

  -- ============================================================
  -- 1. goodies 记录
  -- ============================================================

  function memos.font_helpers_set_goodies_record(fontspec, goodies)
      if goodies == "" then return end
      local prefix = token.get_macro("??fontfile")
      local base   = fontspec:match("^([^*]+)") or fontspec
      for _, key in ipairs({ base, fontspec }) do
          token.set_macro(prefix .. key .. "goodies", goodies, true)
      end
  end

  -- ============================================================
  -- 2. LatinPunct 引号码点与范围处理
  -- ============================================================

  local quote_codes = { 0x2018, 0x2019, 0x201C, 0x201D }
  local quote_set   = {}
  for _, c in ipairs(quote_codes) do quote_set[c] = true end

  local function parse_ranges(s)
      local set = {}
      for item in s:gmatch("[^,]+") do
          local part = item:gsub("%s+", "")
          local a, b = part:match("^0[xX](%x+)%-0[xX](%x+)$")
          if a then
              for c = tonumber(a, 16), tonumber(b, 16) do
                  set[c] = true
              end
          else
              local c = part:match("^0[xX](%x+)$")
              if c then set[tonumber(c, 16)] = true end
          end
      end
      return set
  end

  local function serialize(set)
      local list = {}
      for c in pairs(set) do list[#list + 1] = c end
      table.sort(list)
      local out, i = {}, 1
      while i <= #list do
          local a, b = list[i], list[i]
          while i < #list and list[i + 1] == b + 1 do
              i = i + 1
              b = list[i]
          end
          out[#out + 1] = (a == b)
              and string.format("0x%04X", a)
              or  string.format("0x%04X-0x%04X", a, b)
          i = i + 1
      end
      return table.concat(out, ",")
  end

  function memos.fallback_range(ranges, latinpunct)
      local set = parse_ranges(ranges)
      for _, c in ipairs(quote_codes) do set[c] = nil end
      if latinpunct then
          for _, c in ipairs(quote_codes) do set[c] = true end
      end
      return serialize(set)
  end

  -- ============================================================
  -- 3. 默认 range -- Lua 内部表
  -- ============================================================

  -- 默认 key 是保留字：用户的 range 宏不要用这些名字。
