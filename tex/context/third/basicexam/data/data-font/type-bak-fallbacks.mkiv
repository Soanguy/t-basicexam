% 查字符： https://uutool.cn/font-glyph/
% 转字符： https://rakko.tools/zh-cn/tools/unicode-converter 
% 整理字符：  tr ' ' '\n' < codes.txt | sort -n | uniq | awk 'NR==1{start=$1;end=$1} $1==end+1{end=$1;next} {if(start==end) printf "0x%04X", start; else printf "0x%04X-0x%04X", start,end; start=end=$1; printf ", "} END{if(start==end) printf "0x%04X", start; else printf "0x%04X-0x%04X", start,end}'
%\definefontfeature [default][default][protrusion=quality]
\definefontfeature [latin-default][
                    language=dflt,mode=node,%
                    lnum=yes,pnum=yes,tnum=no,
                    kern=yes,case=yes,calt=yes,
                    %cpsp=yes,locl=yes,pwid=yes,
                    %trep=yes,swsh=yes,dlig=yes,
                    liga=yes,tlig=yes,itlc=yes,]%
\definefontfeature [fallback-latin-default]        [latin-default]
\definefontfeature [fallback-latin-slanted]        [latin-default] [effect={slant=.2}]
\definefontfeature [fallback-latin-slanted-mono]                   [effect={auto=yes,slant=.2}]
\definefontfeature [fallback-latin-smallcaps]      [smallcaps]
\definefontfeature [fallback-latin-smallcaps-mono] [cmcp=yes,c2sc=yes]
\definefontfeature [opsz6]                         [axis={opsz=6}]
\definefontfeature [opsz72]                        [axis={opsz=72}]
\definefontfeature [w:thin]                        [latin-default] [axis={wght=100}]
\definefontfeature [w:extralight]                  [latin-default] [axis={wght=200}]
\definefontfeature [w:light]                       [latin-default] [axis={wght=300}]
\definefontfeature [w:regular]                     [latin-default] [axis={wght=400}]
\definefontfeature [w:text]                        [latin-default] [axis={wght=450}]
\definefontfeature [w:medium]                      [latin-default] [axis={wght=500}]
\definefontfeature [w:semibold]                    [latin-default] [axis={wght=600}]
\definefontfeature [w:bold]                        [latin-default] [axis={wght=700}]
\definefontfeature [w:regularslanted]              [fallback-latin-slanted] [axis={wght=400}]
%常用标点    2000–206F
%上标及下标  2070–209F
\definefontfamilypreset
  [range:CJK]%
  [\c!range={cjkcompatibilityforms,cjkcompatibilityideographs,
             cjkcompatibilityideographssupplement,cjkradicalssupplement,
             cjkstrokes,cjksymbolsandpunctuation,cjkunifiedideographs,
             cjkunifiedideographsextensiona,cjkunifiedideographsextensionb,
             halfwidthandfullwidthforms,verticalforms,bopomofo,
             bopomofoextended,hiragana,katakana,
             }]%
