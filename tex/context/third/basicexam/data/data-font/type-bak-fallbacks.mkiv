  -- ============================================================
  -- 4. 按 key 取 range 默认优先，用户惰性缓存
  -- ============================================================

  local key_cache = {}

  function memos.latinpunct_range_set_by_key(result, key, latinpunct)
      local ck = latinpunct and (key .. "|1") or (key .. "|0")
      local v = key_cache[ck]
      if v == nil then
          local s = default_ranges[key]
          if s == nil then
              s = token.get_macro(key)
          end
          v = memos.fallback_range(s or "", latinpunct)
          key_cache[ck] = v
      end
      token.set_macro(result, v, "global")
  end

  -- ============================================================
  -- 5. LatinPunct 节点处理器
  -- ============================================================

  memos.latinpunct_default = true

  function memos.set_latinpunct_default(v)
      memos.latinpunct_default = v
  end

  local nuts         = nodes.nuts
  local nextchar     = nuts.traversers.char
  local nextdisc     = nuts.traversers.disc
  local getdisc      = nuts.getdisc
  local setfont      = nuts.setfont
  local getprop      = nuts.getprop
  local setprop      = nuts.setprop
  local getattribute = nuts.getattribute
  local getscales    = nuts.getscales
  local setscales    = nuts.setscales

  local latinpunct_attribute = attributes.public("latinpunct")
  local probe_chars = { 0x0041, 0x0061, 0x0030, 0x00E9 }

  local function fallback_font(mainfont, char)
      local vector = fonts.collections.vectors[mainfont]
      if not vector then return nil end
      local v = vector[char]
      if not v then
          for _, c in ipairs(probe_chars) do
              v = vector[c]
              if v then break end
          end
      end
      if not v then
          for k, vv in next, vector do
              if type(k) == "number" then v = vv; break end
          end
      end
      if not v then return nil end
      return type(v) == "table" and v[1] or v
  end

  local function fallback_scale(mainfont, char)
      local scales = fonts.collections.rscales[mainfont]
      if not scales then return 1 end
      local r = scales[char]
      if r then return r end
      for _, c in ipairs(probe_chars) do
          r = scales[c]
          if r then return r end
      end
      return 1
  end

  local function process(head)
      for n, char, font in nextchar, head do
          if quote_set[char] then
              local value = getattribute(n, latinpunct_attribute)
              local latin
              if value == 1 then
                  latin = true
              elseif value == 0 then
                  latin = false
              else
                  latin = memos.latinpunct_default
              end

              local prop = getprop(n, "latinpunct")

              if latin then
                  if not prop then
                      local fb = fallback_font(font, char)
                      if fb then
                          local s, x, y = getscales(n)
                          setprop(n, "latinpunct",
                              { font = font, s = s, x = x, y = y })
                          local rscale = fallback_scale(font, char)
                          if rscale and rscale ~= 1 then
                              setscales(n, s * rscale, x, y)
                          end
                          setfont(n, fb)
                      end
                  end
              elseif prop then
                  setfont(n, prop.font)
                  setscales(n, prop.s, prop.x, prop.y)
                  setprop(n, "latinpunct", nil)
              end
          end
      end
  end

  local function process_disc(head)
      process(head)
      for disc in nextdisc, head do
          local pre, post, replace = getdisc(disc)
          if pre     then process(pre)     end
          if post    then process(post)    end
          if replace then process(replace) end
      end
      return head, true
  end

  memos.latinpunct = { process = process_disc }

  nodes.tasks.appendaction(
      "processors", "normalizers",
      "thirddata.memos.latinpunct.process",
      nil, "nut", "enabled")
\stopluacode

% ================================================================
% TeX 侧接口
% ================================================================

\defineattribute[latinpunct]

\def\startLatinPunct{\begingroup\dosetattribute{latinpunct}{1}}
\def\stopLatinPunct {\endgroup}
\def\startCJKPunct  {\begingroup\dosetattribute{latinpunct}{0}}
\def\stopCJKPunct   {\endgroup}

\def\LatinPunctOn #1{{\dosetattribute{latinpunct}{1}#1}}
\def\LatinPunctOff#1{{\dosetattribute{latinpunct}{0}#1}}

\def\setLatinPunct[#1]%
  {\doifelse{#1}{no}%
     {\ctxlua{thirddata.memos.set_latinpunct_default(false)}}%
     {\ctxlua{thirddata.memos.set_latinpunct_default(true)}}}

\def\MemosLatinPunctRangeByKey#1%
  {\ctxlua{thirddata.memos.latinpunct_range_set_by_key(
     "MemosLatinPunctResult",
     "#1",
     false)}}

\permanent\tolerant\protected\def\definefontfallbackgoodies
  [#name]#spacer[#font]#spacer[#ranges]#spacer[#settings]#spacer[#goodies]%
  {\doifnotempty{#goodies}{\font_helpers_set_goodies_record{#font}{#goodies}}%
   \let\mathsizesuffix\relax
   \MemosLatinPunctRangeByKey{#ranges}%
   \clf_fontcollectiondefine{#name}{#font}{\MemosLatinPunctResult}{#settings}%
   \lettonothing\mathsizesuffix}

\unexpanded\def\font_helpers_set_goodies_record#1#2%
  {\ctxlua{thirddata.memos.font_helpers_set_goodies_record("#1","#2")}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%                          字體集設置                                 %%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% 警告 第三个参数 字体*特性。特性不可以被**括号**包裹。只能裸露出来，用**逗号**分割特性。
%% 此外，此时尽量特性中的名称中不包含**特殊字符**，避免解析错误
\setupfontexpansion[conservative][stretch=1, shrink=1, step=0.25, factor=1]

\definefontfeature [chinese]             [simplified-chinese]
\definefontfeature [boldslanted]         [default] [effect={width=0.30,auto=yes,slant=.2}]
\definefontfeature [latin-default][
                    language=dflt,mode=node,kern=yes,%
                    %lnum=yes,pnum=yes,tnum=no,
                    %calt=yes,case=yes,
                    %cpsp=yes,locl=yes,swsh=yes,dlig=yes,
                    trep=yes,liga=yes,tlig=yes,itlc=yes,
                    ]
\definefontfeature [fbk-default]  [latin-default]
\definefontfeature [fbk-slanted]  [latin-default] []
\definefontfeature [w-400slanted] [latin-default] [axis={wght=400}]
\definefontfeature [fbk-slanted-mono] []
\definefontfeature [fbk-smallcaps] [smallcaps]
\definefontfeature [fbk-sc-mono]   [cmcp=yes,c2sc=yes]
\definefontfeature [ital]          [ital=yes]
\definefontfeature [w-100]         [axis={wght=100}]
\definefontfeature [w-200]         [axis={wght=200}]
\definefontfeature [w-300]         [axis={wght=300}]
\definefontfeature [w-400]         [axis={wght=400}]
\definefontfeature [w-450]         [axis={wght=450}]
\definefontfeature [w-500]         [axis={wght=500}]
\definefontfeature [w-600]         [axis={wght=600}]
\definefontfeature [w-700]         [axis={wght=700}]
\definefontfeature [w-800]         [axis={wght=800}]
\definefontfeature [w-900]         [axis={wght=900}]
\definefontfeature [wdth-100]      [axis={wdth=100}]
\definefontfeature [f:case]        [mode=node,case=yes]
\definefontfeature [f:pnum]        [mode=node,lnum=yes,pnum=yes]
\definefontfeature [f:lnum]        [mode=node,lnum=yes,pnum=yes]
\definefontfeature [f:onum]        [lnum=no,pnum=no,onum=yes,liga=yes,kern=yes]
\definefontfeature [f:tnum]        [mode=node,pnum=no,tnum=yes]
\definefontfeature [f:caps]        [always][smcp=yes]

\def\fakesc{\begingroup%
    \let\par=\space\obeylines\obeyspaces%
    \let\myspace=\space\dosmallcaps}
\def\dosmallcaps#1{\dosc#1\end\endgroup}
\def\dosc#1{% assumes #1 is a sequence of characters
    \ifx#1\end \let\next=\relax
        \else\if#1\space \myspace\let\myspace=\relax% skip repeated spaces
             \else\ifnum\lccode`#1=`#1{\csname\fontstyle x\endcsname \uppercase{#1}}%
             % change \tfx to your desired size
                  \else #1\fi
                  \let\myspace=\space
             \fi
        \let\next=\dosc
   \fi\next}
   
%{\it Not everyone is a typographer to
%produce the appropriate fine-typography glyphs
%for their favourite font to cater to
%a particular style. Why should the system impose
%\fakesc{"super-duper" Typography}
%on users when they are willing to settle for less?
%\fakesc{Watch out  for returns.}}
\def\reset_every_font_action{%
   \redoconvertfont % just in case a pagebreak occurs
   \the\everybodyfont
   \the\everyglobalbodyfont
   \saveinterlinespace}
\let\resetfont\fullrestoreglobalbodyfont
% reset font style, like rm to ss.
\unexpanded\def\resetfontstyle
  {\font_basics_switch_style\globalfontstyle
   \reset_every_font_action}
\unexpanded\def\resetfontalter
  {\let\fontface\defaultfontface
   \tf\reset_every_font_action}
% reset font size, like 12pt to 11pt.
\unexpanded\def\resetfontsize
  {\let\fontsize\defaultfontsize
  %  \let\fontbody\defaultfontbody
  %  \let\fontface\defaultfontface
   \currentxfontsize\zerocount
   \font_basics_switch_points\normalizedglobalbodyfontsize
   \reset_every_font_action}
\def\resetfont[#1]{
    \edef\currentfontclass{\defaultfontclass}
    \edef\currentfontbody{\fontbody}
    \edef\currentfontsize{\fontsize}
    \edef\currentfontface{\fontface}
    \edef\currentfontstyle{\defaultfontstyle}
    \edef\currentfontalternative{\defaultfontalternative}
    \doif{#1}{class}{\switchtobodyfont[\currentfontclass]}%???
    \doif{#1}{style}{\csname \currentfontstyle\endcsname}
    \doif{#1}{alternative}{\csname \currentfontalternative\endcsname}
}

%常用标点    2000–206F
%上标及下标  2070–209F
\definefontfamilypreset
  [range:CJK]
  [\c!range={cjkcompatibilityforms,cjkcompatibilityideographs,
             cjkcompatibilityideographssupplement,cjkradicalssupplement,
             cjkstrokes,cjksymbolsandpunctuation,cjkunifiedideographs,
             cjkunifiedideographsextensiona,cjkunifiedideographsextensionb,
             halfwidthandfullwidthforms,verticalforms,bopomofo,
             bopomofoextended,hiragana,katakana,
             }]

