  \starttypescript[ipaexhans,ipaexhant,ipaexnihon,freehans,freehant,huiwen]%
        \definetypeface [\typescriptone] [\s!rm] [\s!serif]       [\typescriptone]%
        \definetypeface [\typescriptone] [\s!ss] [\s!sans]        [\typescriptone]%
        \definetypeface [\typescriptone] [\s!tt] [\s!mono]        [\typescriptone]%
        \definetypeface [\typescriptone] [\s!hw] [\s!handwriting] [\typescriptone]%
%        \definetypeface [\typescriptone] [\s!mm] [\s!math]        [pagella] [default]%
  \stoptypescript

  \starttypescript[ibmplextc,ibmplexjp,ibmplexsc,frexsans]%
    \definetypeface [\typescriptone] [\s!rm] [\s!serif] [\typescriptone] [\s!sans]%
    \definetypeface [\typescriptone] [\s!ss] [\s!sans]  [\typescriptone]%
    \definetypeface [\typescriptone] [\s!tt] [\s!mono]  [\typescriptone] [\s!sans]%
%    \definetypeface [\typescriptone] [\s!mm] [\s!math]  [pagella] [default]%
  \stoptypescript
\stoptypescriptcollection